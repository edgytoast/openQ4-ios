/* --- Onboarding (first run, before the engine exists) --- */
/* MT */
"openQ4 needs your own copy of Quake 4.\n\nCopy the game's q4base folder into this app's folder using the Files app, or tap below to choose it directly.\n\nQuake 4 from Steam or GOG already includes the 1.4.2 patch that openQ4 requires." = "openQ4 richiede una tua copia di Quake 4.\n\nCopia la cartella q4base del gioco nella cartella di questa app con l'app File, oppure tocca qui sotto per sceglierla direttamente.\n\nQuake 4 di Steam o GOG include già la patch 1.4.2 richiesta da openQ4.";
/* MT */
"Choose Quake 4 Folder" = "Scegli la cartella di Quake 4";
/* MT */
"I Added Files — Check Again" = "Ho aggiunto i file — Controlla di nuovo";
/* #str_200020 + MT */
"Start openQ4" = "Avvia openQ4";
/* MT */
"Folder could not be read." = "Impossibile leggere la cartella.";
/* MT */
"No Quake 4 pak files here. Pick the folder that contains pak001.pk4 … pak022.pk4 (usually called q4base)." = "Nessun file pak di Quake 4 qui. Scegli la cartella che contiene pak001.pk4 … pak022.pk4 (di solito si chiama q4base).";
/* MT */
"That folder has no .pk4 files. Choose the folder containing pak001.pk4 … pak022.pk4 (usually q4base)." = "Quella cartella non contiene file .pk4. Scegli la cartella con pak001.pk4 … pak022.pk4 (di solito q4base).";
/* MT */
"Two files in that folder differ only in capital letters: %@ and %@. Keep one of them and choose the folder again." = "Due file in quella cartella differiscono solo per le maiuscole: %@ e %@. Tienine uno solo e scegli di nuovo la cartella.";
/* MT */
"This looks like an unpatched Quake 4 (%d of 22 paks). openQ4 needs the 1.4.2 patch — Steam and GOG copies already include it. Missing: %@" = "Sembra un Quake 4 senza patch (%d pak su 22). openQ4 richiede la patch 1.4.2 — le copie Steam e GOG la includono già. Mancanti: %@";
/* MT */
"Incomplete: %d of 22 required paks. Missing: %@" = "Incompleto: %d pak richiesti su 22. Mancanti: %@";
/* MT */
"All 22 required paks found." = "Trovati tutti i 22 pak richiesti.";
/* MT */
"Mission-pack maps included." = "Mappe del mission pack incluse.";
/* MT */
"%d language pack(s)." = "%d pacchetto/i lingua.";
/* MT */
"Not enough free space. Importing needs %.1f GB and this device has %.1f GB free." = "Spazio libero insufficiente. L'importazione richiede %.1f GB e questo dispositivo ne ha %.1f GB liberi.";
/* MT */
"Copying %@\n%.1f of %.1f GB" = "Copia di %@\n%.1f di %.1f GB";
/* MT */
"Copy failed on %@:\n%@" = "Copia non riuscita per %@:\n%@";
/* MT */
"(%d file name(s) lowercased for this device.)" = "(%d nome/i di file convertito/i in minuscolo per questo dispositivo.)";
/* MT */
"There is no q4base folder in the openQ4 folder yet." = "Non c'è ancora una cartella q4base nella cartella openQ4.";
/* MT */
"Put the q4base folder directly inside the openQ4 folder in Files." = "Metti la cartella q4base direttamente nella cartella openQ4 dell'app File.";
/* MT */
"The last import was interrupted before it finished, so none of it was kept. Choose the folder again." = "L'ultima importazione è stata interrotta prima di finire, quindi non è stato tenuto nulla. Scegli di nuovo la cartella.";
