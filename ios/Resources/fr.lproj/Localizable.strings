/* --- Onboarding (first run, before the engine exists) --- */
/* MT */
"openQ4 needs your own copy of Quake 4.\n\nCopy the game's q4base folder into this app's folder using the Files app, or tap below to choose it directly.\n\nQuake 4 from Steam or GOG already includes the 1.4.2 patch that openQ4 requires." = "openQ4 a besoin de votre propre copie de Quake 4.\n\nCopiez le dossier q4base du jeu dans le dossier de cette app avec l'app Fichiers, ou touchez ci-dessous pour le choisir directement.\n\nQuake 4 sur Steam ou GOG inclut déjà le patch 1.4.2 nécessaire à openQ4.";
/* MT */
"Choose Quake 4 Folder" = "Choisir le dossier Quake 4";
/* MT */
"I Added Files — Check Again" = "J'ai ajouté les fichiers — Vérifier";
/* #str_200020 + MT */
"Start openQ4" = "Lancer openQ4";
/* MT */
"Folder could not be read." = "Impossible de lire le dossier.";
