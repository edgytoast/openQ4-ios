"Incomplete: %d of 22 required paks. Missing: %@" = "Incompleto: %d de 22 paks necesarios. Faltan: %@";
/* MT */
"All 22 required paks found." = "Se encontraron los 22 paks necesarios.";
/* MT */
"Mission-pack maps included." = "Incluye los mapas del mission pack.";
/* MT */
"%d language pack(s)." = "%d paquete(s) de idioma.";
/* MT */
"Not enough free space. Importing needs %.1f GB and this device has %.1f GB free." = "No hay espacio suficiente. La importación necesita %.1f GB y este dispositivo tiene %.1f GB libres.";
/* MT */
"Copying %@\n%.1f of %.1f GB" = "Copiando %@\n%.1f de %.1f GB";
/* MT */
"Copy failed on %@:\n%@" = "Error al copiar %@:\n%@";
/* MT */
"(%d file name(s) lowercased for this device.)" = "(%d nombre(s) de archivo pasado(s) a minúsculas para este dispositivo.)";
/* MT */
"There is no q4base folder in the openQ4 folder yet." = "Todavía no hay ninguna carpeta q4base en la carpeta openQ4.";
/* MT */
"Put the q4base folder directly inside the openQ4 folder in Files." = "Pon la carpeta q4base directamente dentro de la carpeta openQ4 en la app Archivos.";
/* MT */
"The last import was interrupted before it finished, so none of it was kept. Choose the folder again." = "La última importación se interrumpió antes de terminar, así que no se conservó nada. Vuelve a elegir la carpeta.";
