/* --- Onboarding (first run, before the engine exists) --- */
/* MT */
"openQ4 needs your own copy of Quake 4.\n\nCopy the game's q4base folder into this app's folder using the Files app, or tap below to choose it directly.\n\nQuake 4 from Steam or GOG already includes the 1.4.2 patch that openQ4 requires." = "openQ4 necesita tu propia copia de Quake 4.\n\nCopia la carpeta q4base del juego en la carpeta de esta app con la app Archivos, o toca abajo para elegirla directamente.\n\nQuake 4 de Steam o GOG ya incluye el parche 1.4.2 que openQ4 necesita.";
/* MT */
"Choose Quake 4 Folder" = "Elegir carpeta de Quake 4";
/* MT */
"I Added Files — Check Again" = "He añadido los archivos — Comprobar";
/* #str_200020 + MT */
"Start openQ4" = "Iniciar openQ4";
/* MT */
"Folder could not be read." = "No se pudo leer la carpeta.";
/* MT */
"No Quake 4 pak files here. Pick the folder that contains pak001.pk4 … pak022.pk4 (usually called q4base)." = "Aquí no hay archivos pak de Quake 4. Elige la carpeta que contiene pak001.pk4 … pak022.pk4 (normalmente llamada q4base).";
/* MT */
"That folder has no .pk4 files. Choose the folder containing pak001.pk4 … pak022.pk4 (usually q4base)." = "Esa carpeta no tiene archivos .pk4. Elige la carpeta que contiene pak001.pk4 … pak022.pk4 (normalmente q4base).";
/* MT */
"Two files in that folder differ only in capital letters: %@ and %@. Keep one of them and choose the folder again." = "Dos archivos de esa carpeta solo se diferencian en las mayúsculas: %@ y %@. Conserva uno de ellos y vuelve a elegir la carpeta.";
/* MT */
"This looks like an unpatched Quake 4 (%d of 22 paks). openQ4 needs the 1.4.2 patch — Steam and GOG copies already include it. Missing: %@" = "Parece un Quake 4 sin parchear (%d de 22 paks). openQ4 necesita el parche 1.4.2 — las copias de Steam y GOG ya lo incluyen. Faltan: %@";
