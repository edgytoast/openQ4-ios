/* --- Engine save dialog + Load Game list tag (D-114; OpenQ4_iOS_SaveText, shown by the engine's own message box) --- */
/* MT */
"Old version" = "Versión antigua";
/* #str_104312 + MT */
"Cannot Load Save" = "Imposible cargar";
