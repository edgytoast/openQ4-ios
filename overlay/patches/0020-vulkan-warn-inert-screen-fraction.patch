+	// ...and every other combination of those two cvars is implemented in the
+	// GL back end alone. draw_common.cpp owns both the sub-native upscale
+	// (modes 1 and 2) and the supersampling resolve; nothing under
+	// renderer/Vulkan reads either cvar. Under any other back end the frame
+	// therefore renders at full resolution and the cvars are silently inert,
+	// which reads exactly like a resolution control that does not work.
+	//
+	// Warned once per process, not per frame: this is a configuration mistake,
+	// and a per-frame warning would bury the log it belongs in.
+	{
+		static bool inertScreenFractionWarned = false;
+		if ( !inertScreenFractionWarned && screenFraction != 100
+				&& r_resolutionScaleMode.GetInteger() != 0 ) {
+			const char *api = cvarSystem->GetCVarString( "r_actualRenderApi" );
+			if ( api != NULL && idStr::Icmp( api, "gl" ) != 0
+					&& idStr::Icmp( api, "UNINITIALIZED" ) != 0 ) {
+				inertScreenFractionWarned = true;
+				common->Warning( "%s renderer: r_screenFraction %d with r_resolutionScaleMode %d "
+						"is not implemented; the frame renders at full resolution",
+						api, screenFraction, r_resolutionScaleMode.GetInteger() );
+			}
+		}
+	}
 
