+ * 0.1.0.61: "gun depth +0.39, but hardcode it and remove the setting"). This
+ * default is now the single definition of the number — the sheet does not push
+ * a stored value over it — and the cvar survives only so `!xr3dtune gun` can
+ * still move it over the bridge for a future A/B.
+ */
+idCVar r_stereo3dGunDepth( "r_stereo3dGunDepth", "0.39", CVAR_RENDERER | CVAR_FLOAT,
+		"visionOS 3D: weapon viewmodel depth, 0 = flat on the panel, +/-1 = out/in",
+		-1.0f, 1.0f );
+idCVar r_stereo3dGunConvergence( "r_stereo3dGunConvergence", "24", CVAR_RENDERER | CVAR_FLOAT,
+		"visionOS 3D: world-unit distance the weapon converges on when gun depth is non-zero",
+		4.0f, 512.0f );
+
+// MoltenVK exports this from the vendored xros/xrsimulator slices (checked with
+// nm), but it is NOT resolvable through vkGetInstanceProcAddr — so it is a
+// direct extern rather than a volk entry (quake3e's lesson, restated in
+// docs/stereo-design.md §2). vkExportMetalObjectsEXT is the fallback if a
+// future MoltenVK drops it; this is the one call site.
+// It returns VOID, not VkResult. Only the binary slices are vendored here, so
+// the declaration is ours to get right; MoltenVK's own mvk_deprecated_api.h
+// (1.4.2, on this machine under klepton-*/vendor-moltenvk) says
+//     void VKAPI_CALL vkGetMTLTextureMVK( VkImage, id<MTLTexture>* );
+// and both siblings declare it the same way. Reading a return value it never
+// sets rejected every texture it handed over (the pairs=0 of round 2's first
+// sim run), so the WRITTEN POINTER is the only success signal there is.
+// The header marks it MVK_DEPRECATED_USE_MTL_OBJS — VK_EXT_metal_objects is
+// the successor, and this one accessor is the only call site to move.
+extern "C" void vkGetMTLTextureMVK( VkImage image, void **pMTLTexture );
+
+// The eye the front end has latched for this frame (renderer/tr_main.cpp):
+// 0 = mono, 1 = left, 2 = right. Read once per BeginFrame to pick which half of
+// the write pair this frame fills.
+extern int tr_stereoEye;
+extern float tr_stereoEyeOffset;
+// The world's stereo pair, declared in renderer/tr_main.cpp beside the matrices
+// that consume them. Direct externs rather than cvarSystem lookups: the weapon
+// path below reads the convergence once per viewmodel surface, and a string
+// hash per surface is not a price worth paying for a cvar in the same module.
+extern idCVar r_stereo3dSeparation;
+extern idCVar r_stereo3dConvergence;
+
+typedef struct vk3dPresentImage_s {
+	VkImage			image;
+	VkImageView		view;
+	VmaAllocation	allocation;
+} vk3dPresentImage_t;
+
+/*
+===============================================================================
+
+	The hand-off, and why it is NOT "publish the slot after vkQueueSubmit"
+	(D-100 addendum — the round-2 review's race).
+
+	vkQueueSubmit returns when the work is SUBMITTED, not when the GPU has
+	finished it. The compositor thread blits the images on its OWN
+	MTLCommandQueue and MoltenVK does not synchronise across independent Metal
+	queues, so a pair published at submit time can be blitted while the engine's
+	writes are still in flight: tearing, or a half-old frame, intermittently and
+	worse under load. The mirror-image hazard is the engine reclaiming a pair
+	the compositor's blit has not finished reading.
+
+	Both are closed here, and both are closed on the ENGINE side, because the
+	engine thread is the only one that may touch a VkFence this backend also
+	resets:
+
+	  - A pair becomes PUBLISHED only once BOTH of its eyes' fences are observed
+	    signalled (vkGetFenceStatus, non-blocking, polled at the top of the next
+	    BeginFrame — where that slot's fence has usually just been waited on
+	    anyway). `notReady` counts the polls that deferred a publish, so the
+	    sync is visible in !xr3diag rather than inferred.
+	  - The compositor ACQUIRES a pair and RELEASES it from its command
+	    buffer's completion handler; while it holds one, that pair is not a
+	    candidate write target and cannot be destroyed.
+
+	PENDING IS PER FRAME SLOT, and that is the whole of the 0.1.0.59 hotfix
+	(D-100 addendum, "Hardware, 0.1.0.58"). With ONE pending image the engine
+	published nothing on hardware: at 120 Hz the fence of the frame submitted a
+	moment ago has never signalled by the time the next BeginFrame polls it, so
+	the poll deferred — and then that same BeginFrame's own submit REPLACED the
+	pending image, throwing the deferred frame away unpublished.
+
+	One pending entry PER SLOT cannot be thrown away, because the slot that owns
+	it is not reused until BeginFrame has waited on its fence — and that wait is
+	the guaranteed, blocking retire point. With both eyes rendering per host
+	frame and VK_FRAMES_IN_FLIGHT = 2, a pair occupies BOTH slots: the left eye
+	on slot s and the right on slot s^1, so a whole pair is guaranteed retired
+	within one further host frame.
+
+	ATOMIC PAIRS. eyeDone[] accumulates per eye and nothing is published until
+	the pair is whole. A pair that is complete but older than what is already on
+	the panel is never published (it would step the panel backwards) and is
+	counted as `superseded`; the panel therefore only ever advances, and it
+	only ever advances to a pair whose two eyes were rendered at the same game
+	time.
+
+	How many pairs: one being written, up to one pending its two fences, the
+	published one, and one the compositor has not finished blitting = 4, plus
+	one so the engine never has to wait = VK_FRAMES_IN_FLIGHT + 3 = 5. `stalls`
+	counts frames that had to wait for a free pair and `overruns` frames that
+	found none anyway; both must stay 0, and both are in the diag line so the
+	claim is checked rather than believed.
+
+===============================================================================
+*/
+#define VK3D_EYE_COUNT			2
+#define VK3D_PRESENT_PAIRS		( VK_FRAMES_IN_FLIGHT + 3 )
+#define VK3D_PRESENT_IMAGES		( VK3D_PRESENT_PAIRS * VK3D_EYE_COUNT )
+#define VK3D_LATENCY_BUCKETS	16
+
+typedef struct vk3dPresentPair_s {
+	vk3dPresentImage_t	eye[ VK3D_EYE_COUNT ];
+	bool				eyeDone[ VK3D_EYE_COUNT ];	// fence observed signalled
+	bool				mono;			// only eye 0 was rendered into this pair
+	bool				everRendered;	// vkQuake D-032's undefined-image gate
+	int					serial;			// vk3dBeginCount at claim
+} vk3dPresentPair_t;
+
+static vk3dPresentPair_t	vk3dPairs[ VK3D_PRESENT_PAIRS ];
+static VkExtent2D			vk3dEyeExtent;		// per-eye render size, NOT the window's
+static VkFormat				vk3dEyeFormat;
+// Depth is per FRAME SLOT and not per pair: only the frame currently recording
+// reads or writes it, and the frame slot is exactly the thing the fences bound.
+// It cannot be vkCtx.depthImages any more, because those are swapchain-sized and
+// the eye extent no longer is.
+static VkImage				vk3dDepthImages[ VK_FRAMES_IN_FLIGHT ];
+static VkImageView			vk3dDepthViews[ VK_FRAMES_IN_FLIGHT ];
+static VmaAllocation		vk3dDepthAllocs[ VK_FRAMES_IN_FLIGHT ];
+
+static bool					vk3dActive;			// latched in BeginFrame, never mid-frame
+static int					vk3dWritePair = -1;	// pair THIS host frame renders into
+static int					vk3dWriteEye;		// which half of it this frame is
+// The pair the LEFT eye of the CURRENT host frame claimed, and the
+// vk3dBeginCount it claimed it at. The right eye may only ever attach to a pair
+// recorded here by the immediately preceding 3D BeginFrame: vk3dWritePair alone
+// is not that, because it survives a left eye that fell back without claiming
+// (a failed EnsureImages) and it survives a MONO frame that published the pair
+// outright, and a right eye reading it in either case writes eye[1] over an
+// image the compositor may be blitting. -1 = "this host frame has no pair".
+static int					vk3dFramePair = -1;
+static int					vk3dFramePairBegin = -1;
+// One pending entry per frame slot, indexed BY slot: the pair/eye submitted with
+// vkCtx.frameFences[ s ], or -1. Engine thread only (the compositor never sees a
+// pending pair).
+static int					vk3dPendingPair[ VK_FRAMES_IN_FLIGHT ];
+static int					vk3dPendingEye[ VK_FRAMES_IN_FLIGHT ];
+static int					vk3dPendingSerial[ VK_FRAMES_IN_FLIGHT ];
+static int					vk3dPublishedPair = -1;	// newest GPU-COMPLETE pair, -1 = none
+static int					vk3dPublishedSerial;	// never publish an older pair over a newer
+static int					vk3dReaders[ VK3D_PRESENT_PAIRS ];	// compositor blits in flight
+static int					vk3dFrames;			// PAIRS published
+static int					vk3dSubmitted;		// eye renders submitted
+static int					vk3dEyeRenders[ VK3D_EYE_COUNT ];	// eyeL / eyeR
+static int					vk3dBeginCount;		// 3D BeginFrames, the clock pubLatency counts in
+static int					vk3dSuperseded;		// complete pairs dropped: a newer one was ready
+static int					vk3dNotReady;		// polls that found a fence unsignalled
+static int					vk3dStalls;			// engine waited for a free pair
+static int					vk3dOverruns;		// engine found none even after waiting
+static int					vk3dHalfPairs;		// right eyes that fell back to the window
+/*
+ * D-107 defects 1 and 4 — the window swapchain while the panel owns the game.
+ *
+ * On HARDWARE, opening the ImmersiveSpace deactivates the 2D window scene
+ * (vkQuake ios/shell/ios_touch.m:1274-1279 records it; the simulator never
+ * does), and the shell now also hides the window's Metal view while it is
+ * curtained. A drawable presented into a layer the system is not displaying
+ * may never be released, and MoltenVK's acquire waits for exactly that release
+ * — with UINT64_MAX it waits forever. That is quake3e's freeze #1 and Bug B
+ * (DECISIONS "M1 nothing shows" / AppShell_vision.m:186-245), and it is the
+ * shape of the maintainer's 0.1.0.62 exit: window black, game audio still playing (the
+ * async sound thread does not need the engine thread), no way to continue.
+ *
+ * Three rules, all visionOS-3D only:
+ *  - in 3D a frame that finds no free pair is DROPPED, never rendered into the
+ *    window (it used to be: the "curtained window" fallback). The panel repeats
+ *    its last pair either way; only the old way could strand a drawable.
+ *  - leaving 3D recreates the swapchain, so the 2D window restarts on images
+ *    that were never presented while the window was not on screen.
+ *  - until the first successful acquire after leaving 3D, the acquire is
+ *    BOUNDED and a timeout drops the frame instead of wedging the thread.
+ */
+static int					vk3dWindowSkips;	// 3D frames dropped instead of touching the window
+static int					vk3dAcquireTimeouts;// bounded window acquires that timed out
+static int					vk3dExitRecreates;	// swapchain rebuilds on leaving 3D
+static bool					vk3dWindowGrace;	// bounded acquires until the window answers
+// D-107 review fold-in: the shell hides the window's Metal view the moment 3D is
+// REQUESTED (curtain up), a frame or more before BeginFrame latches r_stereo3d,
+// and keeps it hidden if VK_Stereo_EnsureImages() fails and the frame falls
+// back to the window. An acquire against that hidden layer is the same
+// stranded-drawable risk as leaving 3D, so it is bounded too. Written by the
+// shell on the main thread, read here on the engine thread.
+static std::atomic<int>		vk3dWindowHidden( 0 );
+static int					vk3dDroppedFrame = -1;	// tr.frameCount of a dropped frame
+static int					vk3dLatHist[ VK3D_LATENCY_BUCKETS ];	// publish latency, in engine frames
+static int					vk3dLatCount;
+static bool					vk3dWarnedCreate;
+static bool					vk3dPendingInit;	// the -1 fill, which a static zero is not
+
+// Guards everything the compositor thread can see: vk3dPublishedPair,
+// vk3dReaders, the image handles themselves, and the counters reported beside
+// them.
+static pthread_mutex_t		vk3dMutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t		vk3dCond = PTHREAD_COND_INITIALIZER;
+
+static void VK_Stereo_WaitMs( int ms ) {	// vk3dMutex held
+	struct timeval now;
+	struct timespec deadline;
+	gettimeofday( &now, NULL );
+	long long ns = (long long)now.tv_usec * 1000ll + (long long)ms * 1000000ll;
+	deadline.tv_sec = now.tv_sec + (time_t)( ns / 1000000000ll );
+	deadline.tv_nsec = (long)( ns % 1000000000ll );
+	pthread_cond_timedwait( &vk3dCond, &vk3dMutex, &deadline );
+}
+
+// The pending table is -1-filled, which static zero-initialisation is NOT: a
+// zeroed table reads as "pair 0 is pending on slot 0" and would publish a pair
+// nothing had ever rendered into. Called from ReleaseImages, which EnsureImages
+// runs before the first 3D frame can claim anything.
+static void VK_Stereo_ResetPending( void ) {
+	for ( int s = 0; s < VK_FRAMES_IN_FLIGHT; s++ ) {
+		vk3dPendingPair[ s ] = -1;
+		vk3dPendingEye[ s ] = 0;
+		vk3dPendingSerial[ s ] = 0;
+	}
+	vk3dPendingInit = true;
+}
+
+static bool VK_Stereo_IsPending( int pair ) {
+	if ( pair < 0 ) {
+		return false;
+	}
+	for ( int s = 0; s < VK_FRAMES_IN_FLIGHT; s++ ) {
+		if ( vk3dPendingPair[ s ] == pair ) {
+			return true;
+		}
+	}
+	return false;
+}
+
+// Is an eye of `pair` submitted and not yet retired? The right eye's own half
+// is the interesting one: the left eye being in flight is the normal state (a
+// pair occupies both frame slots by design), but a right eye already pending on
+// this pair means it is not ours to write.
+static bool VK_Stereo_IsPendingEye( int pair, int eye ) {	// vk3dMutex held
+	if ( pair < 0 ) {
+		return false;
+	}
+	for ( int s = 0; s < VK_FRAMES_IN_FLIGHT; s++ ) {
+		if ( vk3dPendingPair[ s ] == pair && vk3dPendingEye[ s ] == eye ) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool VK_Stereo_PairComplete( int pair ) {
+	if ( pair < 0 ) {
+		return false;
+	}
+	const vk3dPresentPair_t &p = vk3dPairs[ pair ];
+	return p.mono ? p.eyeDone[ 0 ] : ( p.eyeDone[ 0 ] && p.eyeDone[ 1 ] );
+}
+
+// p50 of the publish latency histogram, in engine frames. Small integers in a
+// tiny histogram rather than a sample ring: the interesting values are 0..3 and
+// the question is only ever "is it the guaranteed path or the early one".
+static int VK_Stereo_LatencyP50( void ) {
+	if ( vk3dLatCount <= 0 ) {
+		return -1;
+	}
+	const int half = ( vk3dLatCount + 1 ) / 2;
+	int seen = 0;
+	for ( int i = 0; i < VK3D_LATENCY_BUCKETS; i++ ) {
+		seen += vk3dLatHist[ i ];
+		if ( seen >= half ) {
+			return i;
+		}
+	}
+	return VK3D_LATENCY_BUCKETS - 1;
+}
+
+static int VK_Stereo_ReadersLocked( void ) {	// vk3dMutex held
+	int total = 0;
+	for ( int i = 0; i < VK3D_PRESENT_PAIRS; i++ ) {
+		total += vk3dReaders[ i ];
+	}
+	return total;
+}
+
+static void VK_Stereo_ReleaseImages( void ) {
+	pthread_mutex_lock( &vk3dMutex );
+	// Stop handing them out FIRST, so no new acquire can start while we wait.
+	vk3dPublishedPair = -1;
+	// The shell's exit path stops the compositor thread and waits for it before
+	// it writes r_stereo3d 0 (OpenQ4Vision3D.m), so this is normally already
+	// zero. "Normally" is not a guarantee anyone can make about a Metal queue
+	// this side does not own, and a Panel Resolution change lands here with the
+	// compositor RUNNING, so the ordering is CHECKED here rather than assumed
+	// there.
+	int waitedMs = 0;
+	while ( VK_Stereo_ReadersLocked() > 0 && waitedMs < 200 ) {
+		VK_Stereo_WaitMs( 10 );
+		waitedMs += 10;
+	}
+	const int stillReading = VK_Stereo_ReadersLocked();
+	for ( int i = 0; i < VK3D_PRESENT_PAIRS; i++ ) {
+		for ( int e = 0; e < VK3D_EYE_COUNT; e++ ) {
+			if ( vk3dPairs[ i ].eye[ e ].image != VK_NULL_HANDLE ) {
+				// Deferred: a frame in flight may still be reading this image.
+				VK_Device_DeferDestroy( vk3dPairs[ i ].eye[ e ].image,
+						vk3dPairs[ i ].eye[ e ].view, VK_NULL_HANDLE,
+						vk3dPairs[ i ].eye[ e ].allocation );
+			}
+		}
+		memset( &vk3dPairs[ i ], 0, sizeof( vk3dPairs[ i ] ) );
+		vk3dReaders[ i ] = 0;
+	}
+	for ( int s = 0; s < VK_FRAMES_IN_FLIGHT; s++ ) {
+		if ( vk3dDepthImages[ s ] != VK_NULL_HANDLE ) {
+			VK_Device_DeferDestroy( vk3dDepthImages[ s ], vk3dDepthViews[ s ],
+					VK_NULL_HANDLE, vk3dDepthAllocs[ s ] );
+		}
+		vk3dDepthImages[ s ] = VK_NULL_HANDLE;
+		vk3dDepthViews[ s ] = VK_NULL_HANDLE;
+		vk3dDepthAllocs[ s ] = NULL;
+	}
+	vk3dWritePair = -1;
+	vk3dWriteEye = 0;
+	vk3dFramePair = -1;
+	vk3dFramePairBegin = -1;
+	VK_Stereo_ResetPending();
+	vk3dPublishedSerial = 0;
+	vk3dEyeExtent.width = 0;
+	vk3dEyeExtent.height = 0;
+	pthread_mutex_unlock( &vk3dMutex );
+	if ( stillReading > 0 ) {
+		common->Warning( "Vulkan: stereo present pairs released with %d compositor "
+				"read(s) still outstanding after 200 ms", stillReading );
+	}
+}
+
+/*
+====================
+VK_Stereo_ClaimWritePair
+
+Engine thread, called for the LEFT eye of each host frame. Picks the pair this
+frame renders into: never one whose fences have not retired, never the published
+one (the compositor may acquire it at any instant), and NEVER one a blit is
+still reading — that last exclusion holds on every path out of this function,
+including the one taken when nothing is free. Returns -1 for "no pair": the
+caller then renders this frame to the window instead of the panel, which costs
+the shell one repeated frame and is the only answer that is never a race.
+====================
+*/
+static int VK_Stereo_ClaimWritePair( void ) {
+	int chosen = -1;
+	pthread_mutex_lock( &vk3dMutex );
+	// Five pairs give one being written, one pending its two fences, the
+	// published one and one the compositor has not finished with — but "one
+	// unfinished blit" is an argument, not a guarantee, and a third outstanding
+	// compositor command buffer under load exhausts it. So this waits (bounded,
+	// ~8 ms total) for a reader to retire before it gives up, rather than
+	// reasoning its way past the exclusion.
+	for ( int attempt = 0; attempt < 5 && chosen < 0; attempt++ ) {
+		for ( int i = 0; i < VK3D_PRESENT_PAIRS; i++ ) {
+			if ( VK_Stereo_IsPending( i ) || i == vk3dPublishedPair
+					|| i == vk3dWritePair || vk3dReaders[ i ] > 0 ) {
+				continue;
+			}
+			chosen = i;
+			break;
+		}
+		if ( chosen < 0 && attempt + 1 < 5 ) {
+			vk3dStalls++;
+			VK_Stereo_WaitMs( 2 );	// a Release broadcasts, so this usually wakes early
+		}
+	}
+	if ( chosen < 0 ) {
+		vk3dOverruns++;
+		// Last resort, and still not a pair a blit is reading: the PUBLISHED
+		// one. Its fences retired when it was published and no reader holds it,
+		// so overwriting it is safe — it is unpublished first so the compositor
+		// cannot acquire it mid-write, and the panel simply repeats its current
+		// pair until the next publish.
+		if ( vk3dPublishedPair >= 0 && !VK_Stereo_IsPending( vk3dPublishedPair )
+				&& vk3dReaders[ vk3dPublishedPair ] == 0 ) {
+			chosen = vk3dPublishedPair;
+			vk3dPublishedPair = -1;
+		}
+	}
+	// The final word, under the same lock the compositor takes to acquire. A
+	// held pair reaching the caller is the exact race this file exists to
+	// close, so it is refused here rather than argued about above.
+	if ( chosen >= 0 && vk3dReaders[ chosen ] > 0 ) {
+		chosen = -1;
+	}
+	if ( chosen >= 0 ) {
+		// A fresh pair: whatever half-finished state the previous tenant left
+		// (an abandoned pair whose right eye never came, for instance) is gone.
+		vk3dPairs[ chosen ].eyeDone[ 0 ] = false;
+		vk3dPairs[ chosen ].eyeDone[ 1 ] = false;
+		vk3dPairs[ chosen ].mono = false;
+		vk3dPairs[ chosen ].serial = vk3dBeginCount;
+	}
+	vk3dWritePair = chosen;
+	pthread_mutex_unlock( &vk3dMutex );
+	return chosen;
+}
+
+/*
+====================
+VK_Stereo_ClaimWriteEye1
+
+Engine thread, called for the RIGHT eye of each host frame with the pair its
+left eye claimed. Re-runs the SAME exclusions the claim ran, under the same
+lock, because none of them is a property the left eye could establish for the
+rest of the host frame: the pair may have been published in between (a mono
+frame does exactly that), the compositor may have acquired it, a Panel
+Resolution change may have released every pair, and the index may simply be a
+leftover from an earlier host frame whose right eye never ran.
+
+The left eye's own submit being pending is NOT an exclusion — that is the
+designed state, the pair occupies both frame slots — so only a pending RIGHT
+eye disqualifies the pair.
+
+Returns true when the pair is still ours to finish. On false the pair is
+ABANDONED rather than half-written: eyeDone is cleared so a pair carrying only
+a left eye can never satisfy VK_Stereo_PairComplete and reach the panel, and
+the caller renders this eye to the window instead.
+====================
+*/
+static void VK_Stereo_AbandonPairLocked( int pair ) {	// vk3dMutex held
+	if ( pair < 0 || pair >= VK3D_PRESENT_PAIRS ) {
+		return;
+	}
+	if ( pair == vk3dPublishedPair || vk3dReaders[ pair ] > 0 ) {
+		// Already on the panel, or being read: not ours to touch, and its
+		// eyeDone flags were cleared when it published anyway.
+		return;
+	}
+	// The left eye may still be pending on its slot and will set eyeDone[ 0 ]
+	// when it retires; with eyeDone[ 1 ] false and mono false the pair is
+	// incomplete forever, which is what we want — it is reclaimed (and fully
+	// reset) by the next VK_Stereo_ClaimWritePair.
+	vk3dPairs[ pair ].eyeDone[ 0 ] = false;
+	vk3dPairs[ pair ].eyeDone[ 1 ] = false;
+	if ( pair == vk3dWritePair ) {
+		vk3dWritePair = -1;
+	}
+}
+
+static void VK_Stereo_AbandonPair( int pair ) {
+	pthread_mutex_lock( &vk3dMutex );
+	VK_Stereo_AbandonPairLocked( pair );
+	pthread_mutex_unlock( &vk3dMutex );
+}
+
+static bool VK_Stereo_ClaimWriteEye1( int pair ) {
+	bool ok = false;
+	pthread_mutex_lock( &vk3dMutex );
+	if ( pair >= 0 && pair < VK3D_PRESENT_PAIRS
+			&& pair == vk3dWritePair
+			&& pair != vk3dPublishedPair
+			&& vk3dReaders[ pair ] == 0
+			&& !vk3dPairs[ pair ].mono
+			&& !vk3dPairs[ pair ].eyeDone[ 1 ]
+			&& !VK_Stereo_IsPendingEye( pair, 1 ) ) {
+		ok = true;
+	}
+	if ( !ok ) {
+		VK_Stereo_AbandonPairLocked( pair );
+	}
+	pthread_mutex_unlock( &vk3dMutex );
+	return ok;
+}
+
+/*
+====================
+VK_Stereo_RetirePending
+
+Engine thread, called from BeginFrame with `waitedSlot`'s fence just waited on
+and not yet reset. Marks an eye complete only when its frame's fence is
+signalled, and publishes a PAIR only when the pair is whole.
+
+Every frame slot carries its own pending entry, so no submitted eye is ever
+discarded by the next frame (the 0.1.0.58 starvation). Two retire points, and
+the first of them is a guarantee rather than a hope:
+
+  - `waitedSlot`: its fence was just WAITED on, so its pending eye is complete
+    by construction. This is the backstop that bounds publish latency at
+    VK_FRAMES_IN_FLIGHT frames however fast the engine runs.
+  - every other slot: a non-blocking vkGetFenceStatus, which completes sooner
+    when the GPU has already finished. `notReady` counts the polls that say
+    "not yet" — expected at high frame rates, and no longer a lost frame.
+
+When more than one complete pair is available only the NEWEST is published
+(`superseded` counts the rest); publishing is otherwise strictly forward in
+serial order, so the panel can never step backwards in time, and it never shows
+two eyes from different game times.
+====================
+*/
+static void VK_Stereo_RetirePending( int waitedSlot ) {
+	if ( !vk3dPendingInit ) {
+		return;
+	}
+	const bool lateOnly = r_stereo3dLateRetire.GetBool();
+	pthread_mutex_lock( &vk3dMutex );
+	for ( int s = 0; s < VK_FRAMES_IN_FLIGHT; s++ ) {
+		const int pair = vk3dPendingPair[ s ];
+		if ( pair < 0 ) {
+			continue;
+		}
+		bool complete = ( s == waitedSlot );	// just waited on it: complete, always
+		if ( !complete && !lateOnly ) {
+			complete = ( vkGetFenceStatus( vkCtx.device,
+					vkCtx.frameFences[ s ] ) == VK_SUCCESS );
+		}
+		if ( !complete ) {
+			// Stays pending on its own slot and retires at that slot's wait.
+			vk3dNotReady++;
+			continue;
+		}
+		vk3dPairs[ pair ].eyeDone[ vk3dPendingEye[ s ] ] = true;
+		vk3dPendingPair[ s ] = -1;
+	}
+
+	// Whole pairs only, newest first.
+	int bestPair = -1;
+	for ( int i = 0; i < VK3D_PRESENT_PAIRS; i++ ) {
+		if ( !VK_Stereo_PairComplete( i ) || VK_Stereo_IsPending( i )
+				|| i == vk3dPublishedPair ) {
+			continue;
+		}
+		if ( vk3dPairs[ i ].serial <= vk3dPublishedSerial ) {
+			// Finished, and older than what is already on the panel: showing it
+			// would step the panel backwards for one frame. Counted, not hidden.
+			vk3dPairs[ i ].eyeDone[ 0 ] = false;
+			vk3dPairs[ i ].eyeDone[ 1 ] = false;
+			vk3dSuperseded++;
+			continue;
+		}
+		if ( bestPair < 0 || vk3dPairs[ i ].serial > vk3dPairs[ bestPair ].serial ) {
+			if ( bestPair >= 0 ) {
+				vk3dPairs[ bestPair ].eyeDone[ 0 ] = false;
+				vk3dPairs[ bestPair ].eyeDone[ 1 ] = false;
+				vk3dSuperseded++;
+			}
+			bestPair = i;
+		} else {
+			vk3dPairs[ i ].eyeDone[ 0 ] = false;
+			vk3dPairs[ i ].eyeDone[ 1 ] = false;
+			vk3dSuperseded++;
+		}
+	}
+	if ( bestPair >= 0 ) {
+		// Published pairs stop being "complete and waiting": eyeDone means
+		// awaiting publication, and leaving it set made the scan re-find the
+		// pair one round later, once a newer pair had taken the published slot,
+		// and count it as SUPERSEDED. That inflated the drop count by roughly
+		// one per publish (4588 against 10461 publishes in the round-3 sim run)
+		// while nothing was actually being dropped. everRendered is what the
+		// compositor reads, and it stays set.
+		vk3dPairs[ bestPair ].eyeDone[ 0 ] = false;
+		vk3dPairs[ bestPair ].eyeDone[ 1 ] = false;
+		const int latency = vk3dBeginCount - vk3dPairs[ bestPair ].serial;
+		vk3dLatHist[ ( latency < 0 ) ? 0
+				: ( latency >= VK3D_LATENCY_BUCKETS ) ? VK3D_LATENCY_BUCKETS - 1
+				: latency ]++;
+		vk3dLatCount++;
+		vk3dPairs[ bestPair ].everRendered = true;
+		vk3dPublishedPair = bestPair;
+		vk3dPublishedSerial = vk3dPairs[ bestPair ].serial;
+		vk3dFrames++;
+	}
+	pthread_cond_broadcast( &vk3dCond );
+	pthread_mutex_unlock( &vk3dMutex );
+}
