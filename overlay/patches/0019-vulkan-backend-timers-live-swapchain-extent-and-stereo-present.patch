+// The requested per-eye extent, clamped to something the device can actually
+// allocate. Read fresh every frame so the Panel Resolution row takes effect at
+// the next frame boundary and needs no vid_restart: the swapchain is not
+// involved, so there is nothing to restart.
+static void VK_Stereo_WantedExtent( uint32_t *width, uint32_t *height ) {
+	int w = r_stereo3dWidth.GetInteger();
+	int h = r_stereo3dHeight.GetInteger();
+	const int maxDim = (int)vkCtx.deviceProperties.limits.maxImageDimension2D;
+	if ( w < 640 ) { w = 640; }
+	if ( h < 360 ) { h = 360; }
+	if ( maxDim > 0 && w > maxDim ) { w = maxDim; }
+	if ( maxDim > 0 && h > maxDim ) { h = maxDim; }
+	*width = (uint32_t)w;
+	*height = (uint32_t)h;
+}
+
+static bool VK_Stereo_EnsureImages( void ) {
+	uint32_t width = 0, height = 0;
+	VK_Stereo_WantedExtent( &width, &height );
+	const VkFormat format = vkCtx.swapchainFormat;
+	if ( width == 0 || height == 0 || format == VK_FORMAT_UNDEFINED
+			|| vkCtx.depthFormat == VK_FORMAT_UNDEFINED || vkCtx.allocator == NULL ) {
+		return false;
+	}
+	if ( vk3dPairs[ 0 ].eye[ 0 ].image != VK_NULL_HANDLE
+			&& vk3dEyeExtent.width == width
+			&& vk3dEyeExtent.height == height
+			&& vk3dEyeFormat == format ) {
+		return true;
+	}
+	VK_Stereo_ReleaseImages();
+
+	for ( int i = 0; i < VK3D_PRESENT_PAIRS; i++ ) {
+		for ( int e = 0; e < VK3D_EYE_COUNT; e++ ) {
+			// COLOR_ATTACHMENT: the composite renders into it. SAMPLED: the
+			// Metal panel pass reads it (MTLTextureUsageShaderRead).
+			// TRANSFER_SRC/DST: the screenshot and capture paths copy out of
+			// and into the active target, and in 3D that target is this image.
+			if ( !VK_Stereo_CreateImage( width, height, format,
+					VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT
+					| VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+					VK_IMAGE_ASPECT_COLOR_BIT,
+					&vk3dPairs[ i ].eye[ e ].image, &vk3dPairs[ i ].eye[ e ].view,
+					&vk3dPairs[ i ].eye[ e ].allocation ) ) {
+				if ( !vk3dWarnedCreate ) {
+					vk3dWarnedCreate = true;
+					common->Warning( "Vulkan: stereo present image creation failed (%ux%u fmt %d)",
+							width, height, (int)format );
+				}
+				VK_Stereo_ReleaseImages();
+				return false;
+			}
+		}
+	}
+	for ( int s = 0; s < VK_FRAMES_IN_FLIGHT; s++ ) {
+		if ( !VK_Stereo_CreateImage( width, height, vkCtx.depthFormat,
+				VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+				VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT,
+				&vk3dDepthImages[ s ], &vk3dDepthViews[ s ], &vk3dDepthAllocs[ s ] ) ) {
+			if ( !vk3dWarnedCreate ) {
+				vk3dWarnedCreate = true;
+				common->Warning( "Vulkan: stereo depth image creation failed (%ux%u)",
+						width, height );
+			}
+			VK_Stereo_ReleaseImages();
+			return false;
+		}
+	}
+	vk3dEyeExtent.width = width;
+	vk3dEyeExtent.height = height;
+	vk3dEyeFormat = format;
+	common->Printf( "Vulkan: stereo present pairs %ux%u per eye x%d created\n",
+			width, height, VK3D_PRESENT_PAIRS );
+	return true;
+}
