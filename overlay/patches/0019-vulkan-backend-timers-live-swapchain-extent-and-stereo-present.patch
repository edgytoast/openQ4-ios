+#include <pthread.h>
+#include <sys/time.h>
+idCVar r_stereo3d( "r_stereo3d", "0", CVAR_RENDERER | CVAR_BOOL,
+		"visionOS: render the composite into offscreen present images for the "
+		"CompositorServices panel instead of the window swapchain" );
+// Debug-only, and the reason the 0.1.0.58 starvation could be reproduced on a
+// 60 Hz simulator at all: with this set, a pending image is retired ONLY at the
+// blocking wait on its own slot's fence, never by the opportunistic poll of the
+// other slot. That is exactly what 120 Hz hardware does on its own (the poll
+// there always finds the fence unsignalled), so the sim then exercises the
+// worst case — maximum publish latency, every publish taken on the guaranteed
+// path — instead of the easy one.
+idCVar r_stereo3dLateRetire( "r_stereo3dLateRetire", "0", CVAR_RENDERER | CVAR_BOOL,
+		"visionOS debug: publish present images only at their own slot's fence wait, "
+		"emulating the 120 Hz hardware case on a 60 Hz simulator" );
