+/*
+====================
+Backend stage timers (r_vkSpeeds)
+
+com_speeds' `bk` column is written only by the GL backend (tr_backend.cpp), so
+under the Vulkan module it reads zero and the entire backend half of the frame
+is invisible: gfr and rf account for a couple of milliseconds of a frame that
+measurably costs ten, and nothing shipped says where the rest goes.
+
+These timers close that hole. Five stages are measured inside the frame --
+the fence wait for the slot to retire, the swapchain acquire, all command
+recording, the queue submit (where MoltenVK encodes Metal synchronously by
+default, so it is not the cheap call it looks like), and the present -- plus
+the wall time of RB_ExecuteBackEndCommands, which also becomes backEnd.pc.msec
+so com_speeds tells the truth under Vulkan.
+
+Reporting is one line every VK_SPEEDS_REPORT_FRAMES frames, never per frame: a
+per-frame print costs more than the thing it measures and drowns the console.
+====================
+*/
+idCVar r_vkSpeeds( "r_vkSpeeds", "0", CVAR_RENDERER | CVAR_INTEGER,
+		"report Vulkan backend stage timings (fence/acquire/record/submit/present) every 300 frames" );
+
+#define VK_SPEEDS_REPORT_FRAMES		300
+
+typedef struct vkSpeedsStage_s {
+	double	total;
+	double	max;
+} vkSpeedsStage_t;
+
+static struct {
+	vkSpeedsStage_t	fence;
+	vkSpeedsStage_t	acquire;
+	vkSpeedsStage_t	record;
+	vkSpeedsStage_t	submit;
+	vkSpeedsStage_t	present;
+	vkSpeedsStage_t	execute;
+	int				frames;
+	double			recordStartTicks;
+} vkSpeeds;
+
+bool VK_Speeds_Enabled( void ) {
+	return r_vkSpeeds.GetInteger() != 0;
+}
+
+static void VK_Speeds_Add( vkSpeedsStage_t &stage, double startTicks, double endTicks ) {
+	const double perSecond = Sys_ClockTicksPerSecond();
+	if ( perSecond <= 0.0 || startTicks <= 0.0 ) {
+		return;
+	}
+	const double ms = ( endTicks - startTicks ) * 1000.0 / perSecond;
+	if ( ms < 0.0 ) {
+		return;
+	}
+	stage.total += ms;
+	if ( ms > stage.max ) {
+		stage.max = ms;
+	}
+}
+
+/*
+====================
+GPU pass timings (r_vkGpuTimes)
+
+The CPU stage timers above answer "where does the frame's CPU time go"; they
+cannot answer "which pass costs the GPU its milliseconds", and on a tiled
+mobile GPU that is the question -- the frame is fill- and bandwidth-bound long
+before it is CPU-bound, and no external profiler can attach to a sideloaded
+build to say so.
+
+Timestamp queries can. A pool of VK_GPU_MAX_QUERIES timestamps per frame slot
+is reset at the top of the frame's command buffer and written at pass
+boundaries; the slot's results are read when that slot is claimed again, after
+its fence has already been waited on, so the read never adds a wait of its own
+(a not-ready result skips the sample rather than stalling).
+
+Each write records the stage that *starts* there, so consecutive timestamps
+partition the frame: the segment from write i to write i+1 belongs to
+stageOf[i], and the segments sum to the frame's GPU time by construction. A
+stage may appear several times (the ambient walk is interrupted by feedback
+captures); the buckets accumulate.
+
+A timestamp is only honest where a real encoder boundary exists. MoltenVK
+resolves timestamps at Metal encoder/stage boundaries, so a marker written in
+the middle of a render pass snaps to the boundary of the encoder containing it
+-- and this backend draws the depth prepass, the light loop, both ambient walks
+and the post pass inside ONE rendering scope opened at the top of the frame.
+Markers at those logical boundaries would therefore collapse into each other
+and report zeros beside a segment carrying everyone's work, which is worse than
+not splitting at all.
+
+So there are two modes, and the difference between them is not cosmetic:
+
+  r_vkGpuTimes 1 -- honest. Markers are written only where the backend already
+    ends and resumes the rendering scope: the frame's own start and end, the
+    shadow-map atlas (rendered in a frame-scope interruption), and each
+    feedback capture (which interrupts the scope to blit). Everything drawn
+    inside the single main scope is reported as one bucket, `main`. The frame
+    is unperturbed, so the total is the frame's real GPU time.
+
+  r_vkGpuTimes 2 -- split, for attribution. At each logical stage boundary the
+    instrument deliberately ends the rendering scope, writes the timestamp at
+    the resulting real boundary, and resumes with LOAD_OP_LOAD on colour and
+    depth. Every stage then gets its own bucket -- and its own tile store plus
+    reload, which is exactly the bandwidth cost this port is hunting. Mode 2
+    therefore MEASURES A DIFFERENT FRAME than the one that ships: use it to
+    learn which stage owns the milliseconds, never for an absolute number. The
+    `passes` and `loads` counters below show what the split cost.
+
+Alongside the timings, the render-pass shape is counted: every
+vkCmdBeginRendering, every attachment that arrives with LOAD_OP_LOAD, and
+every depth/stencil attachment that leaves with STORE_OP_STORE. On a tiler
+each of those is real bandwidth -- a scope split for a feedback capture pays a
+full-frame depth store plus a full-frame load to resume -- and the count is
+half of any tiled-GPU diagnosis. Those are CPU-side counts, so they are
+reported even where timestamps are unsupported.
+
+There is no iOS-specific code here; it is offered upstream as-is.
+====================
+*/
+idCVar r_vkGpuTimes( "r_vkGpuTimes", "0", CVAR_RENDERER | CVAR_INTEGER,
+		"GPU pass timings on the r_vkSpeeds cadence: 1 = honest (one bucket for the main scope), 2 = split the scope per stage for attribution (perturbs the frame), 3 = trace every render pass of ONE frame, print it once and drop back to the previous mode" );
+
+typedef enum {
+	VKGPU_MAIN,			// everything drawn inside the one main rendering scope
+	VKGPU_PREPASS,
+	VKGPU_SHADOWMAP,
+	VKGPU_LIGHTS,
+	VKGPU_AMBIENT,
+	VKGPU_CAPTURE,
+	VKGPU_POST,
+	VKGPU_GUI,
+	VKGPU_STAGE_COUNT
+} vkGpuStage_t;
+
+#define VK_GPU_MAX_QUERIES		64
+
+static struct {
+	bool			checked;
+	bool			supported;
+	double			periodNs;
+	uint64_t		validMask;
+	VkQueryPool		pools[ VK_FRAMES_IN_FLIGHT ];
+
+	// the frame recorded into each slot: how many timestamps it wrote, what
+	// each one starts, and the CPU-side pass shape
+	int				count[ VK_FRAMES_IN_FLIGHT ];
+	unsigned char	stageOf[ VK_FRAMES_IN_FLIGHT ][ VK_GPU_MAX_QUERIES ];
+	bool			submitted[ VK_FRAMES_IN_FLIGHT ];
+	int				passes[ VK_FRAMES_IN_FLIGHT ];
+	int				loads[ VK_FRAMES_IN_FLIGHT ];
+	int				depthStores[ VK_FRAMES_IN_FLIGHT ];
+	int				captures[ VK_FRAMES_IN_FLIGHT ];
+
+	// the frame being recorded right now
+	bool			active;
+	int				mode;			// latched per frame from the cvar
+	int				slot;
+	int				lastStage;
+	int				framePasses;
+	int				frameLoads;
+	int				frameDepthStores;
+	int				frameCaptures;
+
+	// report window
+	int				windowMode;		// the mode every frame in it was recorded under
+	int				windowFrames;
+	int				windowSamples;
+	int				inertSamples;
+	double			stageTotal[ VKGPU_STAGE_COUNT ];
+	double			total;
+	double			totalMax;
+	int				sumPasses, maxPasses;
+	int				sumLoads, maxLoads;
+	int				sumStores, maxStores;
+	int				sumCaptures;
+
+	// Lifetime count of frames whose swapchain image was never rendered into
+	// and had to be given a defined clear at frame end (D-077). Never reset by
+	// a window: the question it answers is "did this ever fire at all".
+	int				swapchainFallbacks;
+} vkGpuTimes;
+
+bool VK_GpuTimes_Enabled( void ) {
+	return r_vkGpuTimes.GetInteger() != 0;
+}
+
+/*
+====================
+VK_GpuTimes_CheckSupport
+
+Once per process, and only when someone asks for the report: timestamps are
+supported when the physical device advertises a non-zero period AND the queue
+the frames are submitted on advertises valid bits. timestampComputeAndGraphics
+is printed for the record but not believed on its own -- the per-queue-family
+validBits is what the spec makes authoritative.
+====================
+*/
+static void VK_GpuTimes_CheckSupport( void ) {
+	if ( vkGpuTimes.checked ) {
+		return;
+	}
+	vkGpuTimes.checked = true;
+
+	const float period = vkCtx.deviceProperties.limits.timestampPeriod;
+	const VkBool32 computeAndGraphics = vkCtx.deviceProperties.limits.timestampComputeAndGraphics;
+
+	uint32_t validBits = 0;
+	uint32_t familyCount = 0;
+	vkGetPhysicalDeviceQueueFamilyProperties( vkCtx.physicalDevice, &familyCount, NULL );
+	VkQueueFamilyProperties families[ 16 ];
+	if ( familyCount > 16 ) {
+		familyCount = 16;
+	}
+	if ( familyCount > 0 ) {
+		vkGetPhysicalDeviceQueueFamilyProperties( vkCtx.physicalDevice, &familyCount, families );
+		if ( vkCtx.graphicsQueueFamily < familyCount ) {
+			validBits = families[ vkCtx.graphicsQueueFamily ].timestampValidBits;
+		}
+	}
+
+	if ( period <= 0.0f || validBits == 0 ) {
+		common->Printf( "Vulkan: GPU timestamps unsupported (timestampPeriod %.3f, graphics queue "
+				"timestampValidBits %u, timestampComputeAndGraphics %d); r_vkGpuTimes reports "
+				"render-pass counts only\n", period, validBits, (int)computeAndGraphics );
+		return;
+	}
+
+	vkGpuTimes.periodNs = (double)period;
+	vkGpuTimes.validMask = validBits >= 64
+			? ~(uint64_t)0
+			: ( ( (uint64_t)1 << validBits ) - 1 );
+
+	VkQueryPoolCreateInfo qpci;
+	memset( &qpci, 0, sizeof( qpci ) );
+	qpci.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+	qpci.queryType = VK_QUERY_TYPE_TIMESTAMP;
+	qpci.queryCount = VK_GPU_MAX_QUERIES;
+	for ( int i = 0; i < VK_FRAMES_IN_FLIGHT; i++ ) {
+		if ( vkCreateQueryPool( vkCtx.device, &qpci, NULL, &vkGpuTimes.pools[ i ] ) != VK_SUCCESS ) {
+			vkGpuTimes.pools[ i ] = VK_NULL_HANDLE;
+			common->Printf( "Vulkan: GPU timestamps unsupported (query pool creation failed); "
+					"r_vkGpuTimes reports render-pass counts only\n" );
+			return;
+		}
+	}
+
+	vkGpuTimes.supported = true;
+	common->Printf( "Vulkan: GPU timestamps supported (timestampPeriod %.3f ns, graphics queue "
+			"timestampValidBits %u, timestampComputeAndGraphics %d); markers sit at pass "
+			"boundaries because MoltenVK resolves them at encoder boundaries\n",
+			period, validBits, (int)computeAndGraphics );
+}
+
+static const char *vkGpuStageNames[ VKGPU_STAGE_COUNT ] = {
+	"main", "prepass", "shadowmap", "lights", "ambient", "capture", "post", "gui"
+};
+
+// returns the query index written, or -1 when nothing was written (timestamps
+// unsupported, or the frame ran the pool out). Mode 3 needs to know which, so
+// that a pass whose marker did not fit prints `gpu=n/a` instead of a delta
+// belonging to its neighbour.
+static int VK_GpuTimes_Write( VkCommandBuffer cmd, int stage ) {
+	if ( !vkGpuTimes.supported ) {
+		return -1;	// mode 2 still splits: the pass counters are the evidence
+	}
+	const int slot = vkGpuTimes.slot;
+	const int index = vkGpuTimes.count[ slot ];
+	if ( index >= VK_GPU_MAX_QUERIES ) {
+		return -1;	// a pathological frame: keep the partition, drop the tail
+	}
+	vkGpuTimes.stageOf[ slot ][ index ] = (unsigned char)stage;
+	vkCmdWriteTimestamp2( cmd, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+			vkGpuTimes.pools[ slot ], (uint32_t)index );
+	vkGpuTimes.count[ slot ] = index + 1;
+	return index;
+}
+
+// The executor state itself is declared further down this file, so the frame's
+// command buffer and scope state arrive through accessors.
+VkCommandBuffer VK_Exec_ActiveCmd( void );
+bool VK_Exec_MainScopeOpen( void );
+// strictly "a scope is recording right now": VK_Exec_MainScopeOpen also
+// reports an armed-but-unopened scope, which a stage boundary must not disturb
+bool VK_Exec_MainScopeOpenNow( void );
+// the active colour target, for naming a traced pass (r_vkGpuTimes 3)
+VkImageView VK_Exec_ActiveColorView( void );
+const char *VK_Exec_ActiveTargetName( void );
+unsigned int VK_Exec_ActiveSampleCount( void );
+
+/*
+====================
+VK_GpuTimes_BoundaryStage
+
+A marker at a boundary the backend creates on its own -- the frame's start and
+end, the shadow atlas interruption, a feedback capture. Written in every mode,
+because the encoder boundary is there either way.
+====================
+*/
+static void VK_GpuTimes_BoundaryStage( int stage ) {
+	if ( !vkGpuTimes.active ) {
+		return;
+	}
+	vkGpuTimes.lastStage = stage;
+	VkCommandBuffer cmd = VK_Exec_ActiveCmd();
+	if ( cmd == VK_NULL_HANDLE ) {
+		return;
+	}
+	VK_GpuTimes_Write( cmd, stage );
+}
+
+/*
+====================
+VK_GpuTimes_SplitStage
+
+A LOGICAL boundary inside the main rendering scope, where no encoder boundary
+exists. Mode 1 does nothing at all -- not even move the current stage -- so the
+whole scope stays one honest `main` bucket. Mode 2 makes the boundary real by
+ending the scope and resuming it with LOAD_OP_LOAD, which is what lets the
+stage be attributed and what makes mode 2 a different frame.
+====================
+*/
+static void VK_GpuTimes_SplitStage( int stage ) {
+	if ( !vkGpuTimes.active ) {
+		return;
+	}
+	if ( vkGpuTimes.mode != 2 ) {
+		// Mode 3 traces the frame the port actually renders, so it must not
+		// split it either -- but it does follow the logical stage, so a traced
+		// pass can say which stage the timer believes it is in.
+		if ( vkGpuTimes.mode == 3 ) {
+			vkGpuTimes.lastStage = stage;
+		}
+		return;
+	}
+	VkCommandBuffer cmd = VK_Exec_ActiveCmd();
+	if ( cmd == VK_NULL_HANDLE ) {
+		return;
+	}
+	vkGpuTimes.lastStage = stage;
+	// Deliberately NOT VK_Exec_MainScopeOpen(), which also reports an ARMED
+	// scope: a boundary in front of an armed-but-unopened scope must leave it
+	// armed (D-077), not end it and eagerly reopen an empty pass.
+	const bool wasOpen = VK_Exec_MainScopeOpenNow();
+	if ( wasOpen ) {
+		VK_Exec_EndMainRendering();
+	}
+	VK_GpuTimes_Write( cmd, stage );
+	if ( wasOpen ) {
+		// colour and depth resume with LOAD_OP_LOAD; the resume path issues
+		// the barrier that makes the stores visible and re-establishes the
+		// executor's dynamic-state baseline, exactly as it does for a capture
+		VK_Exec_BeginMainRendering( false );
+	}
+}
+
+// cross-TU entry points: vk_Interactions.cpp brackets the shadow atlas render
+// it drives, without either file needing the stage enum. Both are real
+// boundaries -- the atlas ends the main scope and resumes it.
+void VK_GpuTimes_BeginShadowMapStage( void ) {
+	VK_GpuTimes_BoundaryStage( VKGPU_SHADOWMAP );
+}
+
+void VK_GpuTimes_EndShadowMapStage( void ) {
+	VK_GpuTimes_BoundaryStage( vkGpuTimes.mode == 2 ? VKGPU_LIGHTS : VKGPU_MAIN );
+}
+
+/*
+====================
+One-shot render-pass trace (r_vkGpuTimes 3)
+
+The counters above say a frame opens eleven render passes; they cannot say
+which eleven, and on a tiler the identity of a pass -- its target, its extent,
+what it loads and what it stores -- is the whole diagnosis. Mode 3 names them.
+
+Setting r_vkGpuTimes 3 arms a trace for exactly ONE frame: every
+vkCmdBeginRendering of that frame is recorded in order, with the stage the GPU
+timer believes it is in, the site that opened it, why the previous scope ended,
+the target, the render area, the sample count, the load/store ops, how many
+material-stage draws it received and the first material drawn into it. When
+that frame's slot is collected (behind the fence the frame loop already waits
+on), the trace is printed once and the cvar drops back to the mode it was in
+before -- mode 3 never runs for a second frame.
+
+Each traced pass also gets its own timestamp, written immediately before its
+vkCmdBeginRendering. That is honest on MoltenVK for the reason mode 2 has to
+work around: a vkCmdBeginRendering IS a Metal encoder boundary, so a marker
+placed there needs no boundary manufactured for it and the frame is not
+perturbed. `gpu=` on a pass line is the interval from its own marker to the
+next marker written -- the pass itself plus whatever ran between it and the
+next pass (an image copy, a resolve, barriers). The closing line prints the
+frame total (first marker to last), the sum of the pass intervals, and the
+unattributed remainder, so the partition is auditable rather than asserted. A
+frame with more passes than the 64-query pool holds prints `gpu=n/a` for the
+passes whose marker did not fit and says `truncated`.
+
+Recording is field copies and const char * pointers only: no allocation and no
+formatting happens inside the frame, and when the trace is not armed the whole
+mechanism is a single predictable compare per render pass. Mode 3 does not
+split the scope (that is mode 2's job), so the frame traced is the frame the
+port actually renders.
+====================
+*/
+#define VK_GPU_MAX_TRACE_PASSES		64
+
+typedef enum {
+	VKGPUTRACE_IDLE,
+	VKGPUTRACE_ARMED,		// recording the frame being built right now
+	VKGPUTRACE_RECORDED		// recorded and submitted; waiting for its fence
+} vkGpuTraceState_t;
+
+typedef struct {
+	const char *	site;			// the backend call that opened the pass
+	const char *	stage;			// the stage the GPU timer thinks it is in
+	const char *	after;			// why the previous scope ended
+	const char *	target;			// "swapchain", a render texture, depth-only
+	uint32_t		width;
+	uint32_t		height;
+	unsigned int	samples;		// 0 when this call site cannot know
+	int				colorLoad;
+	int				colorStore;
+	int				depthLoad;
+	int				depthStore;
+	bool			hasColor;
+	bool			hasDepth;
+	bool			hasStencil;
+	int				beginMarker;	// query index of this pass's own marker, -1 if none
+	int				stageDraws;		// material-stage draws recorded into this pass
+	const char *	material;		// the first material drawn into it, if any
+} vkGpuTracePass_t;
+
+static struct {
+	int					state;
+	int					slot;
+	int					prevMode;		// what the cvar returns to
+	int					count;
+	int					dropped;		// passes past VK_GPU_MAX_TRACE_PASSES
+	const char *		pendingReason;	// why the scope that just ended, ended
+	vkGpuTracePass_t	passes[ VK_GPU_MAX_TRACE_PASSES ];
+} vkGpuTrace;
+
+static const char *VK_GpuTrace_LoadOpName( int op ) {
+	switch ( op ) {
+		case VK_ATTACHMENT_LOAD_OP_LOAD:		return "LOAD";
+		case VK_ATTACHMENT_LOAD_OP_CLEAR:		return "CLEAR";
+		case VK_ATTACHMENT_LOAD_OP_DONT_CARE:	return "DONTCARE";
+		default:								return "?";
+	}
+}
+
+static const char *VK_GpuTrace_StoreOpName( int op ) {
+	switch ( op ) {
+		case VK_ATTACHMENT_STORE_OP_STORE:		return "STORE";
+		case VK_ATTACHMENT_STORE_OP_DONT_CARE:	return "DONTCARE";
+		case VK_ATTACHMENT_STORE_OP_NONE:		return "NONE";
+		default:								return "?";
+	}
+}
+
+/*
+====================
+VK_GpuTimes_NoteScopeEnd
+
+Called immediately before the backend ends the main rendering scope, naming the
+reason in one word. The next pass recorded reports it as the reason the
+previous scope ended -- which is the question "why are there eleven passes"
+actually asks. A pointer store, and only while a trace is armed.
+====================
+*/
+void VK_GpuTimes_NoteScopeEnd( const char *reason ) {
+	if ( vkGpuTrace.state == VKGPUTRACE_ARMED ) {
+		vkGpuTrace.pendingReason = reason;
+	}
+}
+
+static const char *VK_GpuTrace_TargetName( const VkRenderingInfo *renderingInfo,
+		unsigned int *samples ) {
+	*samples = 0;
+	VkImageView view = VK_NULL_HANDLE;
+	if ( renderingInfo->colorAttachmentCount > 0 && renderingInfo->pColorAttachments != NULL ) {
+		view = renderingInfo->pColorAttachments[ 0 ].imageView;
+	}
+	if ( view == VK_NULL_HANDLE ) {
+		return "depth-only";
+	}
+	for ( uint32_t i = 0; i < vkCtx.swapchainImageCount; i++ ) {
+		if ( vkCtx.swapchainViews[ i ] == view ) {
+			*samples = 1;
+			return "swapchain";
+		}
+	}
+	if ( view == VK_Exec_ActiveColorView() ) {
+		*samples = VK_Exec_ActiveSampleCount();
+		return VK_Exec_ActiveTargetName();
+	}
+	return "render-texture";
+}
+
+static void VK_GpuTrace_Record( const VkRenderingInfo *renderingInfo, const char *site,
+		int beginMarker ) {
+	if ( vkGpuTrace.count >= VK_GPU_MAX_TRACE_PASSES ) {
+		vkGpuTrace.dropped++;
+		return;
+	}
+	vkGpuTracePass_t &pass = vkGpuTrace.passes[ vkGpuTrace.count++ ];
+	memset( &pass, 0, sizeof( pass ) );
+	pass.site = site != NULL ? site : "?";
+	const int stage = vkGpuTimes.lastStage;
+	pass.stage = ( stage >= 0 && stage < VKGPU_STAGE_COUNT ) ? vkGpuStageNames[ stage ] : "?";
+	pass.after = vkGpuTrace.pendingReason != NULL ? vkGpuTrace.pendingReason : "-";
+	vkGpuTrace.pendingReason = NULL;
+	pass.target = VK_GpuTrace_TargetName( renderingInfo, &pass.samples );
+	pass.width = renderingInfo->renderArea.extent.width;
+	pass.height = renderingInfo->renderArea.extent.height;
+	if ( renderingInfo->colorAttachmentCount > 0 && renderingInfo->pColorAttachments != NULL
+			&& renderingInfo->pColorAttachments[ 0 ].imageView != VK_NULL_HANDLE ) {
+		pass.hasColor = true;
+		pass.colorLoad = (int)renderingInfo->pColorAttachments[ 0 ].loadOp;
+		pass.colorStore = (int)renderingInfo->pColorAttachments[ 0 ].storeOp;
+	}
+	if ( renderingInfo->pDepthAttachment != NULL
+			&& renderingInfo->pDepthAttachment->imageView != VK_NULL_HANDLE ) {
+		pass.hasDepth = true;
+		pass.depthLoad = (int)renderingInfo->pDepthAttachment->loadOp;
+		pass.depthStore = (int)renderingInfo->pDepthAttachment->storeOp;
+	}
+	pass.hasStencil = renderingInfo->pStencilAttachment != NULL
+			&& renderingInfo->pStencilAttachment->imageView != VK_NULL_HANDLE;
+	pass.beginMarker = beginMarker;
+	pass.stageDraws = 0;
+	pass.material = NULL;
+}
+
+/*
+====================
+VK_GpuTrace_NoteDraw
+
+Called from the material-stage draw paths -- the ambient/2D stage loop and the
+three GLSL program-stage paths, which is where every post-process full-screen
+quad lands. While a trace is armed it costs one predictable compare; it gives
+each traced pass a draw count and the name of the first material drawn into it,
+which is what turns "#3 swapchain LOAD/STORE" into "#3 draws nothing" and names
+"#5 postprocess/smaa_edge". Interaction, prepass and shadow-caster draws do not
+funnel through here and are deliberately not counted -- the scene pass is
+already named by its target, and the count is there to find EMPTY passes.
+====================
+*/
+static void VK_GpuTrace_NoteDraw( const char *material ) {
+	if ( vkGpuTrace.state != VKGPUTRACE_ARMED || vkGpuTrace.count <= 0 ) {
+		return;
+	}
+	vkGpuTracePass_t &pass = vkGpuTrace.passes[ vkGpuTrace.count - 1 ];
+	pass.stageDraws++;
+	if ( pass.material == NULL ) {
+		pass.material = material;
+	}
+}
+
+/*
+====================
+VK_GpuTrace_Print
+
+One line per pass, and one closing line saying which mode the cvar went back
+to. Deltas are attached only where a timestamp marker actually fell between two
+passes; when the results were not ready (or the GPU measured nothing, which is
+what the simulator does) the trace is printed anyway and says it has no deltas.
+====================
+*/
+static void VK_GpuTrace_Print( const uint64_t *values, int count, bool haveValues ) {
+	bool anyDelta = false;
+	if ( haveValues ) {
+		for ( int i = 0; i + 1 < count; i++ ) {
+			if ( ( values[ i + 1 ] & vkGpuTimes.validMask ) != ( values[ i ] & vkGpuTimes.validMask ) ) {
+				anyDelta = true;
+				break;
+			}
+		}
+	}
+	common->Printf( "vk pass trace: one frame, %d render pass(es), %d timestamp marker(s)%s\n",
+			vkGpuTrace.count + vkGpuTrace.dropped, count,
+			vkGpuTrace.dropped > 0 ? " (trace buffer full, tail dropped)" : "" );
+	if ( !haveValues ) {
+		common->Printf( "vk pass trace: no GPU deltas (timestamp results were not ready)\n" );
+	} else if ( !anyDelta ) {
+		common->Printf( "vk pass trace: no GPU deltas (timestamps inert: every marker read the same value)\n" );
+	}
+	double attributed = 0.0;
+	int truncated = 0;
+	for ( int i = 0; i < vkGpuTrace.count; i++ ) {
+		const vkGpuTracePass_t &pass = vkGpuTrace.passes[ i ];
+		char gpu[ 48 ];
+		gpu[ 0 ] = '\0';
+		if ( anyDelta ) {
+			if ( pass.beginMarker < 0 || pass.beginMarker + 1 >= count ) {
+				truncated++;
+				idStr::Copynz( gpu, " gpu=n/a", sizeof( gpu ) );
+			} else {
+				const uint64_t begin = values[ pass.beginMarker ] & vkGpuTimes.validMask;
+				const uint64_t end = values[ pass.beginMarker + 1 ] & vkGpuTimes.validMask;
+				const double ms = end >= begin
+						? (double)( end - begin ) * vkGpuTimes.periodNs / 1000000.0 : 0.0;
+				attributed += ms;
+				idStr::snPrintf( gpu, sizeof( gpu ), " gpu=%.3fms", ms );
+			}
+		}
+		char samples[ 16 ];
+		if ( pass.samples > 0 ) {
+			idStr::snPrintf( samples, sizeof( samples ), "%u", pass.samples );
+		} else {
+			idStr::Copynz( samples, "?", sizeof( samples ) );
+		}
+		char draws[ 128 ];
+		if ( pass.stageDraws > 0 ) {
+			idStr::snPrintf( draws, sizeof( draws ), " draws=%d mat=%s", pass.stageDraws,
+					pass.material != NULL ? pass.material : "?" );
+		} else {
+			idStr::Copynz( draws, " draws=0", sizeof( draws ) );
+		}
+		common->Printf( "vk pass trace: #%d %s stage=%s after=%s target=%s %ux%u samples=%s "
+				"color=%s/%s depth=%s/%s stencil=%s%s%s\n",
+				i + 1, pass.site, pass.stage, pass.after, pass.target,
+				pass.width, pass.height, samples,
+				pass.hasColor ? VK_GpuTrace_LoadOpName( pass.colorLoad ) : "none",
+				pass.hasColor ? VK_GpuTrace_StoreOpName( pass.colorStore ) : "none",
+				pass.hasDepth ? VK_GpuTrace_LoadOpName( pass.depthLoad ) : "none",
+				pass.hasDepth ? VK_GpuTrace_StoreOpName( pass.depthStore ) : "none",
+				pass.hasStencil ? "yes" : "no", draws, gpu );
+	}
+	common->Printf( "vk pass trace: swapchain frame-end fallback fired %d time(s) since launch\n",
+			vkGpuTimes.swapchainFallbacks );
+	if ( anyDelta && count >= 2 ) {
+		const uint64_t first = values[ 0 ] & vkGpuTimes.validMask;
+		const uint64_t last = values[ count - 1 ] & vkGpuTimes.validMask;
+		const double total = last >= first
+				? (double)( last - first ) * vkGpuTimes.periodNs / 1000000.0 : 0.0;
+		common->Printf( "vk pass trace: frame total %.3fms, passes %.3fms, unattributed %.3fms "
+				"(work between passes: copies, resolves, barriers)%s\n",
+				total, attributed, total - attributed,
+				truncated > 0 ? " -- truncated: some passes had no query left" : "" );
+	} else if ( truncated > 0 ) {
+		common->Printf( "vk pass trace: truncated -- %d pass(es) had no query left\n", truncated );
+	}
+	vkGpuTrace.state = VKGPUTRACE_IDLE;
+	vkGpuTrace.count = 0;
+	vkGpuTrace.dropped = 0;
+	r_vkGpuTimes.SetInteger( vkGpuTrace.prevMode );
+	common->Printf( "vk pass trace: end of trace; r_vkGpuTimes back to %d\n", vkGpuTrace.prevMode );
+}
+
+/*
+====================
+VK_GpuTimes_CountRendering
+
+Called immediately before every vkCmdBeginRendering, naming the site that opens
+it. A stencil attachment that aliases the depth attachment (the main scope's
+shared depth/stencil view) is one attachment and is counted once.
+====================
+*/
+void VK_GpuTimes_CountRendering( const VkRenderingInfo *renderingInfo, const char *site ) {
+	if ( !vkGpuTimes.active || renderingInfo == NULL ) {
+		return;
+	}
+	if ( vkGpuTrace.state == VKGPUTRACE_ARMED ) {
+		// Every vkCmdBeginRendering is a real Metal encoder boundary, so a
+		// timestamp written immediately before one is honest on MoltenVK (the
+		// reason mode 2 has to manufacture boundaries does not apply here).
+		// The write happens outside any rendering scope by construction: this
+		// is called immediately before the pass is begun.
+		int beginMarker = -1;
+		VkCommandBuffer cmd = VK_Exec_ActiveCmd();
+		if ( cmd != VK_NULL_HANDLE ) {
+			beginMarker = VK_GpuTimes_Write( cmd, vkGpuTimes.lastStage );
+		}
+		VK_GpuTrace_Record( renderingInfo, site, beginMarker );
+	}
+	vkGpuTimes.framePasses++;
+	for ( uint32_t i = 0; i < renderingInfo->colorAttachmentCount; i++ ) {
+		const VkRenderingAttachmentInfo *attachment = &renderingInfo->pColorAttachments[ i ];
+		if ( attachment->imageView != VK_NULL_HANDLE
+				&& attachment->loadOp == VK_ATTACHMENT_LOAD_OP_LOAD ) {
+			vkGpuTimes.frameLoads++;
+		}
+	}
+	const VkRenderingAttachmentInfo *depthStencil[ 2 ] = {
+		renderingInfo->pDepthAttachment,
+		renderingInfo->pStencilAttachment != renderingInfo->pDepthAttachment
+			? renderingInfo->pStencilAttachment : NULL
+	};
+	for ( int i = 0; i < 2; i++ ) {
+		const VkRenderingAttachmentInfo *attachment = depthStencil[ i ];
+		if ( attachment == NULL || attachment->imageView == VK_NULL_HANDLE ) {
+			continue;
+		}
+		if ( attachment->loadOp == VK_ATTACHMENT_LOAD_OP_LOAD ) {
+			vkGpuTimes.frameLoads++;
+		}
+		if ( attachment->storeOp == VK_ATTACHMENT_STORE_OP_STORE ) {
+			vkGpuTimes.frameDepthStores++;
+		}
+	}
+}
+
+/*
+====================
+VK_GpuTimes_Collect
+
+Reads the results of the frame that last used this slot. The caller has just
+waited on that slot's fence, so the results are complete; VK_QUERY_RESULT_WAIT
+is deliberately absent so that an unexpected not-ready never turns the
+instrument into a stall.
+====================
+*/
+static void VK_GpuTimes_CollectSlot( int slot, uint64_t *values, int *outCount, bool *outHaveValues ) {
+	*outCount = 0;
+	*outHaveValues = false;
+	if ( !vkGpuTimes.submitted[ slot ] ) {
+		return;
+	}
+	vkGpuTimes.submitted[ slot ] = false;
+
+	// the pass shape is CPU-side and always valid, timestamps or not
+	vkGpuTimes.windowFrames++;
+	vkGpuTimes.sumPasses += vkGpuTimes.passes[ slot ];
+	vkGpuTimes.sumLoads += vkGpuTimes.loads[ slot ];
+	vkGpuTimes.sumStores += vkGpuTimes.depthStores[ slot ];
+	vkGpuTimes.sumCaptures += vkGpuTimes.captures[ slot ];
+	if ( vkGpuTimes.passes[ slot ] > vkGpuTimes.maxPasses ) {
+		vkGpuTimes.maxPasses = vkGpuTimes.passes[ slot ];
+	}
+	if ( vkGpuTimes.loads[ slot ] > vkGpuTimes.maxLoads ) {
+		vkGpuTimes.maxLoads = vkGpuTimes.loads[ slot ];
+	}
+	if ( vkGpuTimes.depthStores[ slot ] > vkGpuTimes.maxStores ) {
+		vkGpuTimes.maxStores = vkGpuTimes.depthStores[ slot ];
+	}
+
+	const int count = vkGpuTimes.count[ slot ];
+	*outCount = count;
+	if ( !vkGpuTimes.supported || count < 2 || vkGpuTimes.pools[ slot ] == VK_NULL_HANDLE ) {
+		return;
+	}
+	const VkResult res = vkGetQueryPoolResults( vkCtx.device, vkGpuTimes.pools[ slot ], 0,
+			(uint32_t)count, sizeof( values[ 0 ] ) * (size_t)count, values,
+			sizeof( values[ 0 ] ), VK_QUERY_RESULT_64_BIT );
+	if ( res != VK_SUCCESS ) {
+		return;		// VK_NOT_READY: skip this frame's sample, never wait
+	}
+	*outHaveValues = true;
+
+	// One-time proof that the query path itself round-tripped, whatever the
+	// numbers turn out to mean.
+	static bool loggedFirstWindow = false;
+	if ( !loggedFirstWindow ) {
+		loggedFirstWindow = true;
+		common->Printf( "Vulkan: first GPU timestamp window: %d queries, first %llu, last %llu\n",
+				count, (unsigned long long)( values[ 0 ] & vkGpuTimes.validMask ),
+				(unsigned long long)( values[ count - 1 ] & vkGpuTimes.validMask ) );
+	}
+
+	double frameTotal = 0.0;
+	for ( int i = 0; i + 1 < count; i++ ) {
+		const uint64_t begin = values[ i ] & vkGpuTimes.validMask;
+		const uint64_t end = values[ i + 1 ] & vkGpuTimes.validMask;
+		if ( end < begin ) {
+			continue;	// counter wrap inside the valid bits
+		}
+		const double ms = (double)( end - begin ) * vkGpuTimes.periodNs / 1000000.0;
+		const int stage = vkGpuTimes.stageOf[ slot ][ i ];
+		if ( stage >= 0 && stage < VKGPU_STAGE_COUNT ) {
+			vkGpuTimes.stageTotal[ stage ] += ms;
+		}
+		frameTotal += ms;
+	}
+	// An implementation can advertise timestamp support and still measure
+	// nothing: the iOS simulator's Metal advertises period 1.0 with 64 valid
+	// bits and then returns the same value for every query in the frame. A
+	// frame whose every segment is exactly zero is not a frame that cost the
+	// GPU no time, so it is counted apart and reported as inert rather than
+	// printed as a measurement of zero.
+	if ( frameTotal <= 0.0 ) {
+		vkGpuTimes.inertSamples++;
+		return;
+	}
+	vkGpuTimes.total += frameTotal;
+	if ( frameTotal > vkGpuTimes.totalMax ) {
+		vkGpuTimes.totalMax = frameTotal;
+	}
+	vkGpuTimes.windowSamples++;
+}
+
+/*
+====================
+VK_GpuTimes_Collect
+
+The sampling above, plus the one-shot pass trace: a trace is printed when the
+frame that recorded it is the frame whose fence has just retired, so the
+timestamp deltas printed beside the passes are that same frame's.
+====================
+*/
+static void VK_GpuTimes_Collect( int slot ) {
+	uint64_t values[ VK_GPU_MAX_QUERIES ];
+	int count = 0;
+	bool haveValues = false;
+	VK_GpuTimes_CollectSlot( slot, values, &count, &haveValues );
+	if ( vkGpuTrace.state == VKGPUTRACE_RECORDED && vkGpuTrace.slot == slot ) {
+		VK_GpuTrace_Print( values, count, haveValues );
+	}
+}
+
+static void VK_GpuTimes_ResetWindow( void );
+
+// called from VK_GuiExecutor_BeginFrame once the frame's command buffer is
+// recording and before any rendering scope is open (vkCmdResetQueryPool is not
+// legal inside one)
+static void VK_GpuTimes_BeginFrame( VkCommandBuffer cmd, int slot ) {
+	vkGpuTimes.active = false;
+	if ( !VK_GpuTimes_Enabled() ) {
+		return;
+	}
+	VK_GpuTimes_CheckSupport();
+	const int previousMode = vkGpuTimes.windowMode;
+	vkGpuTimes.mode = r_vkGpuTimes.GetInteger();
+	if ( vkGpuTimes.mode == 3 && vkGpuTrace.state != VKGPUTRACE_RECORDED ) {
+		// arm (or re-arm, if the armed frame never reached a submit) the
+		// one-shot trace; the mode it returns to is whatever was running
+		// before mode 3 was asked for
+		if ( previousMode != 3 ) {
+			vkGpuTrace.prevMode = ( previousMode == 1 || previousMode == 2 ) ? previousMode : 0;
+		}
+		vkGpuTrace.state = VKGPUTRACE_ARMED;
+		vkGpuTrace.slot = slot;
+		vkGpuTrace.count = 0;
+		vkGpuTrace.dropped = 0;
+		vkGpuTrace.pendingReason = "frame-open";
+	}
+	if ( vkGpuTimes.mode != vkGpuTimes.windowMode ) {
+		// mode 1 and mode 2 measure different frames; never average them
+		VK_GpuTimes_ResetWindow();
+		vkGpuTimes.windowMode = vkGpuTimes.mode;
+	}
+	vkGpuTimes.slot = slot;
+	vkGpuTimes.active = true;
+	vkGpuTimes.count[ slot ] = 0;
+	vkGpuTimes.submitted[ slot ] = false;
+	vkGpuTimes.framePasses = 0;
+	vkGpuTimes.frameLoads = 0;
+	vkGpuTimes.frameDepthStores = 0;
+	vkGpuTimes.frameCaptures = 0;
+	vkGpuTimes.lastStage = VKGPU_MAIN;
+	if ( !vkGpuTimes.supported || vkGpuTimes.pools[ slot ] == VK_NULL_HANDLE ) {
+		return;
+	}
+	vkCmdResetQueryPool( cmd, vkGpuTimes.pools[ slot ], 0, VK_GPU_MAX_QUERIES );
+	// a real boundary: the main scope has not been opened yet
+	VK_GpuTimes_Write( cmd, VKGPU_MAIN );
+}
+
+// called from VK_GuiExecutor_SubmitFrame with the command buffer still
+// recording; the final timestamp closes the last segment
+static void VK_GpuTimes_EndFrame( VkCommandBuffer cmd ) {
+	if ( !vkGpuTimes.active ) {
+		return;
+	}
+	const int slot = vkGpuTimes.slot;
+	if ( vkGpuTimes.supported && cmd != VK_NULL_HANDLE
+			&& vkGpuTimes.pools[ slot ] != VK_NULL_HANDLE ) {
+		// the caller has already ended the main scope: a real boundary
+		VK_GpuTimes_Write( cmd, VKGPU_MAIN );
+	}
+	vkGpuTimes.passes[ slot ] = vkGpuTimes.framePasses;
+	vkGpuTimes.loads[ slot ] = vkGpuTimes.frameLoads;
+	vkGpuTimes.depthStores[ slot ] = vkGpuTimes.frameDepthStores;
+	vkGpuTimes.captures[ slot ] = vkGpuTimes.frameCaptures;
+}
+
+// the frame's queries are only readable once its submit actually happened
+static void VK_GpuTimes_NoteSubmitted( void ) {
+	if ( vkGpuTimes.active ) {
+		vkGpuTimes.submitted[ vkGpuTimes.slot ] = true;
+		if ( vkGpuTrace.state == VKGPUTRACE_ARMED && vkGpuTrace.slot == vkGpuTimes.slot ) {
+			vkGpuTrace.state = VKGPUTRACE_RECORDED;
+		}
+	}
+}
+
+static void VK_GpuTimes_ResetWindow( void ) {
+	vkGpuTimes.windowFrames = 0;
+	vkGpuTimes.windowSamples = 0;
+	vkGpuTimes.inertSamples = 0;
+	memset( vkGpuTimes.stageTotal, 0, sizeof( vkGpuTimes.stageTotal ) );
+	vkGpuTimes.total = 0.0;
+	vkGpuTimes.totalMax = 0.0;
+	vkGpuTimes.sumPasses = vkGpuTimes.maxPasses = 0;
+	vkGpuTimes.sumLoads = vkGpuTimes.maxLoads = 0;
+	vkGpuTimes.sumStores = vkGpuTimes.maxStores = 0;
+	vkGpuTimes.sumCaptures = 0;
+}
+
+static void VK_GpuTimes_Report( void ) {
+	if ( vkGpuTimes.windowFrames <= 0 ) {
+		return;
+	}
+	const double frames = (double)vkGpuTimes.windowFrames;
+	char timings[ 320 ];
+	timings[ 0 ] = '\0';
+	if ( vkGpuTimes.windowSamples > 0 ) {
+		const double n = (double)vkGpuTimes.windowSamples;
+		if ( vkGpuTimes.windowMode >= 2 ) {
+			// split mode: every stage had a real boundary made for it, and the
+			// frame paid a tile store + reload for each one
+			idStr::snPrintf( timings, sizeof( timings ),
+					"total %.2f/%.2f ms (SPLIT: frame perturbed) | main %.2f prepass %.2f "
+					"shadowmap %.2f lights %.2f ambient %.2f capture %.2f(x%.1f) post %.2f gui %.2f | ",
+					vkGpuTimes.total / n, vkGpuTimes.totalMax,
+					vkGpuTimes.stageTotal[ VKGPU_MAIN ] / n,
+					vkGpuTimes.stageTotal[ VKGPU_PREPASS ] / n,
+					vkGpuTimes.stageTotal[ VKGPU_SHADOWMAP ] / n,
+					vkGpuTimes.stageTotal[ VKGPU_LIGHTS ] / n,
+					vkGpuTimes.stageTotal[ VKGPU_AMBIENT ] / n,
+					vkGpuTimes.stageTotal[ VKGPU_CAPTURE ] / n,
+					(double)vkGpuTimes.sumCaptures / frames,
+					vkGpuTimes.stageTotal[ VKGPU_POST ] / n,
+					vkGpuTimes.stageTotal[ VKGPU_GUI ] / n );
+		} else {
+			// honest mode: only the boundaries the backend makes for itself
+			idStr::snPrintf( timings, sizeof( timings ),
+					"total %.2f/%.2f ms | main %.2f shadowmap %.2f capture %.2f(x%.1f) | ",
+					vkGpuTimes.total / n, vkGpuTimes.totalMax,
+					vkGpuTimes.stageTotal[ VKGPU_MAIN ] / n,
+					vkGpuTimes.stageTotal[ VKGPU_SHADOWMAP ] / n,
+					vkGpuTimes.stageTotal[ VKGPU_CAPTURE ] / n,
+					(double)vkGpuTimes.sumCaptures / frames );
+		}
+	} else if ( vkGpuTimes.inertSamples > 0 ) {
+		idStr::snPrintf( timings, sizeof( timings ),
+				"timestamps inert (every segment measured 0 in %d frames) | ",
+				vkGpuTimes.inertSamples );
+	} else {
+		idStr::snPrintf( timings, sizeof( timings ), "timestamps unavailable | " );
+	}
+	common->Printf( "vk gpu: mode=%d n=%d/%d %spasses %.1f/%d loads %.1f/%d depthStores %.1f/%d (avg/max) "
+			"fallback=%d\n",
+			vkGpuTimes.windowMode, vkGpuTimes.windowSamples, vkGpuTimes.windowFrames, timings,
+			(double)vkGpuTimes.sumPasses / frames, vkGpuTimes.maxPasses,
+			(double)vkGpuTimes.sumLoads / frames, vkGpuTimes.maxLoads,
+			(double)vkGpuTimes.sumStores / frames, vkGpuTimes.maxStores,
+			vkGpuTimes.swapchainFallbacks );
+}
+
+static void VK_GpuTimes_Shutdown( void ) {
+	for ( int i = 0; i < VK_FRAMES_IN_FLIGHT; i++ ) {
+		if ( vkGpuTimes.pools[ i ] != VK_NULL_HANDLE ) {
+			vkDestroyQueryPool( vkCtx.device, vkGpuTimes.pools[ i ], NULL );
+			vkGpuTimes.pools[ i ] = VK_NULL_HANDLE;
+		}
+	}
+	memset( &vkGpuTimes, 0, sizeof( vkGpuTimes ) );
+	memset( &vkGpuTrace, 0, sizeof( vkGpuTrace ) );
+}
+
+/*
+====================
+Feedback-capture accounting
+
+`_currentRender` / `_currentDepth` feedback is captured lazily, and every one
+of the eleven ways the copy can decline returns a bare false. The one-time
+warning that follows ("post-process surfaces skipped because feedback capture
+failed") therefore says a capture failed once, and nothing at all about whether
+it keeps failing -- yet the difference matters: a single hiccup costs one
+frame's heat haze, while a permanent refusal means every post-process surface
+in the game is silently missing for the life of the process.
+
+So count the attempts and the failures, remember why the last one failed, and
+drain both onto the r_vkSpeeds report line. The reason travels in two steps:
+VK_Exec_CopyRender records into copyReason (it is also called by the explicit
+CopyRender backend command, which is not a feedback capture and must not
+disturb the reported reason), and the two capture wrappers promote that to
+lastReason at the moment they fail. The warning names the reason too.
+====================
+*/
+typedef enum {
+	VKFB_NONE,
+	VKFB_FRAME_OPEN,
+	VKFB_NULL_IMAGE,
+	VKFB_NO_VIEW,
+	VKFB_RECT_EMPTY,
+	VKFB_COLOR_ALIAS,
+	VKFB_DEPTH_ALIAS,
+	VKFB_SOURCE_UNUSABLE,
+	VKFB_SWAPCHAIN_NO_TRANSFER_SRC,
+	VKFB_DEST_ALIAS,
+	VKFB_DEST_PREPARE,
+	VKFB_DEPTH_TARGET,
+	VKFB_DEST_UNUSABLE,
+	VKFB_ROW_ALLOC,
+	VKFB_RESOLVE_SCRATCH,
+	VKFB_REASON_COUNT
+} vkFeedbackReason_t;
+
+static const char *vkFeedbackReasonNames[ VKFB_REASON_COUNT ] = {
+	"none",
+	"frame-open",
+	"null-image",
+	"no-view",
+	"rect-empty",
+	"color-alias",
+	"depth-alias",
+	"source-unusable",
+	"swapchain-no-transfer-src",
+	"dest-alias",
+	"dest-prepare",
+	"depth-target",
+	"dest-unusable",
+	"row-alloc",
+	"resolve-scratch"
+};
+
+static struct {
+	int		attempts;
+	int		failures;
+	int		lastReason;
+	int		copyReason;
+} vkFeedback;
+
+// VK_Exec_CopyRender's declines. Not a failure on its own: the caller decides
+// whether this copy was a feedback capture.
+static bool VK_Feedback_CopyFailed( vkFeedbackReason_t reason ) {
+	vkFeedback.copyReason = (int)reason;
+	return false;
+}
+
+// A capture wrapper's decline. Always a feedback failure.
+static bool VK_Feedback_CaptureFailed( vkFeedbackReason_t reason ) {
+	vkFeedback.failures++;
+	vkFeedback.lastReason = (int)reason;
+	return false;
+}
+
+static const char *VK_Feedback_LastReason( void ) {
+	const int reason = vkFeedback.lastReason;
+	if ( reason <= (int)VKFB_NONE || reason >= (int)VKFB_REASON_COUNT ) {
+		return "none";
+	}
+	return vkFeedbackReasonNames[ reason ];
+}
+
+static void VK_Feedback_TakeCounts( int *attempts, int *failures ) {
+	if ( attempts != NULL ) {
+		*attempts = vkFeedback.attempts;
+	}
+	if ( failures != NULL ) {
+		*failures = vkFeedback.failures;
+	}
+	vkFeedback.attempts = 0;
+	vkFeedback.failures = 0;
+	vkFeedback.lastReason = (int)VKFB_NONE;
+}
+
+static void VK_Speeds_Reset( void ) {
+	const double recordStart = vkSpeeds.recordStartTicks;
+	memset( &vkSpeeds, 0, sizeof( vkSpeeds ) );
+	vkSpeeds.recordStartTicks = recordStart;
+	// Drain the recreate counts with the timers, including when the report is
+	// off: a counter that accumulates while nobody reads it would make the
+	// first report after enabling r_vkSpeeds a lifetime total wearing a
+	// per-window label.
+	VK_Device_TakeRecreateCounts( NULL, NULL, NULL, NULL, NULL );
+	VK_Feedback_TakeCounts( NULL, NULL );
+	VK_GpuTimes_ResetWindow();
+}
+
+/*
+====================
+VK_Speeds_EndBackendFrame
+
+Called once per RB_ExecuteBackEndCommands with that call's wall time. Owns the
+frame counter and the periodic report, so the report exists in exactly one
+place and cannot be emitted twice for one frame.
+====================
+*/
+void VK_Speeds_EndBackendFrame( double executeStartTicks, double executeEndTicks ) {
+	if ( !VK_Speeds_Enabled() && !VK_GpuTimes_Enabled() ) {
+		// Reset unconditionally while the report is off: the counters it
+		// drains (recreates, feedback captures) are written whether anyone is
+		// reading or not, and a lifetime total printed under a per-window
+		// label is worse than no number.
+		VK_Speeds_Reset();
+		return;
+	}
+	VK_Speeds_Add( vkSpeeds.execute, executeStartTicks, executeEndTicks );
+	vkSpeeds.frames++;
+	if ( vkSpeeds.frames < VK_SPEEDS_REPORT_FRAMES ) {
+		return;
+	}
+	const double n = (double)vkSpeeds.frames;
+	// r_vkGpuTimes borrows this cadence, so the window may be reported with
+	// the CPU line switched off
+	const bool printSpeeds = VK_Speeds_Enabled();
+	// Recreates are read (and cleared) before the report prints, so the counts
+	// belong to exactly the frames the timings above cover.
+	int recreates = 0, poll = 0, acquire = 0, present = 0, suppressed = 0;
+	VK_Device_TakeRecreateCounts( &recreates, &poll, &acquire, &present, &suppressed );
+	// Feedback captures: silent when none were attempted in this window, so
+	// the line does not grow a column that reads 0/0 for every frame of a
+	// scene that has no heat haze in it.
+	int fbAttempts = 0, fbFailures = 0;
+	const char *fbReason = VK_Feedback_LastReason();
+	VK_Feedback_TakeCounts( &fbAttempts, &fbFailures );
+	char feedbackText[ 96 ];
+	feedbackText[ 0 ] = '\0';
+	if ( fbAttempts != 0 ) {
+		if ( fbFailures != 0 ) {
+			idStr::snPrintf( feedbackText, sizeof( feedbackText ),
+					" feedback %d/%d fail=%s", fbFailures, fbAttempts, fbReason );
+		} else {
+			idStr::snPrintf( feedbackText, sizeof( feedbackText ),
+					" feedback %d/%d", fbFailures, fbAttempts );
+		}
+	}
+	if ( printSpeeds ) {
+		common->Printf( "vk speeds: n=%d fence %.2f/%.2f acquire %.2f/%.2f record %.2f/%.2f "
+				"submit %.2f/%.2f present %.2f/%.2f execute %.2f/%.2f ms (avg/max) "
+				"recreate %d (poll %d, acquire %d, present %d, suppressed %d)%s\n",
+				vkSpeeds.frames,
+				vkSpeeds.fence.total / n, vkSpeeds.fence.max,
+				vkSpeeds.acquire.total / n, vkSpeeds.acquire.max,
+				vkSpeeds.record.total / n, vkSpeeds.record.max,
+				vkSpeeds.submit.total / n, vkSpeeds.submit.max,
+				vkSpeeds.present.total / n, vkSpeeds.present.max,
+				vkSpeeds.execute.total / n, vkSpeeds.execute.max,
+				recreates, poll, acquire, present, suppressed, feedbackText );
+	}
+	if ( VK_GpuTimes_Enabled() ) {
+		VK_GpuTimes_Report();
+	}
+	VK_Speeds_Reset();
+}
+
+// no module-owned vertex-cache GPU state exists: the engine cache runs
+// CPU-backed under Vulkan and the executor streams into its own rings
+void VK_VertexCache_Shutdown( void ) {
+}
+
+/*
+====================
+Executor state
+====================
+*/
+// world views stream all visible geometry through the rings each frame
+// (the vertex cache is CPU-backed); sized for q4dm2-scale 3D views
+static const int VK_VERTEX_RING_BYTES = 32 * 1024 * 1024;
+static const int VK_INDEX_RING_BYTES = 8 * 1024 * 1024;
+static const int VK_GPU_SKINNING_WORKGROUP_SIZE = 64;
+static const int VK_GPU_SKINNING_MEMO_SIZE = 2048; // power of two
+static const int VK_MAX_GUI_PIPELINES = 64;
+static const int VK_MAX_SCREEN_PIPELINES = 64;
+static const int VK_MAX_CUBE_PIPELINES = 32;
+static const int VK_MAX_ENV_PIPELINES = 32;
+static const int VK_MAX_PROGRAM_PIPELINES = 128;
+static const int VK_MAX_BLEND_LIGHT_PIPELINES = 32;
+static const int VK_MAX_SPECIAL_PIPELINES = 64;
+static const int VK_MAX_TEMPORAL_RESOLVE_PIPELINES = 8;
+static const int VK_MAX_DESCRIPTOR_SETS = 4096;
+// rvspecial_depth.fs linearizes the Raven controller's depth texture with
+// this historical near-plane convention.  The Vulkan path samples raw depth,
+// so it must use the same value after translating normalized focus/range.
