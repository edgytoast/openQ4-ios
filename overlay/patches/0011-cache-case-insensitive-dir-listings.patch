+		}
+		cursor += cmd->cmdsize;
+	}
+	return false;
+}
+
+static bool FS_PakGateCachePath( idStr &out ) {
+	const char *home = getenv( "HOME" );
+	if ( home == NULL || home[ 0 ] == '\0' ) {
+		return false;
+	}
+	out = home;
+	out.AppendPath( "Library" );
+	out.AppendPath( "Caches" );
+	out.AppendPath( "openq4-pakgate.txt" );
+	return true;
+}
+
+static bool FS_PakGateAppendIdentity( idStr &key, const char *name, const char *expectedMD5, const char *path ) {
+	struct stat st;
+	if ( stat( path, &st ) != 0 ) {
+		return false;
+	}
+	key += va( "%s md5=%s size=%lld mtime=%lld.%09ld ino=%llu path=%s\n", name, expectedMD5,
+		(long long)st.st_size, (long long)st.st_mtimespec.tv_sec, (long)st.st_mtimespec.tv_nsec,
+		(unsigned long long)st.st_ino, path );
+	return true;
+}
+
+static bool FS_PakGateCacheMatches( const idStr &key ) {
+	idStr path;
+	if ( !FS_PakGateCachePath( path ) ) {
+		return false;
+	}
+	FILE *f = fopen( path.c_str(), "rb" );
+	if ( f == NULL ) {
+		return false;
+	}
+	char buffer[ 4096 ];
+	const size_t n = fread( buffer, 1, sizeof( buffer ) - 1, f );
+	fclose( f );
+	buffer[ n ] = '\0';
+	return (int)n == key.Length() && idStr::Cmp( buffer, key.c_str() ) == 0;
 }
 
+static void FS_PakGateCacheStore( const idStr &key ) {
+	idStr path;
+	if ( !FS_PakGateCachePath( path ) ) {
+		return;
+	}
+	idStr dir = path;
+	dir.StripFilename();
+	mkdir( dir.c_str(), 0755 );
+	idStr temp = path + ".tmp";
+	FILE *f = fopen( temp.c_str(), "wb" );
+	if ( f == NULL ) {
+		return;
+	}
+	const bool ok = fwrite( key.c_str(), 1, key.Length(), f ) == (size_t)key.Length();
+	if ( fclose( f ) != 0 || !ok || rename( temp.c_str(), path.c_str() ) != 0 ) {
+		unlink( temp.c_str() );
+	}
+}
+
+static void FS_PakGateCacheForget( void ) {
+	idStr path;
+	if ( FS_PakGateCachePath( path ) ) {
+		unlink( path.c_str() );
+	}
+}
