 /*
 ===============
+Session_LoadNewestGame_f
+
+openQ4-ios: the openq4://continue route and the Continue App Intent. Tries the
+savegames newest first — the same list, filter and order the Load menu uses —
+and stops at the first one LoadGame accepts. LoadGame refuses an unloadable
+save (older payload, other wire ABI, missing map, truncated file) before it
+tears down anything, so moving on to the next one is safe. No slot name ever
+passes through a console line.
+===============
+*/
+static void Session_LoadNewestGame_f( const idCmdArgs &args ) {
+	if ( sessLocal.IsMultiplayer() ) {
+		common->Printf( "loadNewestGame: can't load during net play.\n" );
+		return;
+	}
+	// Same module switch LoadGame does, but re-running THIS command after the
+	// reload so the fallback survives it.
+	const char *activeModule = cvarSystem->GetCVarString( "com_activeGameModule" );
+	if ( idStr::Icmp( activeModule, "game_sp" ) != 0 ) {
+		cvarSystem->SetCVarString( "si_gameType", "singleplayer" );
+		cvarSystem->SetCVarString( "com_nextGameModule", "game_sp" );
+		idCmdArgs reloadArgs;
+		reloadArgs.AppendArg( "loadNewestGame" );
+		cmdSystem->SetupReloadGameModule( reloadArgs );
+		return;
+	}
+
+	idStrList fileList;
+	idList<fileTIME_T> fileTimes;
+	sessLocal.GetSaveGameList( fileList, fileTimes );
+	for ( int i = 0; i < fileTimes.Num(); i++ ) {
+		const idStr &slot = fileList[ fileTimes[i].index ];
+		common->Printf( "loadNewestGame: trying '%s' (%d of %d)\n", slot.c_str(), i + 1, fileTimes.Num() );
+		console->Close();
+		if ( sessLocal.LoadGame( slot.c_str() ) ) {
+			return;
+		}
+	}
+	common->Printf( "loadNewestGame: no loadable savegame (%d listed) - staying put\n", fileTimes.Num() );
+}
+
+/*
+===============
+Session_iOS_ProbeSaveGame
+
+openQ4-ios (D-114). Answers "can this build load that save, and if not, why"
+WITHOUT loading it, logging over it or needing the game module: the Load Game
+list marks old saves with it, and the menu asks it before a load so a save
+that will be refused never costs a game-module swap first (Arena -> Load Game
+used to reload the whole engine only to be refused and dropped at the menu).
+
+It reads exactly what LoadGame's preflight reads — the header, the persistent
+player info, the payload stamp — and applies the same gates in the same order
+(Session_ValidateSaveGamePayload), minus the integrity checksum: a save that
+passes here and fails the checksum is still refused by LoadGame and then
+reported as damaged. Verdicts:
+  0 loadable, 1 made by an older openQ4 (v2 payload, below the build floor, or
+  no openQ4 stamp at all), 2 made for another platform/ABI, 3 its map is not
+  installed, 4 unreadable/damaged.
+The map, entity filter and player 0's persistent info (inventory at save time)
+are returned for the restart rescue below; they sit in the header BEFORE the
+payload, in a format (strings and a key/value dict) that did not change with
+the payload version.
+===============
+*/
+int Session_iOS_ProbeSaveGame( const char *slotName, idStr *mapOut, idStr *entityFilterOut, idDict *playerInfoOut ) {
+	if ( mapOut != NULL ) { mapOut->Clear(); }
+	if ( entityFilterOut != NULL ) { entityFilterOut->Clear(); }
+	if ( playerInfoOut != NULL ) { playerInfoOut->Clear(); }
+
+	idStr slot = ( slotName != NULL ) ? slotName : "";
+	sessLocal.ScrubSaveGameFileName( slot );
+	if ( slot.IsEmpty() ) {
+		return 4;
+	}
+	slot.SetFileExtension( ".save" );
+	idStr path = "savegames/";
+	path += slot;
+
+	idStr game = cvarSystem->GetCVarString( "fs_game" );
+	idFile *file = fileSystem->OpenFileRead( path, true, game.Length() ? game.c_str() : NULL );
+	if ( file == NULL ) {
+		return 4;
+	}
+	int fileLength = -1;
+	if ( !Session_GetBoundedSaveGameLength( file, path, "load probe", fileLength ) ) {
+		fileSystem->CloseFile( file );
+		return 4;
+	}
+
+	idStr gamename, saveMap, entityFilter;
+	int version = 0;
+	idDict playerInfo;
+	bool valid = Session_ReadSaveGameString( file, gamename, MAX_STRING_CHARS, "game name", path.c_str() )
+		&& Session_IsSupportedSaveGameName( gamename )
+		&& Session_ReadSaveGameInt( file, version, "version", path.c_str() );
+	if ( valid && !Session_IsCompatibleSaveGameVersion( version ) ) {
+		fileSystem->CloseFile( file );
+		return 1;
+	}
+	valid = valid && Session_ReadSaveGameString( file, saveMap, MAX_STRING_CHARS, "map name", path.c_str() );
+	if ( valid && Session_SaveGameHeaderUsesEntityFilter( gamename ) ) {
+		valid = Session_ReadSaveGameString( file, entityFilter, MAX_STRING_CHARS, "entity filter", path.c_str() );
+	}
+	for ( int i = 0; valid && i < MAX_ASYNC_CLIENTS; i++ ) {
+		idDict info;
+		valid = Session_ReadSaveGameDict( file, info, va( "persistent player info %d", i ), path.c_str() );
+		if ( valid && i == 0 ) {
+			playerInfo = info;
+		}
+	}
+	if ( !valid || saveMap.IsEmpty() ) {
+		fileSystem->CloseFile( file );
+		return 4;
+	}
+
+	idStr normalizedMap, normalizedFilter;
+	Session_NormalizeMapPathAndEntityFilter( saveMap.c_str(), entityFilter.c_str(), normalizedMap, normalizedFilter );
+	if ( !Session_IsSafeNormalizedMapPath( normalizedMap ) ) {
+		fileSystem->CloseFile( file );
+		return 4;
+	}
+	if ( mapOut != NULL ) { *mapOut = normalizedMap; }
+	if ( entityFilterOut != NULL ) { *entityFilterOut = normalizedFilter; }
+	if ( playerInfoOut != NULL ) { *playerInfoOut = playerInfo; }
+
+	// The payload stamp, as Session_ValidateSaveGamePayload reads it.
+	int verdict = 0;
+	int marker = 0, payloadVersion = 0, payloadBuild = 0, payloadFileCount = 0;
+	idStr payloadStamp, payloadABI;
+	if ( !Session_ReadSaveGameInt( file, marker, "payload marker", path.c_str() ) ) {
+		verdict = 4;
+	} else if ( marker != SESSION_OPENQ4_SAVEGAME_COMPATIBILITY_MAGIC ) {
+		// Retail or pre-stamp openQ4 payload. LoadGame's legacy branch accepts
+		// one only from the Windows MSVC ABI, which no Apple build is.
+		verdict = 1;
+	} else if ( !Session_ReadSaveGameInt( file, payloadVersion, "payload version", path.c_str() )
+			|| !Session_ReadSaveGameInt( file, payloadBuild, "payload build", path.c_str() )
+			|| !Session_ReadSaveGameString( file, payloadStamp, SESSION_OPENQ4_SAVEGAME_SOURCE_STAMP_MAX_BYTES, "payload source stamp", path.c_str() )
+			|| !Session_ReadSaveGameInt( file, payloadFileCount, "payload source file count", path.c_str() ) ) {
+		verdict = 4;
+	} else if ( payloadVersion < SESSION_OPENQ4_SAVEGAME_COMPATIBILITY_VERSION ) {
+		verdict = 1;
+	} else if ( payloadVersion != SESSION_OPENQ4_SAVEGAME_COMPATIBILITY_VERSION ) {
+		verdict = 4;
+	} else if ( !Session_ReadSaveGameString( file, payloadABI, SESSION_OPENQ4_SAVEGAME_ABI_STAMP_MAX_BYTES, "payload wire ABI", path.c_str() ) ) {
+		verdict = 4;
+	} else if ( payloadABI.Icmp( Session_GetSaveGameWireABI() ) != 0 ) {
+		verdict = 2;
+	} else if ( payloadBuild < SESSION_OPENQ4_SAVEGAME_MINIMUM_SUPPORTED_BUILD ) {
+		verdict = 1;
+	} else if ( !Session_SaveGameMapExists( normalizedMap, normalizedFilter ) ) {
+		verdict = 3;
+	}
+	fileSystem->CloseFile( file );
+	return verdict;
+}
+
+/*
+===============
+Session_iOS_ExplainLoadRefusal / restartLevelFromSave
+
+D-114. Tell the player, in the UI and in his language, why a save did not load
+(the strings live with the shell's other localised text: OpenQ4_iOS_SaveText,
+openq4_ios_loc.m). For a save from an older openQ4 — every save made before the
+v0.13.2 pin bump, whose payload upstream no longer decodes — offer the one
+rescue the header still allows: start that save's level again from its
+beginning, carrying the inventory recorded in the save (the same persistent
+player info a level transition carries), which also writes a fresh autosave in
+the current format.
+===============
+*/
+extern "C" const char *OpenQ4_iOS_SaveText( int which );
+static idStr session_iosRescueSlot;
+
+static idStr Session_iOS_MapTitle( const idStr &normalizedMap ) {
+	idDict mapDecl;
+	if ( Session_GetMapDeclDictForNormalizedPath( normalizedMap, mapDecl ) ) {
+		const char *name = mapDecl.GetString( "name", "" );
+		if ( name[0] != '\0' ) {
+			idStr title = common->GetLanguageDict()->GetString( name );
+			title.RemoveColors();
+			if ( title.Length() > 0 ) {
+				return title;
+			}
+		}
+	}
+	idStr title = normalizedMap;
+	title.StripPath();
+	title.StripFileExtension();
+	return title;
+}
+
+// The save's own file (fs_game first, as LoadGame opens it). Empty / unsafe
+// names have no file.
+static bool Session_iOS_SaveFileExists( const char *slotName ) {
+	idStr slot = ( slotName != NULL ) ? slotName : "";
+	sessLocal.ScrubSaveGameFileName( slot );
+	if ( slot.IsEmpty() ) {
+		return false;
+	}
+	slot.SetFileExtension( ".save" );
+	idStr game = cvarSystem->GetCVarString( "fs_game" );
+	idFile *file = fileSystem->OpenFileRead( va( "savegames/%s", slot.c_str() ), true, game.Length() ? game.c_str() : NULL );
+	if ( file == NULL ) {
+		return false;
+	}
+	fileSystem->CloseFile( file );
+	return true;
+}
