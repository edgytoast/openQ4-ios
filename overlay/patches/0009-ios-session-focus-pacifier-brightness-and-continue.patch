+void Session_iOS_ExplainLoadRefusal( const char *slotName ) {
+	// Not every refusal is about the save. LoadGame also says no during net
+	// play and for a slot with no file (a quickload before any quicksave);
+	// neither is "damaged", so neither gets the box — LoadGame already printed
+	// the accurate console line.
+	if ( sessLocal.IsMultiplayer() ) {
+		common->Printf( "loadGame: refused during net play - not a save problem, no dialog\n" );
+		return;
+	}
+	if ( !Session_iOS_SaveFileExists( slotName ) ) {
+		common->Printf( "loadGame: no save file for '%s' - nothing to explain, no dialog\n", slotName ? slotName : "" );
+		return;
+	}
+
+	idStr map, filter;
+	int verdict = Session_iOS_ProbeSaveGame( slotName, &map, &filter, NULL );
+	if ( verdict == 0 ) {
+		// The probe passed but LoadGame did not (checksum, interrupted files):
+		// damaged is the honest name for every such reason.
+		verdict = 4;
+	}
+	common->Printf( "loadGame: '%s' was refused (reason %d) - telling the player\n", slotName ? slotName : "", verdict );
+
+	Session_iOS_MenuUnderSaveBox();
+
+	const char *title = OpenQ4_iOS_SaveText( 1 );
+	if ( verdict == 1 && map.Length() > 0 ) {
+		session_iosRescueSlot = slotName;
+		const idStr mapTitle = Session_iOS_MapTitle( map );
+		idStr body = va( OpenQ4_iOS_SaveText( 2 ), mapTitle.c_str() );
+		sessLocal.MessageBox( MSG_YESNO, body.c_str(), title, false, "exec restartLevelFromSave", "" );
+		return;
+	}
+	session_iosRescueSlot.Clear();
+	const int which = ( verdict == 1 ) ? 6 : ( verdict == 2 ) ? 3 : ( verdict == 3 ) ? 4 : 5;
+	sessLocal.MessageBox( MSG_OK, OpenQ4_iOS_SaveText( which ), title, false );
+}
