+/*
+Session_iOS_KeepAutosaveCopy — the restart below ends in StartNewGame's level-
+start autosave, which goes to the level's one autosave slot ("Autosave <map>
+[<filter>]", Session_GenerateSaveFileName) and replaces whatever is there: the
+old save being rescued if it IS that autosave, or a newer good autosave of the
+same level. The dialog says so, and this keeps the slot's current contents
+first, as "<autosave> (before restart)" — a new slot (never an existing one;
+2..9 are tried), whose description names it in the player's language so it
+reads as a distinct row in Load Game ("Before restart"). Returns false only when an autosave
+exists and could not be copied; the caller then does not restart.
+*/
+static bool Session_iOS_ReadSaveSlotFile( const idStr &path, idList<byte> &bytes ) {
+	idStr game = cvarSystem->GetCVarString( "fs_game" );
+	idFile *file = fileSystem->OpenFileRead( path.c_str(), true, game.Length() ? game.c_str() : NULL );
+	if ( file == NULL ) {
+		return false;
+	}
+	const int len = file->Length();
+	bool ok = len >= 0;
+	if ( ok ) {
+		bytes.SetNum( len );
+		ok = len == 0 || file->Read( bytes.Ptr(), len ) == len;
+	}
+	fileSystem->CloseFile( file );
+	return ok;
+}
+
+static bool Session_iOS_WriteSaveSlotFile( const idStr &path, const void *data, int len ) {
+	idFile *file = fileSystem->OpenFileWrite( path.c_str() );
+	if ( file == NULL ) {
+		common->Warning( "restartLevelFromSave: cannot open '%s' for writing", path.c_str() );
+		return false;
+	}
+	bool ok = len == 0 || file->Write( data, len ) == len;
+	ok = ok && file->Sync();
+	fileSystem->CloseFile( file );
+	if ( !ok ) {
+		common->Warning( "restartLevelFromSave: short write to '%s'", path.c_str() );
+		fileSystem->RemoveFile( path.c_str() );
+	}
+	return ok;
+}
+
+static bool Session_iOS_KeepAutosaveCopy( const idStr &map, const idStr &filter ) {
+	idStr autosaveName = filter.Length() ? va( "Autosave %s %s", map.c_str(), filter.c_str() ) : va( "Autosave %s", map.c_str() );
+	idStr autosaveSlot = autosaveName;
+	sessLocal.ScrubSaveGameFileName( autosaveSlot );
+	if ( !Session_iOS_SaveFileExists( autosaveSlot.c_str() ) ) {
+		common->Printf( "restartLevelFromSave: no autosave '%s' yet - nothing to keep\n", autosaveSlot.c_str() );
+		return true;
+	}
+
+	idStr copyName, copySlot;
+	for ( int n = 1; n <= 9; n++ ) {
+		copyName = autosaveName + ( n == 1 ? " (before restart)" : va( " (before restart %d)", n ) );
+		copySlot = copyName;
+		sessLocal.ScrubSaveGameFileName( copySlot );
+		if ( !Session_iOS_SaveFileExists( copySlot.c_str() ) ) {
+			break;
+		}
+		copySlot.Clear();
+	}
+	if ( copySlot.IsEmpty() ) {
+		common->Warning( "restartLevelFromSave: nine copies of '%s' already kept - not overwriting any", autosaveSlot.c_str() );
+		return false;
+	}
+
+	const idStr from = va( "savegames/%s", autosaveSlot.c_str() );
+	const idStr to = va( "savegames/%s", copySlot.c_str() );
+	idList<byte> bytes;
+	if ( !Session_iOS_ReadSaveSlotFile( from + ".save", bytes ) || bytes.Num() == 0 ) {
+		common->Warning( "restartLevelFromSave: cannot read '%s.save'", from.c_str() );
+		return false;
+	}
+	if ( !Session_iOS_WriteSaveSlotFile( to + ".save", bytes.Ptr(), bytes.Num() ) ) {
+		return false;
+	}
+	if ( Session_iOS_ReadSaveSlotFile( from + ".tga", bytes ) ) {
+		Session_iOS_WriteSaveSlotFile( to + ".tga", bytes.Ptr(), bytes.Num() );
+	}
+
+	// Description sidecar: same tokens, but this slot's name and a label that
+	// says what it is. "^:Map Start\t^0<level>" -> "^:Before restart\t^0<level>".
+	idStr description, screenshot;
+	bool noOverwrite = false;
+	if ( Session_iOS_ReadSaveSlotFile( from + ".txt", bytes ) && bytes.Num() > 0 ) {
+		idLexer src( (const char *)bytes.Ptr(), bytes.Num(), from.c_str(), LEXFL_NOERRORS | LEXFL_NOSTRINGCONCAT );
+		idToken tok;
+		if ( src.ReadToken( &tok ) && src.ReadToken( &tok ) ) {
+			description = tok;
+			if ( src.ReadToken( &tok ) ) {
+				screenshot = tok;
+				if ( src.ReadToken( &tok ) ) {
+					noOverwrite = !idStr::Icmp( tok.c_str(), SESSION_SAVEGAME_NO_OVERWRITE_TOKEN );
+				}
+			}
+		}
+	}
+	// The label column is narrow and an old copy is also prefixed
+	// "[Old version]": "Map Start (before restart)" clipped to "(befo". So the
+	// copy's label REPLACES the generated "Map Start" label; the level column
+	// (after the tab) is kept.
+	{
+		idStr label = "^:";
+		label += OpenQ4_iOS_SaveText( 7 );
+		const int tab = description.Find( '\t' );
+		if ( tab >= 0 ) {
+			label += description.Right( description.Length() - tab );
+		}
+		description = label;
+	}
+	idStr escapedName = copyName;
+	Session_EscapeSaveDescription( escapedName );
+	Session_EscapeSaveDescription( description );
+	idStr text = va( "\"%s\"\n\"%s\"\n\"%s\"\n", escapedName.c_str(), description.c_str(), screenshot.c_str() );
+	if ( noOverwrite ) {
+		text += SESSION_SAVEGAME_NO_OVERWRITE_TOKEN;
+		text += "\n";
+	}
+	if ( !Session_iOS_WriteSaveSlotFile( to + ".txt", text.c_str(), text.Length() ) ) {
+		fileSystem->RemoveFile( ( to + ".save" ).c_str() );
+		fileSystem->RemoveFile( ( to + ".tga" ).c_str() );
+		return false;
+	}
+	common->Printf( "restartLevelFromSave: kept the level's autosave '%s' as '%s' before it is replaced\n", autosaveSlot.c_str(), copySlot.c_str() );
+	return true;
+}
+
+static void Session_RestartLevelFromSave_f( const idCmdArgs &args ) {
+	if ( session_iosRescueSlot.IsEmpty() ) {
+		common->Printf( "restartLevelFromSave: no refused save is waiting to be restarted\n" );
+		return;
+	}
+	if ( sessLocal.IsMultiplayer() ) {
+		common->Printf( "restartLevelFromSave: can't during net play.\n" );
+		return;
+	}
+	// Same module switch LoadGame does, re-running THIS command afterwards
+	// (the slot survives in session_iosRescueSlot; no name crosses the console).
+	const char *activeModule = cvarSystem->GetCVarString( "com_activeGameModule" );
+	if ( idStr::Icmp( activeModule, "game_sp" ) != 0 ) {
+		cvarSystem->SetCVarString( "si_gameType", "singleplayer" );
+		cvarSystem->SetCVarString( "com_nextGameModule", "game_sp" );
+		idCmdArgs reloadArgs;
+		reloadArgs.AppendArg( "restartLevelFromSave" );
+		cmdSystem->SetupReloadGameModule( reloadArgs );
+		return;
+	}
+	const idStr slot = session_iosRescueSlot;
+	session_iosRescueSlot.Clear();
+
+	idStr map, filter;
+	idDict playerInfo;
+	const int verdict = Session_iOS_ProbeSaveGame( slot.c_str(), &map, &filter, &playerInfo );
+	if ( map.IsEmpty() || verdict == 3 || verdict == 4 ) {
+		common->Warning( "restartLevelFromSave: '%s' no longer names a level that can be started (reason %d)", slot.c_str(), verdict );
+		// The player pressed YES; a console line alone is not an answer.
+		Session_iOS_MenuUnderSaveBox();
+		sessLocal.MessageBox( MSG_OK, OpenQ4_iOS_SaveText( verdict == 3 ? 4 : 5 ), OpenQ4_iOS_SaveText( 1 ), false );
+		return;
+	}
+	if ( !Session_iOS_KeepAutosaveCopy( map, filter ) ) {
+		common->Warning( "restartLevelFromSave: the level's autosave could not be kept aside - not restarting, nothing changed" );
+		Session_iOS_MenuUnderSaveBox();
+		sessLocal.MessageBox( MSG_OK, OpenQ4_iOS_SaveText( 8 ), OpenQ4_iOS_SaveText( 1 ), false );
+		return;
+	}
+	common->Printf( "restartLevelFromSave: '%s' -> starting %s%s%s from the beginning with the saved inventory (%d keys)\n",
+		slot.c_str(), map.c_str(), filter.Length() ? " " : "", filter.c_str(), playerInfo.GetNumKeyVals() );
+	console->Close();
+	session_iosStartPlayerInfo = &playerInfo;
+	sessLocal.StartNewGame( map.c_str(), false, filter.c_str() );
+	session_iosStartPlayerInfo = NULL;
+}
