+/*
+ * Whole-frame brightness, drawn as one blended quad after everything else.
+ *
+ * The obvious cvars are both dead ends on this substrate and it cost two rounds
+ * to establish that. r_gamma/r_brightness build gamma tables every frame and
+ * hand them to GLimp_SetGamma, which the Vulkan backend implements as an empty
+ * function; the GLSL fallback that covers that case (RB_ApplyColorMappingsToBackBuffer)
+ * lives in draw_common.cpp and only ever runs under the GL backend. r_lightScale
+ * does work, but it scales scene LIGHTING — so it leaves menus, the HUD, fog and
+ * anything unlit exactly where they were, and its default is 2, which meant the
+ * shell pushing 1.0 as "normal" had been running the whole game at half light.
+ *
+ * A post pass that samples the finished frame would be the textbook fix, and it
+ * needs a swapchain copy plus a new SPIR-V shader — real bandwidth, every frame,
+ * on the device we are trying to get to 120 Hz. The same curve is approximated
+ * here with blended fullscreen quads and no new shaders:
+ *
+ *   gain (b > 1)  blend GL_DST_COLOR, GL_ONE            ->  dst * (1 + a)
+ *   lift (b > 1)  blend GL_ONE_MINUS_DST_COLOR, GL_ONE  ->  dst + (1 - dst) * k
+ *   darken (b<1)  blend GL_DST_COLOR, GL_ZERO           ->  dst * b
+ *
+ * Gain does most of the work and lift only a little, and the split is the whole
+ * point. Lift alone was tried first and measured a clean monotonic response —
+ * and looked wrong, because a screen blend raises ABSOLUTE BLACK by k: at the
+ * top of the slider the letterbox bars turned grey. Gamma does not do that,
+ * pow(0, x) is still 0. Gain keeps black at black and opens the midtones, and
+ * the small lift on top is what makes an unlit corner readable rather than just
+ * a brighter shade of unreadable.
+ */
+idCVar r_iosBrightness( "r_iosBrightness", "1", CVAR_RENDERER | CVAR_ARCHIVE | CVAR_FLOAT,
+		"whole-frame brightness: 1 = untouched, above 1 brightens, below 1 darkens", 0.5f, 2.0f );
+
+#if defined( OPENQ4_VISIONOS_3D )
+/*
+ * visionOS stereo 3D (openQ4-ios D-101). Defined in renderer/tr_main.cpp, which
+ * is inside the renderer MODULE — a layering reach that is legal here and only
+ * here: OPENQ4_VISIONOS_3D is defined on the visionOS lanes alone, and on those
+ * lanes the renderer is statically linked into the same archive as the framework
+ * (scripts/build-ios-engine.sh, OPENQ4_RENDERER_MODULE_STATIC). Declared rather
+ * than included because tr_local.h is not on the framework's include path and
+ * putting it there would drag the whole renderer into the framework's TUs.
+ */
+extern bool R_Stereo_Enabled( void );
+extern void R_Stereo_SetEye( int eye );
+#endif
+
+typedef enum {
+	SESSION_IOS_BRIGHT_GAIN,
+	SESSION_IOS_BRIGHT_LIFT,
+	SESSION_IOS_BRIGHT_DARKEN
+} sessionIOSBrightnessPass_t;
+
+static const idMaterial *Session_iOSBrightnessMaterial( sessionIOSBrightnessPass_t pass ) {
+	const char *name = NULL;
+	const char *blend = NULL;
+	switch ( pass ) {
+		case SESSION_IOS_BRIGHT_GAIN:
+			name = "openq4/ios/screenGain";
+			blend = "\t\tblend GL_DST_COLOR, GL_ONE\n";
+			break;
+		case SESSION_IOS_BRIGHT_LIFT:
+			name = "openq4/ios/screenLift";
+			blend = "\t\tblend GL_ONE_MINUS_DST_COLOR, GL_ONE\n";
+			break;
+		default:
+			name = "openq4/ios/screenDarken";
+			blend = "\t\tblend GL_DST_COLOR, GL_ZERO\n";
+			break;
+	}
+
+	const idMaterial *existing = declManager->FindMaterial( name, false );
+	if ( existing != NULL ) {
+		return existing;
+	}
+
+	idStr source;
+	source += va( "%s\n", name );
+	source += "{\n";
+	source += "\tnoShadows\n";
+	source += "\t{\n";
+	// GL_-prefixed names: idMaterial::NameToSrcBlendMode matches the GL token
+	// spellings and nothing else, and an unknown one warns, defaults the
+	// material and silently blends GL_ONE, GL_ZERO — an opaque sheet. The first
+	// version of this used the short 'one_minus_dst_color' spelling the .mtr
+	// files appear to use and drew nothing at all.
+	source += blend;
+	// 'colored' is what makes SetColor4 reach the stage; without it the vertex
+	// colour the GUI model emits is ignored and the quad is drawn at full
+	// strength, which is a white-out rather than a brightness control.
+	source += "\t\tcolored\n";
+	source += "\t\tnopicmip\n";
+	source += "\t\tmap _white\n";
+	source += "\t}\n";
+	source += "}\n";
+
+	idMaterial *material = static_cast<idMaterial *>(
+			declManager->CreateNewDecl( DECL_MATERIAL, name, "openq4_ios_brightness.mtr" ) );
+	if ( material == NULL ) {
+		return NULL;
+	}
+	material->SetText( source.c_str() );
+	material->Parse( source.c_str(), source.Length() );
+	material->SetSort( SS_GUI );
+	return material;
+}
+
+static void Session_iOSDrawBrightnessQuad( sessionIOSBrightnessPass_t pass, float k ) {
+	const idMaterial *material = Session_iOSBrightnessMaterial( pass );
+	if ( material == NULL ) {
+		return;
+	}
+	const float screenW = static_cast<float>( renderSystem->GetScreenWidth() );
+	const float screenH = static_cast<float>( renderSystem->GetScreenHeight() );
+	const bool previousUIViewportMode = renderSystem->GetUseUIViewportFor2D();
+	renderSystem->SetUseUIViewportFor2D( false );
+	renderSystem->SetColor4( k, k, k, 1.0f );
+	renderSystem->DrawStretchPic( 0.0f, 0.0f, screenW, screenH, 0.0f, 0.0f, 1.0f, 1.0f, material );
+	renderSystem->SetColor( colorWhite );
+	renderSystem->SetUseUIViewportFor2D( previousUIViewportMode );
+}
+
+static void Session_iOSApplyBrightness( void ) {
+	const float brightness = idMath::ClampFloat( 0.5f, 2.0f, r_iosBrightness.GetFloat() );
+	if ( idMath::Fabs( brightness - 1.0f ) <= 0.001f ) {
+		return;			// neutral costs nothing at all, which is the common case
+	}
+
+	if ( brightness < 1.0f ) {
+		Session_iOSDrawBrightnessQuad( SESSION_IOS_BRIGHT_DARKEN, brightness );
+		return;
+	}
+
+	// At the top of the slider: everything x1.8, then black lifted to 0.10. The
+	// lift is deliberately small — see the note above about grey letterbox bars.
+	const float excess = brightness - 1.0f;
+	Session_iOSDrawBrightnessQuad( SESSION_IOS_BRIGHT_GAIN, excess * 0.8f );
+	Session_iOSDrawBrightnessQuad( SESSION_IOS_BRIGHT_LIFT, excess * 0.10f );
+}
