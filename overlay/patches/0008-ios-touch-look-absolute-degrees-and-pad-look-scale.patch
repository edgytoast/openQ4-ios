+/*
+ * Mirrors Key()'s button bookkeeping without the keyState table, which belongs
+ * to real keys. Impulses fire on the press edge exactly as they do there.
+ */
+void idUsercmdGenLocal::TouchButton( int action, bool down ) {
+	if ( action < 0 || action >= UB_MAX_BUTTONS ) {
+		return;
+	}
+	if ( down ) {
+		if ( action == UB_WEAPONWHEEL || IsWeaponSelectionImpulse( action ) ) {
+			toggled_zoom.Clear();
+		}
+		buttonState[ action ]++;
+		if ( !Inhibited() ) {
+			if ( action >= UB_IMPULSE0 && action <= UB_IMPULSE127 ) {
+				cmd.impulse = action - UB_IMPULSE0;
+				cmd.flags ^= UCF_IMPULSE_SEQUENCE;
+			}
+		}
+	} else {
+		buttonState[ action ]--;
+		if ( buttonState[ action ] < 0 ) {
+			buttonState[ action ] = 0;
+		}
+	}
+}
+
+/*
+ * Touch buttons, straight into the usercmd button state.
+ *
+ * They used to be buffered as "+attack"/"-attack" command text, which is not how
+ * this engine works at all: `_attack` and friends are usercmd ACTIONS, resolved
+ * from a bound key by idUsercmdGenLocal::Key() into buttonState[]. There is no
+ * "+attack" command, so every on-screen button was buffering a string the
+ * command system quietly discarded — the press registered (the haptic fired) and
+ * nothing happened.
+ *
+ * Setting the action directly also means the buttons do not depend on the player
+ * having some key bound to that action, which a touch-only device may not.
+ */
+extern "C" void OpenQ4_iOS_SetTouchButtonByName( const char *name, int down ) {
+	// The mapping lives here because the UB_* enum is local to this file, and
+	// the shell should be naming actions rather than knowing engine constants.
+	static const struct { const char *name; int action; } kTouchActions[] = {
+		{ "attack",     UB_ATTACK      },
+		{ "jump",       UB_UP          },
+		{ "crouch",     UB_DOWN        },
+		{ "reload",     UB_IMPULSE13   },
+		{ "weapnext",   UB_IMPULSE14   },
+		{ "weapwheel",  UB_WEAPONWHEEL },
+		{ "objectives", UB_IMPULSE19   },
+		{ "zoom",       UB_ZOOM        },
+		{ "speed",      UB_SPEED       },
+	};
+
+	if ( name == NULL ) {
+		return;
+	}
+	for ( int i = 0; i < (int)( sizeof( kTouchActions ) / sizeof( kTouchActions[0] ) ); i++ ) {
+		if ( idStr::Icmp( name, kTouchActions[i].name ) == 0 ) {
+			localUsercmdGen.TouchButton( kTouchActions[i].action, down != 0 );
+			return;
+		}
+	}
+}
+
+void idUsercmdGenLocal::TouchMove( bool apply ) {
+	const float forward = s_touchMoveForward.load( std::memory_order_relaxed );
+	const float right = s_touchMoveRight.load( std::memory_order_relaxed );
+	if ( !apply ) {
+		return;
+	}
+	// Held state, not a delta: the stick reports where the thumb is, and the
+	// value stands until the next report or the finger lifting (which posts 0).
+	cmd.forwardmove = idMath::ClampChar( cmd.forwardmove + (int)( forward * 127.0f ) );
+	cmd.rightmove = idMath::ClampChar( cmd.rightmove + (int)( right * 127.0f ) );
+}
+
+void idUsercmdGenLocal::TouchLook( bool apply ) {
+	// Always drain, even when discarding: a menu that banked up every stray
+	// touch would spin the view the moment it closed.
+	const float yaw = s_touchLookYaw.exchange( 0.0f, std::memory_order_relaxed );
+	const float pitch = s_touchLookPitch.exchange( 0.0f, std::memory_order_relaxed );
+	if ( !apply ) {
+		return;
+	}
+	viewangles[YAW] += yaw;
+	viewangles[PITCH] += pitch;
+}
