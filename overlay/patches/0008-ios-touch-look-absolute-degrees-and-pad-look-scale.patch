 /*
+=================
+Touch look
+
+Touch look is expressed in absolute view degrees and applied straight to
+viewangles, deliberately bypassing MouseMove() entirely.
+
+Routing glass through the mouse path would make the shell's "look sensitivity"
+slider mean a different thing at every value of sensitivity, m_yaw, m_pitch,
+m_cpi and cl_mouseAccel — a user who had adjusted their mouse settings would
+find their touch slider silently recalibrated. It would also inherit the mouse
+filter, which smooths for a device with physical inertia that a fingertip on
+glass does not have, and it quantised to whole mouse counts, so slow drags lost
+motion outright to integer truncation.
+
+The accumulator is atomic because touch events arrive on the main thread at
+display-link rate while usercmds are generated on the tic clock, and it
+accumulates rather than overwrites so that every touch sample inside one 60 Hz
+tic contributes instead of the last one winning.
 =================
+*/
+static std::atomic<float> s_touchLookYaw( 0.0f );
+static std::atomic<float> s_touchLookPitch( 0.0f );
+
+// Touch movement, in normalised -1..1, applied directly to the usercmd.
+//
+// It does NOT go through the joystick axes, which is where it started and why
+// the on-screen stick did nothing: SDL3_UpdateGamepadAxes / ClearJoystickState
+// rewrite s_joystickAxisState on every pump, so anything injected there is
+// overwritten before the next usercmd is built. Look already worked precisely
+// because it was on this path.
+static std::atomic<float> s_touchMoveForward( 0.0f );
+static std::atomic<float> s_touchMoveRight( 0.0f );
+
+extern "C" void OpenQ4_iOS_SetTouchMove( float forward, float right ) {
+	s_touchMoveForward.store( forward, std::memory_order_relaxed );
+	s_touchMoveRight.store( right, std::memory_order_relaxed );
+}
+
+static void AccumulateAtomicFloat( std::atomic<float> &target, float delta ) {
+	float prev = target.load( std::memory_order_relaxed );
+	while ( !target.compare_exchange_weak( prev, prev + delta, std::memory_order_relaxed ) ) {
+		// compare_exchange_weak refreshes prev on failure
+	}
+}
+
+extern "C" void OpenQ4_iOS_AccumulateLook( float yawDegrees, float pitchDegrees ) {
+	AccumulateAtomicFloat( s_touchLookYaw, yawDegrees );
+	AccumulateAtomicFloat( s_touchLookPitch, pitchDegrees );
+}
