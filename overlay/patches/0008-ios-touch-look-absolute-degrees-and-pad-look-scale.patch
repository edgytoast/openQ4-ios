+/*
+=================
+iOS direct touch on in-world GUIs — the transport (openQ4-ios D-071)
+
+The game module decides which panel a tap lands on, because `idPlayer::UpdateFocus`
+owns the focus ray and lives in the separate `openQ4-game` dylib. The shell cannot
+call into that dylib (the game API is fixed and one-directional), so the touch
+point crosses the boundary the only way that costs nothing: as cvars, which the
+game reads through the `cvarSystem` pointer it is already handed.
+
+  in_touchAimActive  1 while a finger is down in the free (look) area and has not
+                     yet become a drag.
+  in_touchAimX/Y     that finger in normalised device coords, -1..1, +x right and
+                     +y UP. The centre of the screen is exactly (0,0), which must
+                     reproduce the crosshair ray bit-for-bit.
+  in_touchAimSeq     bumped once per tap. The game prints its `[touchaim]` line
+                     once per sequence number rather than once per tic.
+  in_touchAimClick   1 for the ~6 tics of the tap's click. It is NOT BUTTON_ATTACK:
+                     a tap must never fire the weapon (D-071), and the game only
+                     turns this into a gui mouse-click when a gui already has focus.
+
+None of these are archived: they describe a finger that is on the glass right
+now. They ARE marked CVAR_NOCHEAT, which is not cosmetic: this engine treats
+every otherwise-unflagged cvar as a cheat (idInternalCVar::UpdateCheat) and
+starting a multiplayer server resets all of them (AsyncServer.cpp:182), so
+without the flag an Arena match would quietly zero the touch point mid-play.
+openQ4-ios D-085 found that the hard way with the safe-area insets.
+=================
+*/
+static idCVar in_touchAimActive( "in_touchAimActive", "0", CVAR_SYSTEM | CVAR_NOCHEAT | CVAR_BOOL,
+	"iOS: a touch is steering the in-world gui focus ray" );
+static idCVar in_touchAimX( "in_touchAimX", "0", CVAR_SYSTEM | CVAR_NOCHEAT | CVAR_FLOAT,
+	"iOS: touch point x in normalised device coords, -1..1, +right" );
+static idCVar in_touchAimY( "in_touchAimY", "0", CVAR_SYSTEM | CVAR_NOCHEAT | CVAR_FLOAT,
+	"iOS: touch point y in normalised device coords, -1..1, +up" );
+static idCVar in_touchAimSeq( "in_touchAimSeq", "0", CVAR_SYSTEM | CVAR_NOCHEAT | CVAR_INTEGER,
+	"iOS: increments once per tap, so diagnostics print once per tap" );
+static idCVar in_touchAimClick( "in_touchAimClick", "0", CVAR_SYSTEM | CVAR_NOCHEAT | CVAR_BOOL,
+	"iOS: a tap is asking the focused in-world gui for a click" );
+
+extern "C" void OpenQ4_iOS_SetTouchAim( int active, float ndcX, float ndcY ) {
+	if ( active ) {
+		in_touchAimX.SetFloat( ndcX );
+		in_touchAimY.SetFloat( ndcY );
+		in_touchAimSeq.SetInteger( in_touchAimSeq.GetInteger() + 1 );
+		in_touchAimActive.SetBool( true );
+	} else {
+		in_touchAimActive.SetBool( false );
+	}
+}
+
+extern "C" void OpenQ4_iOS_SetTouchAimClick( int down ) {
+	in_touchAimClick.SetBool( down != 0 );
+}
