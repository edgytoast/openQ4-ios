+/*
+ * openQ4-ios overlay (upstreaming candidate): is this packet from a master?
+ *
+ * Every master gate in this file used the no-argument GetMasterAddress(), which
+ * is hardcoded to slot 0 — so net_master1..4 could be set, and were consulted
+ * by the SERVER's heartbeat loop, but any reply they sent the client was thrown
+ * away as "not a valid master". Resolution is cached inside GetMasterAddress
+ * (it only re-resolves when the cvar is modified), so this is not a DNS hit per
+ * packet.
+ */
+// Servers dropped by the protocol gate since the last master query. A file
+// static rather than an idAsyncClient member, so the overlay does not have to
+// carry a header edit for a diagnostic counter.
+static int OpenQ4_protocolRejects = 0;
+
+static bool OpenQ4_IsFromAnyMaster( const netadr_t from ) {
+	for ( int i = 0; i < MAX_MASTER_SERVERS; i++ ) {
+		netadr_t adr;
+		if ( idAsyncNetwork::GetMasterAddress( i, adr ) && Sys_CompareNetAdrBase( adr, from ) ) {
+			return true;
+		}
+	}
+	return false;
+}
