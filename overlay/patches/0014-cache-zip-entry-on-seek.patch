 /*
+=================
+idFile_InZip::EnsureCached
+
+Inflate the whole entry once so that seeking becomes arithmetic instead of
+decompression. See the comment on cachedData in File.h for why.
 =================
+*/
+bool idFile_InZip::EnsureCached( void ) {
+	if ( cachedData != NULL ) {
+		return true;
+	}
+	if ( fileSize <= 0 ) {
+		return false;
+	}
+
+	const int resumePos = unztell( z );
+
+	if ( unzSetCurrentFileInfoPosition( z, static_cast<unsigned long>( zipFilePos ) ) != UNZ_OK ||
+			unzOpenCurrentFile( z ) != UNZ_OK ) {
+		return false;
+	}
+
+	byte *buf = static_cast<byte *>( Mem_Alloc( fileSize ) );
+	if ( buf == NULL ) {
+		return false;
+	}
+
+	int total = 0;
+	while ( total < fileSize ) {
+		const int block = Min( fileSize - total, 64 * 1024 );
+		const int l = unzReadCurrentFile( z, buf + total, block );
+		if ( l <= 0 ) {
+			break;
+		}
+		total += l;
+	}
+	if ( total != fileSize ) {
+		Mem_Free( buf );
+		return false;
+	}
+
+	cachedData = buf;
+	cachedPos = ( resumePos > 0 && resumePos <= fileSize ) ? resumePos : 0;
+	return true;
+}
