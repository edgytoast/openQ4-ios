+/*
+ * Where the diagnostics column starts on iOS, in the engine's 640x480 space.
+ *
+ * The top-LEFT corner, up and left of the shell's gear button: the gear sits at
+ * safeArea.left + 16 pt and 14 pt down, the counter is about 7 pt tall, so it
+ * fits in the band above the gear and a little outboard of it. The gear does not
+ * move for it.
+ *
+ * Both margins are small on purpose — the old right-aligned position had been
+ * pushed a long way inward on both axes to escape the sensor housing and the
+ * bezel radius, and "too far from both edges" is exactly what it looked like.
+ * The left corner needs far less clearance because the safe-area inset already
+ * steps past the housing.
+ *
+ * The one number here that is not simply the system inset is the FLOOR on the
+ * left, and the counter now sits INSIDE the reported inset rather than outside
+ * it. safeAreaInsets.left is ~62 pt with the sensor housing on the left and ~0
+ * pt in the other landscape orientation, and it is a conservative full-height
+ * column: the housing itself is vertically centred, so the top of that column is
+ * ordinary visible glass. What actually limits how far left the text can go, at
+ * 4 pt from the top, is the display's ~62 pt corner radius — the glass does not
+ * begin until roughly 40 pt across. So: step 14 pt inboard of the reported inset
+ * for a visibly left position, with a hard floor that keeps clear of the curve
+ * whichever way the phone is held.
+ *
+ * NOTE, corrected by D-085: a simulator screenshot DOES composite the display
+ * cutout — the Dynamic Island appears as a black pill, vertically centred on the
+ * left edge in landscape, over whatever the app drew there. It was measured on
+ * lane 1 against a lit background (artifacts/sim/safearea). What it does NOT
+ * show is the rounded corner mask, so the corner radius still has to be reasoned
+ * about rather than looked at.
+ */
+static bool SCR_DiagnosticOrigin( float &leftEdgeOut, float &topInsetOut ) {
+	leftEdgeOut = 0.0f;
+	topInsetOut = 0.0f;
+#if defined( __APPLE__ ) && TARGET_OS_IPHONE
+	// D-085: the 2D UI viewport is itself inset by the safe area now, so the
+	// whole 640x480 space already starts inboard of the housing and the curve.
+	// Insetting again here would be double-counting — which is what the numbers
+	// below were, once the viewport learned to do it. What is left is an
+	// ordinary small margin, plus enough room to sit left of the gear button
+	// (which the shell places at safeAreaInsets.left + 16 pt).
+	if ( cvarSystem->GetCVarBool( "r_guiSafeInsets" ) ) {
+		leftEdgeOut = 0.010f * SCREEN_WIDTH;
+		topInsetOut = 0.006f * SCREEN_HEIGHT;
+		return true;
+	}
+	float l = 0.0f, t = 0.0f, r = 0.0f, b = 0.0f;
+	OpenQ4_iOS_SafeAreaFractions( &l, &t, &r, &b );
+	leftEdgeOut = Max( l - 0.014f, 0.046f ) * SCREEN_WIDTH;
+	topInsetOut = ( Max( t, 0.0f ) + 0.006f ) * SCREEN_HEIGHT;
+	return true;
+#else
+	return false;
+#endif
+}
