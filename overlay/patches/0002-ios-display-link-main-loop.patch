+/*
+================
+Touch and settings bridge
+
+The shell speaks in game concepts (move, look, "attack") and these translate
+into the engine's own input events. Movement uses the joystick axis path, which
+is analogue and needs no key mapping; buttons go through the command system's
++/- bindings so they honour whatever the player has bound.
+
+Look currently rides SE_MOUSE, which means it passes through the engine's mouse
+sensitivity chain. The charter asks for absolute view degrees instead, and that
+remains the right end state — the shell already computes degrees, so the change
+is confined to how they are delivered. Noted rather than silently accepted.
+================
+*/
+extern "C" void OpenQ4_iOS_SetTouchMove( float forward, float right );
+
+extern "C" void OpenQ4_iOS_InjectMove( float forward, float right ) {
+	// Straight to the usercmd generator's own touch-move state. This used to
+	// post SE_JOYSTICK_AXIS events, and the SDL backend rewrites the joystick
+	// axis array on every pump — so the stick's value was overwritten before it
+	// could ever reach a usercmd, and the on-screen stick did nothing at all.
+	OpenQ4_iOS_SetTouchMove( forward, right );
+}
+
+extern "C" void OpenQ4_iOS_AccumulateLook( float yawDegrees, float pitchDegrees );
+
+extern "C" void OpenQ4_iOS_InjectLook( float yawDegrees, float pitchDegrees ) {
+	// Straight through to the usercmd generator's absolute-degree accumulator.
+	// This used to synthesise SE_MOUSE counts, which meant the shell's look
+	// slider was scaled again by sensitivity/m_yaw/m_pitch/m_cpi/cl_mouseAccel
+	// and quantised to whole mouse counts on the way — so slow drags lost
+	// motion entirely to integer truncation, and the slider's meaning changed
+	// whenever the mouse cvars did.
+	OpenQ4_iOS_AccumulateLook( yawDegrees, pitchDegrees );
+}
+
+bool Sys_SDL_PumpEvents( void );
+extern "C" void OpenQ4_iOS_ApplyPendingTextInput( void );
+
+extern "C" void OpenQ4_iOS_PumpSDLEvents( void ) {
+	// Called from the display-link tick on the MAIN thread. SDL's event pump and
+	// window APIs are main-thread-only on Darwin, and the engine now runs on its
+	// own thread, so the pump has to be driven from here. Sys_SDL_PumpEvents
+	// pushes into the mutex-protected engine event queue that the engine thread
+	// drains — the same split upstream already uses for the async input thread.
+	(void)Sys_SDL_PumpEvents();
+
+	// Presenting or dismissing the iOS keyboard is UIKit work, and the engine
+	// thread may only ASK for it. This is where the ask is honoured.
+	OpenQ4_iOS_ApplyPendingTextInput();
+}
