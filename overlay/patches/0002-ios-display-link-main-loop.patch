+/*
+================
+OpenQ4_iOS_ServiceShellQueues
+
+Everything the UIKit shell hands to the engine, drained in one place on the
+ENGINE thread. Called both per frame and from Sys_GenerateEvents, so the
+engine's blocking inner loops (the map-load pacifier, the "press any key"
+gate) keep the buttons, the bridge and the settings alive instead of freezing
+them until the loop happens to end.
+
+All three are queue pops and therefore idempotent: calling this more often
+costs an uncontended lock and changes nothing else. Per-frame work that
+integrates over time — OpenQ4_iOS_TouchFrame — deliberately stays OUT, because
+running it twice in a frame would apply movement twice.
+================
+*/
+extern "C" void OpenQ4_iOS_ServiceShellQueues( void ) {
+	OpenQ4_iOS_BridgeDrain();
+	OpenQ4_iOS_DrainTouchButtons();
+	OpenQ4_iOS_DrainCvarQueue();
+}
