+/*
+================
+OpenQ4_iOSFrame
+
+iOS drives the frame from a CADisplayLink, not from a loop we own.
+
+The desktop entry point below ends in a blocking `while (1) common->Frame()`.
+That cannot work here: UIKit requires the main thread to return to its run loop,
+and an app that never does is killed by the watchdog. SDL3 exposes exactly the
+hook needed - SDL_SetiOSAnimationCallback installs a CADisplayLink that calls
+back once per display refresh - so the loop inverts: register this, return, and
+let the link drive.
+
+This also lands the charter's pacing requirement for free (Phase 0.6): the
+display link becomes the single pacer, with one present per rendered frame.
+================
+*/
+/*
+================
+OpenQ4_iOS_BridgeExecuteCommand
+
+Called by the shell's console bridge, on the frame thread only. idCmdSystem is
+not thread-safe, so the bridge queues on its socket thread and this is the
+single point where a remote command enters the engine.
+================
+*/
+/*
+================
+OpenQ4_iOS_FrameLinkCmd
+
+`iosframelink` — prints display-link health over the bridge. The three ways
+"no frames" can happen look identical from outside: the link stopped being
+delivered, ticks arrive but are dropped by the re-entrancy guard, or ticks run
+and the engine does nothing. This tells them apart.
+================
+*/
+/*
+================
+`iostouch 0|1` — force the touch overlay visible or hidden.
+
+The overlay normally follows the engine's GUI state, so it is invisible in menus
+— which on the simulator means invisible always, since the simulator cannot
+reach gameplay. This exists so its layout can still be verified with a
+screenshot there.
+================
+*/
+static void OpenQ4_iOS_TouchCmd( const idCmdArgs &args ) {
+	const int visible = ( args.Argc() > 1 ) ? atoi( args.Argv( 1 ) ) : 1;
+	OpenQ4_iOS_TouchSetVisible( visible );
+	common->Printf( "iOS touch overlay forced %s\n", visible ? "visible" : "hidden" );
+}
+
+static void OpenQ4_iOS_SettingsCmd( const idCmdArgs &args ) {
+	(void)args;
+	OpenQ4_iOS_ShowSettings();
+}
+
+static void OpenQ4_iOS_FrameLinkCmd( const idCmdArgs &args ) {
+	(void)args;
+	OpenQ4_iOS_ReportFrameLoop();
+}
