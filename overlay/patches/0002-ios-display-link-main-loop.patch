+#define OPENQ4_CVAR_QUEUE 64
+static char s_cvarQueueName[OPENQ4_CVAR_QUEUE][64];
+static char s_cvarQueueValue[OPENQ4_CVAR_QUEUE][64];
+static int  s_cvarQueueCount = 0;
+static int  s_cvarQueueOverflows = 0;
+
+/*
+ * Queued, not applied here.
+ *
+ * Every caller of this is the settings sheet, which runs on the MAIN thread,
+ * while the engine runs on its own thread — and idCvarSystem is no more
+ * thread-safe than idCmdSystem was. Writing straight through appeared to work
+ * and did not: brightness did nothing, the FPS counter did nothing, and the
+ * resolution preset did nothing, all for the same reason the on-screen buttons
+ * did nothing before they were queued.
+ */
+extern "C" void OpenQ4_iOS_SetCvar( const char *name, const char *value ) {
+	if ( name == NULL || value == NULL ) {
+		return;
+	}
+
+	Sys_EnterCriticalSection( CRITICAL_SECTION_ONE );
+	/*
+	 * COALESCE BY NAME. A UISlider emits a value-changed event per touch sample
+	 * — up to 120 a second on a ProMotion panel — and each one lands here. The
+	 * queue used to append and, once full, DROP THE NEWEST, which is the worst
+	 * possible policy: the values that survive are the first sixty-four of the
+	 * drag and the value the player actually let go on is thrown away. The cvar
+	 * ends up roughly where the slider started, which is indistinguishable from
+	 * a slider that does nothing at all. Brightness was diagnosed twice as a
+	 * renderer problem on the strength of that symptom.
+	 *
+	 * One slot per cvar makes overflow impossible in the case that matters: the
+	 * last write for a given name always wins, however fast they arrive, and a
+	 * drag of any length occupies exactly one entry.
+	 */
+	for ( int i = 0; i < s_cvarQueueCount; i++ ) {
+		if ( idStr::Icmp( s_cvarQueueName[i], name ) == 0 ) {
+			idStr::Copynz( s_cvarQueueValue[i], value, sizeof( s_cvarQueueValue[0] ) );
+			Sys_LeaveCriticalSection( CRITICAL_SECTION_ONE );
+			return;
+		}
+	}
+	if ( s_cvarQueueCount < OPENQ4_CVAR_QUEUE ) {
+		idStr::Copynz( s_cvarQueueName[ s_cvarQueueCount ], name, sizeof( s_cvarQueueName[0] ) );
+		idStr::Copynz( s_cvarQueueValue[ s_cvarQueueCount ], value, sizeof( s_cvarQueueValue[0] ) );
+		s_cvarQueueCount++;
+	} else {
+		// Distinct cvars only — the queue is now one slot per name, so filling
+		// it means something is writing more than 64 different cvars between
+		// two engine frames. Say so rather than dropping in silence.
+		s_cvarQueueOverflows++;
+	}
+	Sys_LeaveCriticalSection( CRITICAL_SECTION_ONE );
 }
 
+/* Applied on the engine thread, where cvarSystem is safe to touch. */
+static void OpenQ4_iOS_DrainCvarQueue( void ) {
+	char names[OPENQ4_CVAR_QUEUE][64];
+	char values[OPENQ4_CVAR_QUEUE][64];
+	int  count = 0;
+	int  overflows = 0;
+
+	Sys_EnterCriticalSection( CRITICAL_SECTION_ONE );
+	count = s_cvarQueueCount;
+	for ( int i = 0; i < count; i++ ) {
+		idStr::Copynz( names[i], s_cvarQueueName[i], sizeof( names[0] ) );
+		idStr::Copynz( values[i], s_cvarQueueValue[i], sizeof( values[0] ) );
+	}
+	s_cvarQueueCount = 0;
+	overflows = s_cvarQueueOverflows;
+	s_cvarQueueOverflows = 0;
+	Sys_LeaveCriticalSection( CRITICAL_SECTION_ONE );
+
+	for ( int i = 0; i < count; i++ ) {
+		cvarSystem->SetCVarString( names[i], values[i] );
+	}
+	if ( overflows > 0 ) {
+		common->Warning( "iOS: dropped %i queued cvar write(s) — the shell queue was full", overflows );
+	}
+}
+
+extern "C" void OpenQ4_iOS_BridgeExecuteCommand( const char *text ) {
+	if ( text == NULL || text[0] == '\0' ) {
+		return;
+	}
+	idStr line = text;
+	line.Append( "\n" );
+	cmdSystem->BufferCommandText( CMD_EXEC_APPEND, line.c_str() );
+}
