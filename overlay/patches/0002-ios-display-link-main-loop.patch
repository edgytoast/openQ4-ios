+#if TARGET_OS_IPHONE
+/*
+================
+Deferred engine initialisation.
+
+common->Init() takes 15-20 seconds on this content: 22 retail paks, the decl
+system, and media. Running it inside UIApplicationMain's launch path means the
+app never signals "finished launching", and iOS's watchdog kills it at roughly
+20 seconds — which presents as a black screen followed by the app quitting, with
+no crash report attributable to us.
+
+So main() returns immediately after starting the display link, letting the launch
+complete, and the engine initialises on the FIRST frame tick instead. By then the
+launch window is closed and a long main-thread block is merely a long block.
+================
+*/
+static SDL_Window *OpenQ4_iOSFindWindow( void );   // defined below
+extern "C" int OpenQ4_iOS_AvailableMemoryMB( void );
+// openq4_ios_bridge.m: read-and-reset the display-link pacing counters
+extern "C" void OpenQ4_iOS_TakeFramePacingCounters( int *missed, int *catchUp, int *paceMode );
+// openq4_ios_mods.m: `+set` arguments the shell wants applied before the
+// filesystem builds its search paths — today only the mod picker's
+// `+set fs_game <dir>` (openQ4-ios D-080).
+extern "C" const char *const *OpenQ4_iOS_StartupArgs( int *outCount );
+
+static int   s_iosInitDone = 0;
+static int   s_iosInitArgc = 0;
+static char **s_iosInitArgv = NULL;
+
+static void OpenQ4_iOS_DeferredInit( void ) {
+	OpenQ4_iOS_SetBootStatus( "Loading Quake 4 data..." );
+	common->Printf( "iOS: memory headroom before init: %d MB\n", OpenQ4_iOS_AvailableMemoryMB() );
+
+	// common->Init() blocks this thread for 15-20 seconds, so the watchdog will
+	// correctly report main-alive as stalled throughout. Naming the phase is
+	// what separates "expected long block" from "wedged".
+	// Before common->Init(), because the sound system opens its device in
+	// there and the first activation is the one that cannot be fixed later.
+	// Without this the category defaults to one the ring/silent switch mutes,
+	// so the game is simply silent with no error reported anywhere.
+	OpenQ4_iOS_AudioSessionInit();
+	OpenQ4_iOS_MetricsInit();
+
+	/*
+	 * The bridge starts HERE, not after common->Init().
+	 *
+	 * It only opens a socket and tees stdout — it needs nothing from the engine,
+	 * and commands that arrive before cmdSystem exists simply queue. Starting it
+	 * afterwards meant the whole of init, fifteen to twenty seconds of the most
+	 * interesting output the app produces, was unreachable remotely and could
+	 * only be recovered from a log file the maintainer had to export by hand. The glyph
+	 * check below is the immediate case: its pre-init line is the one fact that
+	 * separates the candidate causes, and it was printed into a void.
+	 */
+	OpenQ4_iOS_BridgeStart();
+
+	// Before and after the big load, because when the UIKit glyph cache first
+	// fails is the fact that separates the candidate causes. See
+	// openq4_ios_fontcheck.h.
+	OpenQ4_iOS_FontCheck( "pre-init" );
+
+	OpenQ4_iOS_BlackBoxPhase( "common->Init (long block is expected here)" );
+
+	/*
+	 * The engine's startup arguments are the process's own argv PLUS whatever
+	 * the shell wants set before common->Init() (openQ4-ios D-080).
+	 *
+	 * A shipped iOS app has no command line at all — argv is a development
+	 * channel, driven by `simctl launch ... +set x y` — so the only way a
+	 * player can choose an fs_game is for the shell to supply it here. fs_game
+	 * is CVAR_INIT and FileSystem::Init builds its search paths inside this
+	 * call, which makes this the one moment in the process's life when a mod
+	 * can be selected.
+	 *
+	 * The shell's arguments go LAST so they win: NSUserDefaults is this port's
+	 * authority for a setting (the same rule that decides the SMAA default),
+	 * and a later `+set` overwrites an earlier one.
+	 */
+	static const int MAX_INIT_ARGS = 64;
+	const char *initArgv[ MAX_INIT_ARGS ];
+	int initArgc = 0;
+	for ( int i = 1; i < s_iosInitArgc && s_iosInitArgv != NULL && initArgc < MAX_INIT_ARGS; i++ ) {
+		initArgv[ initArgc++ ] = s_iosInitArgv[ i ];
+	}
+	int shellArgc = 0;
+	const char *const *shellArgv = OpenQ4_iOS_StartupArgs( &shellArgc );
+	for ( int i = 0; i < shellArgc && shellArgv != NULL && initArgc < MAX_INIT_ARGS; i++ ) {
+		initArgv[ initArgc++ ] = shellArgv[ i ];
+	}
+	if ( initArgc > 0 ) {
+		common->Init( initArgc, initArgv, NULL );
+	} else {
+		common->Init( 0, NULL, NULL );
+	}
+
+	OpenQ4_iOS_InitComplete();
+	OpenQ4_iOS_EngineReady();   // main may now pump SDL; the engine owned it until here
+	OpenQ4_iOS_BlackBoxPhase( "post-init" );
+	OpenQ4_iOS_FontCheck( "post-init" );
+	Sys_HandlePendingQuitSignal();
+	Posix_LateInit();
+
+	if ( OpenQ4_iOSFindWindow() == NULL ) {
+		common->FatalError( "iOS: no SDL window after common->Init()" );
+		return;
+	}
+
+	cmdSystem->AddCommand( "iosframelink", OpenQ4_iOS_FrameLinkCmd, CMD_FL_SYSTEM,
+			"report iOS display-link health (ticks, re-entrancy drops, link state)" );
+	cmdSystem->AddCommand( "iostouch", OpenQ4_iOS_TouchCmd, CMD_FL_SYSTEM,
+			"force the iOS touch overlay visible (1) or hidden (0)" );
+	cmdSystem->AddCommand( "iossettings", OpenQ4_iOS_SettingsCmd, CMD_FL_SYSTEM,
+			"open the iOS settings sheet" );
+
+	OpenQ4_iOS_SettingsApply();
+	OpenQ4_iOS_TouchSetup();
+
+	// The raw-AL partition tone lived here. It did its job — audible while the
+	// game was silent, which proved the session and backend were fine and put
+	// the fault in the engine mixer (it was my own settings bridge pushing
+	// s_volume 0). Audio works now, so it is gone; OpenQ4_iOS_AudioSelfTest is
+	// kept and can be called from the bridge if it is ever needed again.
+
+	OpenQ4_iOS_SetBootStatus( NULL );   // tears the boot overlay down
+	OpenQ4_iOS_BlackBoxPhase( "running" );
+	common->Printf( "iOS: engine initialised on the frame thread; running (%d MB headroom)\n",
+			OpenQ4_iOS_AvailableMemoryMB() );
+}
+#endif
+
+extern "C" void OpenQ4_iOS_EngineFrame( void ) {
+#if TARGET_OS_IPHONE
+	// Bumped before anything that can block, so a frozen counter means the main
+	// thread is stuck inside this call rather than never having reached it.
+	OpenQ4_iOS_NoteMainAlive();
+	// A normal frame means the map change is over; the load overlay can go.
+	OpenQ4_iOS_LoadProgressDone();
+	if ( !s_iosInitDone ) {
+		s_iosInitDone = 1;
+		OpenQ4_iOS_DeferredInit();
+		return;
+	}
+#endif
+
+	// Frame-loop heartbeat. A stalled display link and a running one are
+	// indistinguishable from a screenshot, and the engine prints nothing per
+	// frame, so without this "did frames stop, and when?" is unanswerable.
+	// Cheap: one clock read per frame, one line per five seconds.
+	{
+		static int		s_frames = 0;
+		static int		s_lastMs = 0;
+		static double	s_busyUs = 0.0;
+		static double	s_gapUs = 0.0;
+		static double	s_prevFrameEndTicks = 0.0;
+		const int		nowMs = Sys_Milliseconds();
+		s_frames++;
+
+		/*
+		 * Busy versus gap, because the first device pass could not tell them
+		 * apart and it is the question that matters.
+		 *
+		 * com_speeds accounts for ~3 ms of a ~15 ms frame (gfr + rf + bk) while
+		 * the display link is provably delivering a true 120 Hz, so either the
+		 * engine is BUSY for 15 ms in code none of those three timers cover, or
+		 * it is IDLE and something is pacing it down. Those need completely
+		 * different fixes and nothing shipped could distinguish them.
+		 *
+		 * busy = wall time inside common->Frame() and the shell servicing around
+		 * it; gap = everything else, which on this design is the wait for the
+		 * display link to signal the engine thread.
+		 */
+		const double clockTicksPerSecond = Sys_ClockTicksPerSecond();
+		const double frameStartTicks = Sys_GetClockTicks();
+		if ( s_prevFrameEndTicks > 0.0 && clockTicksPerSecond > 0.0 ) {
+			s_gapUs += ( frameStartTicks - s_prevFrameEndTicks ) * 1000000.0 / clockTicksPerSecond;
+		}
+		if ( s_lastMs == 0 ) {
+			s_lastMs = nowMs;
+		} else if ( nowMs - s_lastMs >= 5000 ) {
+			// Remaining Jetsam headroom rides every heartbeat. An OOM kill is a
+			// SIGKILL with no crash report, so without this a memory death is
+			// indistinguishable from any other sudden exit.
+			const int headroomMB = OpenQ4_iOS_AvailableMemoryMB();
+			char headroom[32];
+			if ( headroomMB < 0 ) {
+				idStr::snPrintf( headroom, sizeof( headroom ), "n/a" );
+			} else {
+				idStr::snPrintf( headroom, sizeof( headroom ), "%d MB", headroomMB );
+			}
+			// Pacing: how many display-link ticks landed on a frame that was
+			// still running, and how many of those the engine thread went on to
+			// serve immediately instead of idling to the following tick. A
+			// window with missed > 0 and catchup == 0 means catch-up is off.
+			int missedTicks = 0, catchUpFrames = 0, paceMode = 0;
+			OpenQ4_iOS_TakeFramePacingCounters( &missedTicks, &catchUpFrames, &paceMode );
+			common->Printf( "iOS heartbeat: %d frames in %d ms (%.1f fps), busy %.2f ms, gap %.2f ms, "
+					"pace %d, missed %d, catchup %d, thermal %s, %s memory headroom\n",
+					s_frames, nowMs - s_lastMs,
+					( nowMs > s_lastMs ) ? ( s_frames * 1000.0f / ( nowMs - s_lastMs ) ) : 0.0f,
+					( s_frames > 0 ) ? ( s_busyUs / s_frames / 1000.0 ) : 0.0,
+					( s_frames > 0 ) ? ( s_gapUs / s_frames / 1000.0 ) : 0.0,
+					paceMode, missedTicks, catchUpFrames,
+					OpenQ4_iOS_ThermalState(),
+					headroom );
+			s_frames = 0;
+			s_lastMs = nowMs;
+			s_busyUs = 0.0;
+			s_gapUs = 0.0;
+		}
+
+		OpenQ4_iOS_ServiceShellQueues();
+		OpenQ4_iOS_TouchFrame();
+		Sys_HandlePendingQuitSignal();
+		common->Frame();
+
+		const double frameEndTicks = Sys_GetClockTicks();
+		if ( clockTicksPerSecond > 0.0 ) {
+			s_busyUs += ( frameEndTicks - frameStartTicks ) * 1000000.0 / clockTicksPerSecond;
+		}
+		s_prevFrameEndTicks = frameEndTicks;
+	}
+}
+
+/*
+================
+OpenQ4_iOSFindWindow
+
+The renderer creates the window during common->Init(), behind the
+renderWindowServices_t seam, and the SDL3 backend keeps its handle file-static.
+Rather than patch an accessor into the backend, ask SDL for its window list -
+the engine is single-window, so the first entry is the game window.
+================
+*/
+static SDL_Window *OpenQ4_iOSFindWindow(void) {
+	int count = 0;
+	SDL_Window **windows = SDL_GetWindows(&count);
+	SDL_Window *window = (windows != NULL && count > 0) ? windows[0] : NULL;
+	SDL_free(windows);
+	return window;
+}
+#endif
+
+
 static int SDLCALL OpenQ4_Main(int argc, char **argv) {
 	Posix_EarlyInit();
-#ifndef ID_DEDICATED
+
+#if TARGET_OS_IPHONE
+	// Before common->Init(): the engine fatals when it cannot find retail data,
+	// and on iOS that fatal is both unreadable (no console) and unreliable
+	// (upstream #96), so a missing-data launch just looks like the app quitting.
+	// Import the data first, with a real UI.
+	OpenQ4_iOS_EnsureGameData();
+#endif
+#if !defined( ID_DEDICATED ) && !TARGET_OS_IPHONE
+	// No splash on iOS. UIKit permits exactly ONE window per display, and the
+	// splash takes it — the renderer's own SDL_CreateWindow then fails with
+	// "Only one window allowed per display." iOS shows its own launch screen
+	// from the app bundle anyway, so nothing is lost.
 	Sys_ShowSplash();
 #endif
 
+#if TARGET_OS_IPHONE
+	// Do NOT initialise here — see OpenQ4_iOS_DeferredInit. Stash argv, start
+	// the display link, and return so the launch completes inside the watchdog's
+	// window.
+	s_iosInitArgc = argc;
+	s_iosInitArgv = argv;
+	OpenQ4_iOS_ShowBootOverlay();
+	OpenQ4_iOS_StartFrameLoop();
+	return 0;
+#else
 	if (argc > 1 && argv != NULL) {
 		common->Init(argc - 1, const_cast<const char **>(&argv[1]), NULL);
 	} else {
 		common->Init(0, NULL, NULL);
 	}
+#endif
 
-#ifndef ID_DEDICATED
+#if !defined( ID_DEDICATED ) && !TARGET_OS_IPHONE
 	Sys_DestroySplash();
 #endif
 	Sys_HandlePendingQuitSignal();
 	Posix_LateInit();
 
+#if TARGET_OS_IPHONE
+	return 0;   // unreachable; the iOS path returned above
+#else
 	while (1) {
 		Sys_HandlePendingQuitSignal();
 		common->Frame();
 	}
 
 	return 0;
+#endif
 }
 
+/*
+================
+Entry point.
+
+Two shapes, one body.
+
+iOS is SDL-entry: main() hands off to SDL_RunApp, which calls
+UIApplicationMain, installs SDL's own app/scene delegate, and calls back into
+OpenQ4_Main once UIKit is up.
+
+visionOS is SwiftUI-entry (OPENQ4_SWIFT_MAIN, D-089). The app must be a SwiftUI
+@main to declare the ImmersiveSpace that Phase 6's stereo mode renders into, so
+UIApplicationMain has already run by the time the engine is reached and
+SDL_RunApp must not run at all. The shell calls SDL_SetMainReady() and then
+this function directly, off the scene that SwiftUI connected.
+
+The decision is made HERE, at bring-up, rather than deferred to the 3D phase:
+vkQuake D-028 found that flipping entry style over a bundle id that has already
+launched restores a persisted scene session naming SDL's scene delegate, which
+then calls through a NULL forward_main and dies at PC=0 with no usable report.
+The paired SDL patch (overlay/patches-sdl/swiftui) closes the same hole from
+SDL's side.
+================
+*/
+#if defined( OPENQ4_SWIFT_MAIN )
+extern "C" int openq4_engine_main(int argc, char **argv);
+extern "C" int openq4_engine_main(int argc, char **argv) {
+#else
 int main(int argc, char **argv) {
+#endif
 	static char emptyArg0[] = "openQ4";
 	char *emptyArgv[] = { emptyArg0, NULL };
 	if (argc <= 0 || argv == NULL) {
 		argc = 1;
 		argv = emptyArgv;
 	}
+#if defined( OPENQ4_SWIFT_MAIN )
+	return OpenQ4_Main(argc, argv);
+#else
 	return SDL_RunApp(argc, argv, OpenQ4_Main, NULL);
+#endif
 }
