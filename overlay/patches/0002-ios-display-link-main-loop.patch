+extern "C" int OpenQ4_iOS_AwaitingContinue( void ) {
+	// True while the engine is sitting on its "press any key to continue" screen
+	// after a map load. That gate is a blocking loop inside ExecuteMapChange, so
+	// the shell cannot see it as an ordinary game state — it has to ask.
+	return openQ4_AcceptingLoadingContinueInput() ? 1 : 0;
+}
+
+extern "C" void OpenQ4_iOS_InjectContinueKey( void ) {
+	// Space, not escape: the gate accepts any key, but escape is also the menu
+	// key, and a stray escape arriving just after the gate closes opens the pause
+	// menu the instant the player lands in the map.
+	Posix_QueEvent( SE_KEY, K_SPACE, 1, 0, NULL );
+	Posix_QueEvent( SE_KEY, K_SPACE, 0, 0, NULL );
+}
+
+extern "C" void OpenQ4_iOS_InjectEscape( void ) {
+	// A press/release pair in one call. The engine's menu handling triggers on
+	// the down edge, but leaving the key latched down would leave the console
+	// and GUI code believing escape is held for the rest of the session.
+	Posix_QueEvent( SE_KEY, K_ESCAPE, 1, 0, NULL );
+	Posix_QueEvent( SE_KEY, K_ESCAPE, 0, 0, NULL );
+}
+
+extern "C" void OpenQ4_iOS_InjectButton( const char *name, int down ) {
+	if ( name == NULL || name[0] == '\0' ) {
+		return;
+	}
+	// Queued, not executed here. This runs on the MAIN thread (a UIKit button
+	// handler) while the engine runs on its own thread, and idCmdSystem is not
+	// thread-safe — buffering from here did nothing at all, which is why every
+	// on-screen button was dead while look, which takes an atomic path, worked.
+	//
+	// Still routed through the command system when it is finally executed, so
+	// the buttons behave exactly like a bound key ("+attack"/"-attack") and
+	// respect the player's own bindings.
+	Sys_EnterCriticalSection( CRITICAL_SECTION_ONE );
+	if ( s_touchButtonQueueCount < OPENQ4_TOUCH_BUTTON_QUEUE ) {
+		idStr::Copynz( s_touchButtonNames[ s_touchButtonQueueCount ], name,
+				sizeof( s_touchButtonNames[0] ) );
+		s_touchButtonDown[ s_touchButtonQueueCount ] = ( down != 0 );
+		s_touchButtonQueueCount++;
+	}
+	Sys_LeaveCriticalSection( CRITICAL_SECTION_ONE );
+}
+
+/*
+================
+Drain the touch button queue. Called from the engine thread at the top of a
+frame, where idCmdSystem is safe to touch.
+================
+*/
+static void OpenQ4_iOS_DrainTouchButtons( void ) {
+	char names[OPENQ4_TOUCH_BUTTON_QUEUE][32];
+	bool downs[OPENQ4_TOUCH_BUTTON_QUEUE];
+	int  count = 0;
+
+	Sys_EnterCriticalSection( CRITICAL_SECTION_ONE );
+	count = s_touchButtonQueueCount;
+	for ( int i = 0; i < count; i++ ) {
+		idStr::Copynz( names[i], s_touchButtonNames[i], sizeof( names[0] ) );
+		downs[i] = s_touchButtonDown[i];
+	}
+	s_touchButtonQueueCount = 0;
+	Sys_LeaveCriticalSection( CRITICAL_SECTION_ONE );
+
+	for ( int i = 0; i < count; i++ ) {
+		OpenQ4_iOS_SetTouchButtonByName( names[i], downs[i] ? 1 : 0 );
+	}
+}
