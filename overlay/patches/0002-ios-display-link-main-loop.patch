+extern "C" void OpenQ4_iOS_InjectJoyKeyState( int joyIndex, int down ) {
+	// Press and release are SEPARATE, because objectives is a held display, not
+	// a toggle: the maintainer's report is that HOLDING D-pad up shows it. Sending down
+	// and up together — which is what this used to do — is a press the game
+	// never sees as held, and the screen never appears.
+	//
+	// K_JOY1..K_JOY16 are contiguous, so JOY9 (D-pad up) is K_JOY1 + 8.
+	if ( joyIndex < 1 || joyIndex > 16 ) {
+		return;
+	}
+	const int key = K_JOY1 + ( joyIndex - 1 );
+	Posix_QueEvent( SE_KEY, key, down ? 1 : 0, 0, NULL );
+}
+
+extern "C" void OpenQ4_iOS_QueueWheelMouseDelta( int dx, int dy );
+
+extern "C" void OpenQ4_iOS_InjectWheelAim( float dx, float dy ) {
+	// The weapon wheel reads usercmd.mx/my, and usercmd.mx/my is filled ONLY by
+	// idUsercmdGenLocal::Mouse() draining the SDL backend's s_mouseQueue. This
+	// used to post SE_MOUSE into the sys event queue instead — the plane that
+	// feeds GUIs and binds, which the usercmd generator never looks at. The
+	// deltas were therefore discarded, and the wheel was in fact being steered
+	// by the game's LOOK-ANGLE fallback (Player.cpp UpdateWeaponWheelCursor),
+	// which is driven by the second finger on the look area. That single fact
+	// explains all three complaints at once: it needed a second finger, it was
+	// mirrored, and at 0.08 cursor-units per degree against a 118-unit radius it
+	// took roughly four full turns of the view to cross the wheel.
+	//
+	// No negation here. Positive dx means the cursor goes right, and once real
+	// counts arrive the mouse path also suppresses the look fallback.
+	const int ix = (int)dx;
+	const int iy = (int)dy;
+	if ( ix != 0 || iy != 0 ) {
+		OpenQ4_iOS_QueueWheelMouseDelta( ix, iy );
+	}
+}
