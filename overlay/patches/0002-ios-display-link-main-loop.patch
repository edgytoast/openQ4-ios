+/*
+================
+OpenQ4_iOS_InGame
+
+Whether the player is in a map rather than a menu, so the touch overlay can
+show and hide itself without the shell tracking session state on its own.
+================
+*/
+/*
+ * True while a cinematic is playing.
+ *
+ * A touch player needs a way past one, and the MENU button is deliberately not
+ * on screen outside menus. So the overlay treats a tap anywhere during a
+ * cinematic as escape, which is what the engine skips on — no chrome, no
+ * gesture to learn, and it matches what a tap does in every other video player.
+ */
+extern "C" int OpenQ4_iOS_InCinematic( void ) {
+	if ( session == NULL || game == NULL ) {
+		return 0;
+	}
+	if ( session->IsGUIActive() ) {
+		return 0;
+	}
+	// Never during demo playback (D-086): a demo of a map that runs a cinematic
+	// would turn every stray tap into an escape, and escape during playback is
+	// the transport deck rather than a skip.
+	if ( OpenQ4_iOS_InDemoPlayback() ) {
+		return 0;
+	}
+	return game->InCinematic() ? 1 : 0;
+}
+
+/*
+ * True while a demo is being PLAYED BACK (openQ4-ios D-086).
+ *
+ * A demo plays back with no player to steer, so the sticks, the fire button and
+ * the whole action cluster are not merely useless — they sit on top of the
+ * thing the viewer is trying to watch. The chrome stays: the hamburger is how
+ * the transport deck is opened (the engine binds Escape to it during playback,
+ * Session.cpp), and the gear is how a viewer reaches the iOS settings.
+ *
+ * IsGUIActive() is false during playback with the deck closed, so InGame()
+ * answers 1 and cannot make this distinction on its own.
+ */
+extern "C" int OpenQ4_iOS_InDemoPlayback( void ) {
+	if ( session == NULL ) {
+		return 0;
+	}
+	return sessLocal.IsDemoPlaybackActive() ? 1 : 0;
+}
+
+/*
+ * True while a demo is being RECORDED. The settings sheet's Demos row reads it
+ * so the row can say which of the two things it will do (D-086).
+ */
+extern "C" int OpenQ4_iOS_IsRecordingDemo( void ) {
+	return ( session != NULL && session->writeDemo != NULL ) ? 1 : 0;
+}
+
+extern "C" int OpenQ4_iOS_InGame( void ) {
+	// IsGUIActive() covers the main menu, the in-game menu and full-screen GUIs
+	// alike, which is exactly the set of states where touch controls should be
+	// out of the way and the engine's own cursor should have the screen.
+	if ( session == NULL ) {
+		return 0;
+	}
+	return session->IsGUIActive() ? 0 : 1;
+}
