 int Sys_GetVideoRam( void ) {
+#if TARGET_OS_IPHONE
+	// What constrains an iOS app is its Jetsam budget, NOT the GPU's addressable
+	// memory. On unified-memory hardware recommendedMaxWorkingSetSize reports
+	// the latter — 8192 MB on an A19 Pro — and feeding that to
+	// Common_DetectMachineSpec selects Ultra quality on a phone, which loads
+	// maximum-resolution textures until Jetsam kills the process. Jetsam uses
+	// SIGKILL, so it leaves no crash report and no catchable signal: the app
+	// simply vanishes. That is exactly what happened on the first device builds.
+	//
+	// os_proc_available_memory() is the honest number: bytes this process may
+	// still allocate before it is killed.
+	@autoreleasepool {
+		const uint64_t availBytes = (uint64_t)os_proc_available_memory();
+		if ( availBytes == 0 ) {
+			// Unavailable (older OS): assume a modest budget rather than an
+			// optimistic one — guessing high here is what kills the app.
+			return 512;
+		}
+		// Textures are only part of the footprint; the engine treats this figure
+		// as a texture budget, so hand it a fraction rather than the whole
+		// allowance.
+		const uint64_t budgetMB = ( availBytes / ( 1024ULL * 1024ULL ) ) / 3ULL;
+		return static_cast<int>( Min( budgetMB, static_cast<uint64_t>( idMath::INT_MAX ) ) );
+	}
+#else
 	CGLRendererInfoObj rendererInfo = NULL;
 	GLint rendererCount = 0;
 	unsigned long maxVRAM = 0;
