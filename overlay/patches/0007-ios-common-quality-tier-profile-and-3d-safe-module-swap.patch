+#if defined( OPENQ4_VISIONOS_3D )
 /*
 =================
+Com_DeferTeardownWhile3D
+
+openQ4-visionOS (D-114). A game-module swap or engine reload destroys and
+rebuilds the Vulkan device under the 3D panel: the shell's compositor thread
+keeps sampling stereo images of a device that no longer exists, and the
+multiplayer module will not even accept r_stereo3d, so an Arena match started
+from 3D froze the panel on its loading frame or crashed (the stereo pairs
+outlived their device; vk_GuiExecutor.cpp now releases them on shutdown too).
+
+So the teardown waits for 3D to end: the shell runs its ordinary exit (thread
+stop, dismiss, r_stereo3d 0 through this command queue, curtain down) and the
+command re-queues itself one frame later until that has finished. The menu and
+the loading screen keep drawing meanwhile, in the window the exit restores.
+Bounded: if the exit has not finished in 10 s the swap goes ahead regardless
+(the renderer side is safe on its own now) rather than hang the menu click.
+Returns true when the caller must return and let the re-queued command run.
+=================
+*/
+extern "C" int OpenQ4_Vision3D_HoldRendererTeardown( void );
+static int com_teardownWait3DStart;
+
+static bool Com_DeferTeardownWhile3D( const char *command ) {
+	if ( !OpenQ4_Vision3D_HoldRendererTeardown() ) {
+		com_teardownWait3DStart = 0;
+		return false;
+	}
+	const int now = Sys_Milliseconds();
+	if ( com_teardownWait3DStart == 0 ) {
+		com_teardownWait3DStart = now;
+		common->Printf( "%s: leaving 3D before the renderer is rebuilt\n", command );
+	} else if ( now - com_teardownWait3DStart > 10000 ) {
+		common->Warning( "%s: 3D did not finish exiting in 10 s - rebuilding the renderer anyway", command );
+		com_teardownWait3DStart = 0;
+		return false;
+	}
+	cmdSystem->BufferCommandText( CMD_EXEC_APPEND, va( "wait\n%s\n", command ) );
+	return true;
+}
+#endif
+
