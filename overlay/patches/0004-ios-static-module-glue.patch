+#ifndef OPENQ4_RENDERER_MODULE_STATIC
+	// A dlopen'd renderer module owns a PRIVATE copy of idlib, so tearing it
+	// down here disposes of the module's own memory system and nothing else.
+	//
+	// Statically linked there is no second copy: `SIMDProcessor`, the idStr
+	// allocator, the idDict pools and the rvHeap arenas are the ENGINE's, and
+	// this runs on every mid-session renderer teardown — which the game-module
+	// swap (game_sp -> game_mp, i.e. starting an Arena match) performs while
+	// the engine keeps running. The first Mem_ClearedAlloc after it then calls
+	// SIMDProcessor->Memset through a NULL pointer, which is exactly how the
+	// Arena launch died (D-078). The engine already owns this lifecycle in
+	// idCommonLocal::Init / ::Shutdown, so the static shape must not duplicate
+	// it.
 	idSIMD::Shutdown();
 	idLib::ShutDown();
+#endif
 }
 
