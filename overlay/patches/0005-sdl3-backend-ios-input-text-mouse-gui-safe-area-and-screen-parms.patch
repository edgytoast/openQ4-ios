+#if defined(__APPLE__) && TARGET_OS_IPHONE
+/*
+ * iOS render resolution, applied at the one place that decides how many pixels
+ * the GPU actually fills: the size this backend reports for the window.
+ *
+ * The engine's own r_screenFraction is inert under the Vulkan renderer — the VK
+ * backend never implements the scaled scene target that modes 1 and 2 describe,
+ * and mode 0 is a debug crop that draws the 3D view small inside a full-size
+ * frame. So the knob has to live below the renderer entirely: scale the pixel
+ * size reported here, and the swapchain extent follows (GLimp_SwapBuffers polls
+ * RefreshNativeWindowHandles every frame and recreates the swapchain when the
+ * reported size differs). MoltenVK sets CAMetalLayer.drawableSize from that
+ * extent and the compositor scales the layer to the screen, so a smaller extent
+ * is a genuine reduction in fragments with free upscaling on the way out.
+ *
+ * Everything downstream of SDL_GetWindowSizeInPixels is scaled together — vid
+ * size, uiViewport and the GUI mouse transform — so the mapping from a finger
+ * on glass to a GUI coordinate is unchanged: every ratio in it is uniform.
+ * The SDL window's *point* size is deliberately untouched.
+ */
+extern "C" float OpenQ4_iOS_RenderScale( void );
+
+static float SDL3_IOSRenderScale(void) {
+	float scale = OpenQ4_iOS_RenderScale();
+	if (!(scale > 0.0f)) {
+		return 1.0f;
+	}
+	if (scale < 0.5f) { scale = 0.5f; }
+	if (scale > 1.0f) { scale = 1.0f; }
+	return scale;
 }
 
+// Even dimensions only: half-resolution passes and block-compressed resolve
+// targets both prefer them, and an odd extent buys nothing.
+static int s_iosRawPixelWidth = 0;
+static int s_iosRawPixelHeight = 0;
+
+static void SDL3_IOSScalePixelSize(int *width, int *height) {
+	const float scale = SDL3_IOSRenderScale();
+	if (scale >= 0.999f) {
+		return;
+	}
+	if (width != NULL && *width > 0) {
+		int scaled = (int)(((float)*width * scale) / 2.0f + 0.5f) * 2;
+		if (scaled < 2) { scaled = 2; }
+		*width = scaled;
+	}
+	if (height != NULL && *height > 0) {
+		int scaled = (int)(((float)*height * scale) / 2.0f + 0.5f) * 2;
+		if (scaled < 2) { scaled = 2; }
+		*height = scaled;
+	}
+}
+
+extern "C" bool OpenQ4_iOS_RenderPixelSize( int *width, int *height );
+
+/*
+ * Resolve the pixel size the renderer should ask for. In-place: *width/*height
+ * arrive holding the native drawable size.
+ *
+ * Below 100% the answer comes from the shell, which owns the Metal layer's
+ * contentsScale and therefore knows the exact integers MoltenVK will treat as
+ * the layer's natural drawable size. Computing it here as well — even with the
+ * same intent — is what 0.1.0.39 did, and a one-pixel disagreement (the even
+ * rounding above turned 945 into 946) makes every present return SUBOPTIMAL and
+ * costs a full swapchain recreate, with its vkDeviceWaitIdle, every frame. One
+ * number, one owner.
+ *
+ * The arithmetic below survives only as the fallback for a window whose layer
+ * has not been found, and it says so once.
+ */
+static void SDL3_IOSResolvePixelSize(int *width, int *height) {
+	if (SDL3_IOSRenderScale() >= 0.999f) {
+		return;		// native: SDL's own number is already the layer's
+	}
+	int layerWidth = 0;
+	int layerHeight = 0;
+	if (OpenQ4_iOS_RenderPixelSize(&layerWidth, &layerHeight) && layerWidth > 0 && layerHeight > 0) {
+		if (width != NULL) { *width = layerWidth; }
+		if (height != NULL) { *height = layerHeight; }
+		return;
+	}
+	static bool warnedNoLayer = false;
+	if (!warnedNoLayer) {
+		warnedNoLayer = true;
+		common->Warning( "iOS: no Metal layer size available; render scale falls back to a computed "
+				"size, which the presentation engine may call suboptimal every frame" );
+	}
+	SDL3_IOSScalePixelSize(width, height);
+}
+#endif
