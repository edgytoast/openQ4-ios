+/*
+===============
+SDL3_IsSystemManagedWindowDriver
+
+uikit (iOS, visionOS, tvOS) and android have exactly ONE window, the system
+owns its geometry, and it is permanently fullscreen. Every knob
+SDL3_ApplyScreenParms turns is therefore either refused outright
+("That operation is not supported" from SDL_SetWindowPosition) or a round trip
+into the platform's UI toolkit, which is main-thread-only.
+===============
+*/
+static bool SDL3_IsSystemManagedWindowDriver(void) {
+	return s_sdlVideoDriver == SDL3_VIDEO_DRIVER_UIKIT ||
+		s_sdlVideoDriver == SDL3_VIDEO_DRIVER_ANDROID;
+}
+
 bool Sys_SDL_IsGameWindowFocused(void) {
 	if (s_sdlAppInBackground || !s_sdlVideoReferenceHeld || s_sdlWindow == NULL) {
 		return false;
 	}
 
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+	/*
+	 * On iOS, foreground IS focused, and s_sdlAppInBackground above already
+	 * answers the only question that matters.
+	 *
+	 * SDL_WINDOW_INPUT_FOCUS is a desktop keyboard-focus flag that uikit has no
+	 * reason to set, so this function returned false for the entire lifetime of
+	 * the app — and it feeds three separate things:
+	 *
+	 *   win32.activeApp, which gates SDL3_UpdateTextInputState. With it false,
+	 *   SDL_StartTextInput is never called, no SDL_EVENT_TEXT_INPUT arrives, no
+	 *   SE_CHAR is queued, and a GUI edit field stays empty — which is exactly
+	 *   why typing a save name produced an empty "saveGameName" and saving
+	 *   silently did nothing.
+	 *
+	 *   the menu mouse routing at SDL3_ShouldRouteMenuMouse's call site.
+	 *
+	 *   Session_ShouldSilenceAudioWhenUnfocused, which nulled the sound world
+	 *   and made the whole game silent (D-022). That was patched at the call
+	 *   site rather than here, which fixed the symptom and left the cause — and
+	 *   the cause then produced this bug.
+	 */
+	const SDL_WindowFlags iosFlags = SDL_GetWindowFlags(s_sdlWindow);
+	return (iosFlags & (SDL_WINDOW_HIDDEN | SDL_WINDOW_MINIMIZED)) == 0;
+#else
 	const SDL_WindowFlags flags = SDL_GetWindowFlags(s_sdlWindow);
 	return (flags & SDL_WINDOW_INPUT_FOCUS) != 0 &&
 		(flags & (SDL_WINDOW_HIDDEN | SDL_WINDOW_MINIMIZED)) == 0;
+#endif
 }
 
