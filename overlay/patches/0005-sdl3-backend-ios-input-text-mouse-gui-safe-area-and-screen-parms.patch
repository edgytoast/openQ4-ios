+#if defined(__APPLE__) && TARGET_OS_IPHONE
+static void SDL3_PostControllerKeyEvent(int key, bool down, int eventTime);
+
+/*
+ * Discrete menu stepping from the stick, on iOS.
+ *
+ * In menus the stick otherwise drives a free cursor, and Quake 4's menu rows are
+ * drawn on a slant — so a single flick skips two or three entries, and pushing
+ * LEFT or RIGHT slides the cursor across the slant and changes the vertical
+ * selection too. Both were reported, and both are inherent to steering a cursor
+ * through an angled list with an analogue stick.
+ *
+ * So on a menu the stick becomes a d-pad: one step per push, a hold-to-repeat
+ * delay before it starts repeating, and the horizontal axis kept strictly for
+ * horizontal movement. Requires a decisive push (0.55) and a return towards
+ * centre (0.30) before it will fire again, so a resting thumb cannot creep.
+ */
+static void SDL3_StepMenuFromStick(int moveX, int moveY, int eventTime) {
+	static const float kPressThreshold = 0.55f;
+	static const float kReleaseThreshold = 0.30f;
+	static const int   kRepeatDelayMs = 420;   // before a held stick repeats
+	static const int   kRepeatRateMs = 140;    // between repeats thereafter
+
+	static int  heldVertical = 0;              // -1 up, +1 down, 0 none
+	static int  heldHorizontal = 0;
+	static int  nextRepeatTime = 0;
+
+	if (!SDL3_ShouldRouteMenuMouse()) {
+		heldVertical = heldHorizontal = 0;
+		return;
+	}
+
+	const float x = (float)moveX / 127.0f;
+	const float y = (float)moveY / 127.0f;
+
+	// Only the dominant axis acts, so a diagonal push cannot do both.
+	const bool verticalDominant = idMath::Fabs(y) >= idMath::Fabs(x);
+	const float vertical = verticalDominant ? y : 0.0f;
+	const float horizontal = verticalDominant ? 0.0f : x;
+
+	const int wantVertical = (vertical <= -kPressThreshold) ? -1
+						   : (vertical >= kPressThreshold) ? 1 : 0;
+	const int wantHorizontal = (horizontal <= -kPressThreshold) ? -1
+							 : (horizontal >= kPressThreshold) ? 1 : 0;
+
+	if (idMath::Fabs(vertical) < kReleaseThreshold) {
+		heldVertical = 0;
+	}
+	if (idMath::Fabs(horizontal) < kReleaseThreshold) {
+		heldHorizontal = 0;
+	}
+
+	const int stepVertical = (wantVertical != 0 && wantVertical != heldVertical) ? wantVertical
+						   : ((wantVertical != 0 && eventTime >= nextRepeatTime) ? wantVertical : 0);
+	const int stepHorizontal = (wantHorizontal != 0 && wantHorizontal != heldHorizontal) ? wantHorizontal
+							 : ((wantHorizontal != 0 && eventTime >= nextRepeatTime) ? wantHorizontal : 0);
+
+	if (stepVertical != 0) {
+		const int key = (stepVertical < 0) ? K_UPARROW : K_DOWNARROW;
+		const bool firstPress = (wantVertical != heldVertical);
+		SDL3_PostControllerKeyEvent(key, true, eventTime);
+		SDL3_PostControllerKeyEvent(key, false, eventTime);
+		nextRepeatTime = eventTime + (firstPress ? kRepeatDelayMs : kRepeatRateMs);
+		heldVertical = wantVertical;
+	} else if (stepHorizontal != 0) {
+		const int key = (stepHorizontal < 0) ? K_LEFTARROW : K_RIGHTARROW;
+		const bool firstPress = (wantHorizontal != heldHorizontal);
+		SDL3_PostControllerKeyEvent(key, true, eventTime);
+		SDL3_PostControllerKeyEvent(key, false, eventTime);
+		nextRepeatTime = eventTime + (firstPress ? kRepeatDelayMs : kRepeatRateMs);
+		heldHorizontal = wantHorizontal;
+	}
+}
+#endif
