+/*
+==============
+MainMenuReadEntityDefWithoutMedia
+
+Copies an entityDef's key/values without precaching the media they name (see
+SetMainMenuMPModelVars). Only for defs with no "inherit" key: a noCaching parse
+also parses inherited defs without caching, and only the named decl is returned
+to the unparsed state here. player_marine_mp_ui inherits nothing in every
+retail pak that defines it (pak001/015/017/020/022).
+==============
+*/
+static bool MainMenuReadEntityDefWithoutMedia( const char *name, idDict &out ) {
+	out.Clear();
+	const idDecl *before = declManager->FindDeclWithoutParsing( DECL_ENTITYDEF, name, false );
+	const bool wasParsed = before != NULL && before->GetState() != DS_UNPARSED;
+	const idDecl *decl = declManager->FindType( DECL_ENTITYDEF, name, false, true );
+	if ( decl == NULL ) {
+		return false;
+	}
+	out = static_cast<const idDeclEntityDef *>( decl )->dict;
+	if ( !wasParsed && decl->GetState() != DS_UNPARSED ) {
+		const_cast<idDecl *>( decl )->Invalidate();
+	}
+	return true;
+}
