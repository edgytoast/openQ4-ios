diff --git a/src/video/uikit/SDL_uikitvideo.h b/src/video/uikit/SDL_uikitvideo.h
--- a/src/video/uikit/SDL_uikitvideo.h
+++ b/src/video/uikit/SDL_uikitvideo.h
@@ -37,6 +37,13 @@
 
 #ifdef SDL_PLATFORM_VISIONOS
 extern CGRect UIKit_ComputeViewFrame(SDL_Window *window);
+/* Live geometry of the UIWindowScene this app is actually displayed in, in
+ * points, plus its display scale. visionOS has no UIScreen and no fixed
+ * resolution: the volume is sized by the user and by the system, so every
+ * place that would consult a screen on iOS has to ask the scene instead.
+ * Returns false (and leaves the outputs untouched) when no scene is connected
+ * yet, which is the only case where the SDL_XR_SCREEN* fallback is honest. */
+extern bool UIKit_GetVisionSceneGeometry(SDL_Window *window, CGSize *outSize, CGFloat *outScale);
 #else
 extern CGRect UIKit_ComputeViewFrame(SDL_Window *window, UIScreen *screen);
 #endif
diff --git a/src/video/uikit/SDL_uikitvideo.m b/src/video/uikit/SDL_uikitvideo.m
--- a/src/video/uikit/SDL_uikitvideo.m
+++ b/src/video/uikit/SDL_uikitvideo.m
@@ -211,9 +211,59 @@
 }
 
 #ifdef SDL_PLATFORM_VISIONOS
+bool UIKit_GetVisionSceneGeometry(SDL_Window *window, CGSize *outSize, CGFloat *outScale)
+{
+    @autoreleasepool {
+        UIWindowScene *scene = nil;
+
+        if (window != NULL && window->internal != NULL) {
+            SDL_UIKitWindowData *data = (__bridge SDL_UIKitWindowData *)window->internal;
+            scene = data.uiwindow.windowScene;
+        }
+        if (scene == nil) {
+            scene = UIKit_GetActiveWindowScene();
+        }
+        if (scene == nil) {
+            return false;
+        }
+
+        CGRect bounds = CGRectZero;
+        if (@available(visionOS 2.0, *)) {
+            bounds = scene.effectiveGeometry.coordinateSpace.bounds;
+        }
+        if (CGRectIsEmpty(bounds)) {
+            bounds = scene.coordinateSpace.bounds;
+        }
+        if (CGRectIsEmpty(bounds)) {
+            return false;
+        }
+
+        CGFloat scale = scene.traitCollection.displayScale;
+        if (scale <= 0.0) {
+            scale = 2.0;
+        }
+
+        if (outSize != NULL) {
+            *outSize = bounds.size;
+        }
+        if (outScale != NULL) {
+            *outScale = scale;
+        }
+        return true;
+    }
+}
+
 CGRect UIKit_ComputeViewFrame(SDL_Window *window)
 {
-    return CGRectMake(window->x, window->y, window->w, window->h);
+    /* Upstream returns CGRectMake(window->x, window->y, window->w, window->h),
+     * which places the view as though the SDL window had been positioned on the
+     * fake SDL_XR_SCREENWIDTH x SDL_XR_SCREENHEIGHT "screen". A visionOS window
+     * has no such coordinate space; the view fills its scene and nothing else. */
+    CGSize size;
+    if (UIKit_GetVisionSceneGeometry(window, &size, NULL)) {
+        return CGRectMake(0, 0, size.width, size.height);
+    }
+    return CGRectMake(0, 0, SDL_XR_SCREENWIDTH, SDL_XR_SCREENHEIGHT);
 }
 #else
 CGRect UIKit_ComputeViewFrame(SDL_Window *window, UIScreen *screen)
