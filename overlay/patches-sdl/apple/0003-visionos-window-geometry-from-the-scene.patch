diff --git a/src/video/uikit/SDL_uikitviewcontroller.m b/src/video/uikit/SDL_uikitviewcontroller.m
--- a/src/video/uikit/SDL_uikitviewcontroller.m
+++ b/src/video/uikit/SDL_uikitviewcontroller.m
@@ -208,8 +208,26 @@
     const CGSize size = self.view.bounds.size;
     int w = (int)size.width;
     int h = (int)size.height;
+
+#ifdef SDL_PLATFORM_VISIONOS
+    /* A visionOS volume is resized by the user at any time, and the fake
+     * display has to follow it or SDL's window/display bounds stop describing
+     * the same rectangle. The window always sits at the scene's origin. */
+    UIKit_UpdateVisionDisplayGeometry(window);
+    window->x = 0;
+    window->y = 0;
+#endif
 
     SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_RESIZED, w, h);
+#ifdef SDL_PLATFORM_VISIONOS
+    /* SDL_OnWindowResized only forwards a PIXEL_SIZE_CHANGED when the point
+     * size moved; a displayScale change alone must reach the app too. */
+    {
+        int pixel_w = 0, pixel_h = 0;
+        SDL_GetWindowSizeInPixels(window, &pixel_w, &pixel_h);
+        SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED, pixel_w, pixel_h);
+    }
+#endif
 }
 
