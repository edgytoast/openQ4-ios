diff --git a/src/video/uikit/SDL_uikitmodes.m b/src/video/uikit/SDL_uikitmodes.m
--- a/src/video/uikit/SDL_uikitmodes.m
+++ b/src/video/uikit/SDL_uikitmodes.m
@@ -273,13 +273,19 @@
 bool UIKit_AddDisplay(bool send_event)
 {
     CGSize size = CGSizeMake(SDL_XR_SCREENWIDTH, SDL_XR_SCREENHEIGHT);
+    CGFloat scale = 2.0;
     SDL_VideoDisplay display;
     SDL_DisplayMode mode;
+
+    /* The display IS the scene on visionOS. Reporting the fake 1280x720 makes
+     * SDL centre a larger window at a negative origin and makes every
+     * display-bounds intersection clip the window to two thirds of itself. */
+    UIKit_GetVisionSceneGeometry(NULL, &size, &scale);
 
     SDL_zero(mode);
     mode.w = (int)size.width;
     mode.h = (int)size.height;
-    mode.pixel_density = 2;
+    mode.pixel_density = (float)scale;
     mode.format = SDL_PIXELFORMAT_ABGR8888;
     mode.refresh_rate = 90.0f;
 
@@ -300,6 +306,37 @@
     }
     return true;
 }
+
+void UIKit_UpdateVisionDisplayGeometry(SDL_Window *window)
+{
+    SDL_VideoDevice *device = SDL_GetVideoDevice();
+    CGSize size;
+    CGFloat scale;
+
+    if (device == NULL || device->num_displays < 1) {
+        return;
+    }
+    if (!UIKit_GetVisionSceneGeometry(window, &size, &scale)) {
+        return;
+    }
+
+    SDL_VideoDisplay *display = device->displays[0];
+    SDL_DisplayMode mode = display->desktop_mode;
+    const int w = (int)size.width;
+    const int h = (int)size.height;
+
+    if (w <= 0 || h <= 0) {
+        return;
+    }
+    if (mode.w == w && mode.h == h && mode.pixel_density == (float)scale) {
+        return;
+    }
+
+    mode.w = w;
+    mode.h = h;
+    mode.pixel_density = (float)scale;
+    SDL_SetDesktopDisplayMode(display, &mode);
+}
 #endif
 
