+#ifdef OPENQ4_IOS
 /*
+ openQ4-ios D-111: controller rumble for the two things a player feels most.
+
+ Upstream rumbles from sound alone (channels with `shakes`), which in retail
+ data is set pieces and never a shot or a hit; Raven's console build rumbled on
+ both (the "jnewquist: Controller rumble" markers below are what is left of it).
+ The engine owns the motors, so this only asks: `rumbleEvent` merges the pulse
+ into the sound-driven stream and applies in_joystickRumble, the overall scale
+ and the per-kind in_joystickRumbleFire / in_joystickRumbleDamage.
+*/
+static void PlayerView_RumbleEvent( const char *kind, float strength, int msec ) {
+	if ( !gameLocal.isNewFrame ) {
+		return;	// a prediction re-run already asked for this one
+	}
+	cmdSystem->BufferCommandText( CMD_EXEC_NOW, va( "rumbleEvent %s %.3f %d\n", kind, idMath::ClampFloat( 0.0f, 1.0f, strength ), msec ) );
+}
+#endif
